{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "plugins": [
    "./tools/biome-plugins/icon-button-aria-label.grit",
    "./tools/biome-plugins/no-conditional-bare-jsx-text.grit",
    "./tools/biome-plugins/design-arena.grit"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.tsx",
      "**/*.ts",
      "e2e-tests/**/*.ts",
      "e2e-tests/**/*.mts",
      "shared/**/*.ts",
      "scripts/**/*.ts",
      "benchmarks/**/*.mjs",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.next-*",
      "!!**/.turbo",
      "!!**/target",
      "!!**/dist",
      "!!**/build",
      "!helm/**/*",
      "!**/*.gen.ts",
      "!**/*.generated.ts",
      "!**/sandbox-rs/index.d.ts",
      "!**/app-runtime-rs/index.d.ts",
      "!**/openappa-rs/index.d.ts",
      "!**/router-rs/index.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        }
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "performance": {
        "noImgElement": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "frontend/src/**/*.ts",
        "frontend/src/**/*.tsx",
        "!frontend/src/components/ui/**",
        "!frontend/src/static/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "filenameCases": ["kebab-case"],
                "match": "([-a-z0-9]+)[.]((?:(?:query|keys|utils|types|constants|context|server|client|ee|test-data|d)[.])*tsx?)"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/src/**/*.test.ts",
        "frontend/src/**/*.test.tsx",
        "!frontend/src/components/ui/**",
        "!frontend/src/static/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "requireAscii": true,
                "filenameCases": ["kebab-case"],
                "match": "([-a-z0-9]+)[.]((?:[-a-z0-9]+[.])*test[.]tsx?)"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/src/app/**/_*/**",
        "!frontend/src/app/**/_parts/**",
        "!**/__mocks__/**"
      ],
      "plugins": ["./tools/biome-plugins/route-private-folder.grit"]
    },
    {
      "includes": [
        "frontend/src/**/*.hook.ts",
        "frontend/src/**/*.hook.tsx",
        "frontend/src/**/*.hook.test.ts",
        "frontend/src/**/*.hook.test.tsx"
      ],
      "plugins": ["./tools/biome-plugins/hook-file-name.grit"]
    },
    {
      "includes": ["frontend/**/*.ts", "frontend/**/*.tsx"],
      "plugins": ["./tools/biome-plugins/integration-labels-via-catalog.grit"]
    },
    {
      "includes": [
        "frontend/src/**/*.tsx",
        "!frontend/src/components/ui/**",
        "!**/*.test.tsx"
      ],
      "plugins": ["./tools/biome-plugins/no-raw-button.grit"]
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.ee.ts",
        "!**/*.ee.tsx",
        "!**/*.ee.test.ts",
        "!**/*.ee.test.tsx",
        "!**/*.ee.spec.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "./__arena__": "design-arena: do not commit",
                  "@/app/_parts/__arena__": "design-arena: do not commit",
                  "@/lib/utils": "Import from the focused @/lib/utils module instead of the barrel, which eagerly loads date-fns and other unrelated code.",
                  "@/lib/utils/index": "Import from the focused @/lib/utils module instead of the barrel, which eagerly loads date-fns and other unrelated code."
                },
                "patterns": [
                  {
                    "group": ["**/*.ee", "**/*.ee.ts", "**/*.ee.tsx"],
                    "message": "Cannot import .ee.ts files from non-.ee.ts files. Enterprise Edition files should only be imported by other .ee.ts files. Use runtime conditional logic with config.enterpriseFeatures.core instead to avoid bundling enterprise code into OSS builds."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/**/*.ee.ts",
        "frontend/**/*.ee.tsx",
        "frontend/**/*.ee.test.ts",
        "frontend/**/*.ee.test.tsx",
        "frontend/**/*.ee.spec.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "./__arena__": "design-arena: do not commit",
                  "@/app/_parts/__arena__": "design-arena: do not commit",
                  "@/lib/utils": "Import from the focused @/lib/utils module instead of the barrel, which eagerly loads date-fns and other unrelated code.",
                  "@/lib/utils/index": "Import from the focused @/lib/utils module instead of the barrel, which eagerly loads date-fns and other unrelated code."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/src/app/consults/logs/_parts/consult-detail-sheet.tsx",
        "frontend/src/app/consults/logs/_parts/consults-table.tsx",
        "frontend/src/lib/openappa/external-consults.query.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/*.ee", "**/*.ee.ts", "**/*.ee.tsx"],
                    "message": "Cannot import .ee.ts files from non-.ee.ts files. Enterprise Edition files should only be imported by other .ee.ts files. Use runtime conditional logic with config.enterpriseFeatures.core instead to avoid bundling enterprise code into OSS builds."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
