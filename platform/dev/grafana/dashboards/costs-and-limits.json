{
  "id": null,
  "uid": "archestra-costs-and-limits",
  "title": "Archestra / Costs & Limits",
  "description": "Estimated inference spend, cache use, and observed limit enforcement.",
  "tags": [
    "archestra",
    "observability"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "metrics_datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "job",
        "label": "Deployment job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"llm_tokens_total|agent_runtime_health_collection_timestamp_seconds|http_request_duration_seconds_count\"}, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Spend is an estimate based on configured list prices, not an invoice. Metered and subscription-covered estimates are shown separately. Cache read savings are gross, not net of cache-write surcharges. Limits count **rule evaluations**; one request can evaluate several rules. Last-exceeded values describe a past check, not current budget remaining."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Estimated spend",
      "collapsed": false,
      "panels": [],
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Metered estimate in selected period",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(llm_cost_total{job=~\"$job\",billing_mode=\"metered\"}[$__range]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Subscription-covered equivalent",
