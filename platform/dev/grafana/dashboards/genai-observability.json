    {
      "id": 2,
      "type": "row",
      "title": "Logical proxy requests",
      "collapsed": false,
      "panels": [],
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Requests / second",
      "type": "stat",
      "description": "Logical inference requests completed per second, including successful and non-success outcomes. Provider and logical-request filters apply; upstream model and agent filters do not. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "text": "No samples"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Successful completed requests",
      "type": "stat",
      "description": "Success is outcome=success. Incomplete, denied, cancelled and operational failures remain separate outcomes. No traffic has no percentage. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",outcome=\"success\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval])) or (sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval])) * 0)) / sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "text": "No samples"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "P95 full request duration",
      "type": "stat",
      "description": "95th-percentile logical inference request duration, from handler entry through preflight, retries, and complete streaming. Model and agent filters do not apply. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_proxy_request_duration_seconds_bucket{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval])))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "text": "No samples"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Requests in selected period",
      "type": "stat",
      "description": "Logical inference requests completed during the selected period, including errors, denials, and cancellations. This excludes failures before requests reach the inference handler. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(llm_proxy_request_duration_seconds_count{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__range]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "text": "No samples"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Outcomes / second",
      "type": "timeseries",
      "description": "Logical inference request rate by final outcome, including midstream failures after HTTP 200 headers. Model and agent filters do not apply. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 8,
      "title": "Operational errors and throttles",
      "type": "timeseries",
      "description": "Logical inference failures per second by error origin and outcome, separating provider, platform, and client failures. Policy denials and incomplete generation are shown separately. Model, agent, agent type, and source filters do not apply to these logical outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_origin,outcome) (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",outcome=~\"error|throttled|timeout|overloaded\",provider=~\"$provider\",operation=~\"$operation\",stream=~\"$stream\",outcome=~\"$outcome\",error_origin=~\"$error_origin\",status_code=~\"$status_code\"}[$__rate_interval]))",
          "legendFormat": "{{error_origin}} / {{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
