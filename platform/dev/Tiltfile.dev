# Development resources

# Define is_prod locally (same logic as main Tiltfile)
is_prod = os.getenv('PROD') == 'true'

# Configure the archestra service from docker-compose
# This includes both frontend and backend
dc_resource('archestra', labels=['dev'])

# Lint and type-check resource (runs inside container)
local_resource(
  'lint:fix',
  cmd='docker exec archestra-dev pnpm type-check && docker exec archestra-dev pnpm lint:fix',
  dir='..',
  labels=['dev'],
  resource_deps=['archestra'],
  deps=[
    "../frontend/src",
    "../backend/src",
    "../experiments/src",
    "../biome.json",
  ]
)

local_resource(
  'lint:fix:unsafe',
  cmd='docker exec archestra-dev pnpm lint:fix:unsafe && tilt trigger lint:fix',
  dir='..',
  labels=['dev'],
  resource_deps=['archestra'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)

local_resource(
  'codegen:api-client',
  cmd='docker exec archestra-dev pnpm codegen:api-client',
  dir='..',
  labels=['dev'],
  resource_deps=['archestra'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)
