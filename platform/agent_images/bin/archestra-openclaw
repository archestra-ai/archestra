#!/usr/bin/env bash
set -euo pipefail

case "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" in
  openai_chat) openclaw_api="openai-completions" ;;
  openai_responses) openclaw_api="openai-responses" ;;
  *)
    echo "archestra: OpenClaw requires an Agent configured for OpenAI Chat Completions or OpenAI Responses" >&2
    exit 78
    ;;
esac

resolve_docker_desktop_url() {
  local url="$1"
  local hostname
  local ipv6

  case "${url}" in
    http://host.internal:*) hostname="host.internal" ;;
    http://host.orb.internal:*) hostname="host.orb.internal" ;;
    *)
      printf '%s\n' "${url}"
      return
      ;;
  esac

  ipv6="$(getent ahostsv6 "${hostname}" 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ -z "${ipv6}" ]]; then
    printf '%s\n' "${url}"
    return
  fi

  printf 'http://[%s]%s\n' "${ipv6}" "${url#http://${hostname}}"
}

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
runtime_mode="${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}"
config_file="${runtime_dir}/openclaw.json"
task_file="${runtime_dir}/task.md"
attention_plugin_dir="${runtime_dir}/openclaw-attention"
attention_plugin="${attention_plugin_dir}/index.cjs"
model="${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
runtime_instructions="${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}"
export OPENCLAW_STATE_DIR="${runtime_dir}/openclaw-state"
export OPENCLAW_CONFIG_PATH="${config_file}"
mkdir -p "${OPENCLAW_STATE_DIR}" "${attention_plugin_dir}"

# OpenClaw exposes typed lifecycle hooks to local plugins. The plugin is loaded
# from this generated, runtime-owned path and only reports state transitions.
cat > "${attention_plugin}" <<'PLUGIN'
const { execFile } = require("node:child_process");
const { promisify } = require("node:util");

const execFileAsync = promisify(execFile);

async function update(...args) {
  try {
    const command = process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention";
    await execFileAsync(command, args, { timeout: 2500 });
  } catch {
    // Attention reporting is best-effort and must never interrupt a run.
  }
}

module.exports = {
  id: "archestra-runtime-attention",
  name: "Archestra runtime attention",
  description: "Reports when this agent run is waiting for input.",
  register(api) {
    api.on("before_agent_run", async () => {
      await update("clear");
    });
    api.on("before_tool_call", async (event) => {
      if (event.toolName === "ask_user") await update("set", "Input requested");
    });
    api.on("after_tool_call", async (event) => {
      if (event.toolName === "ask_user") await update("clear");
    });
    api.on("agent_end", async (event) => {
      if (
        event.success &&
        process.env.ARCHESTRA_AGENT_RUNTIME_MODE === "interactive"
      ) {
        await update("set", "Waiting for input");
      } else {
        await update("clear");
      }
    });
    api.on("session_end", async () => {
      await update("clear");
    });
  },
};
PLUGIN
chmod 0600 "${attention_plugin}"
cat > "${attention_plugin_dir}/openclaw.plugin.json" <<'MANIFEST'
{
  "id": "archestra-runtime-attention",
  "name": "Archestra runtime attention",
  "description": "Reports when this agent run is waiting for input.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
MANIFEST
cat > "${attention_plugin_dir}/package.json" <<'PACKAGE'
{
  "name": "archestra-runtime-attention",
  "private": true,
  "type": "commonjs",
  "openclaw": {
    "extensions": ["./index.cjs"]
  }
}
PACKAGE
chmod 0600 \
  "${attention_plugin_dir}/openclaw.plugin.json" \
  "${attention_plugin_dir}/package.json"

transcript_plugin_dir="${runtime_dir}/openclaw-transcript"
mkdir -p "${transcript_plugin_dir}"
cat > "${transcript_plugin_dir}/package.json" <<'JSON'
{
  "name": "archestra-openclaw-transcript",
  "version": "1.0.0",
  "type": "module",
  "openclaw": {
    "extensions": ["./index.mjs"]
  }
}
JSON
cat > "${transcript_plugin_dir}/openclaw.plugin.json" <<'JSON'
{
  "id": "archestra-transcript",
  "name": "Archestra transcript",
  "description": "Exports a readable transcript and settles delegated runs after a native turn.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
JSON
cat > "${transcript_plugin_dir}/index.mjs" <<'PLUGIN'
import { rename, writeFile } from "node:fs/promises";

function messageText(message) {
  if (!message) return "";
  if (typeof message.content === "string") return message.content;
  if (!Array.isArray(message.content)) return "";
  return message.content
    .filter((part) => part?.type === "text" && typeof part.text === "string")
    .map((part) => part.text)
    .join("");
}

function serialize(value) {
  if (typeof value === "string") return value;
  if (value === undefined) return undefined;
  return JSON.stringify(value);
}

function optionalTimestamp(message) {
  const value = message?.timestamp ?? message?.createdAt;
  if (typeof value === "string") return { timestamp: value };
  if (typeof value === "number") return { timestamp: new Date(value).toISOString() };
  return {};
}

function entriesForMessage(message) {
  if (!message || typeof message !== "object") return [];
  const entries = [];
  const timed = optionalTimestamp(message);
  const parts = Array.isArray(message.content) ? message.content : [];
  const text = messageText(message);
  if ((message.role === "user" || message.role === "assistant") && text) {
    entries.push({ type: "message", role: message.role, text, ...timed });
  } else if (
    (message.role === "user" || message.role === "assistant") &&
    typeof message.content === "string" &&
    message.content
  ) {
    entries.push({ type: "message", role: message.role, text: message.content, ...timed });
  }

  const calls = [
    ...(Array.isArray(message.tool_calls) ? message.tool_calls : []),
    ...parts.filter((part) => ["tool_use", "tool-call", "toolCall"].includes(part?.type)),
  ];
  for (const call of calls) {
    const fn = call?.function && typeof call.function === "object" ? call.function : {};
    const name = fn.name ?? call?.name ?? call?.toolName;
    if (typeof name !== "string") continue;
    const toolCallId = call?.id ?? call?.toolCallId ?? call?.tool_use_id;
    const input = serialize(fn.arguments ?? call?.arguments ?? call?.input ?? call?.args);
    entries.push({
      type: "tool_call",
      name,
      ...(input === undefined ? {} : { input }),
      ...(typeof toolCallId === "string" ? { toolCallId } : {}),
      ...timed,
    });
  }

  const results = parts.filter((part) =>
    ["tool_result", "tool-result", "toolResult"].includes(part?.type),
  );
  if (message.role === "tool" || message.role === "toolResult") results.push(message);
  for (const result of results) {
    const toolCallId = result?.tool_call_id ?? result?.toolCallId ?? result?.tool_use_id;
    const value = result?.output ?? result?.result ?? result?.content;
    entries.push({
      type: "tool_result",
      text: serialize(value) ?? "[Non-text result omitted]",
      ...(typeof toolCallId === "string" ? { toolCallId } : {}),
      ...(result?.is_error === true || result?.isError === true ? { isError: true } : {}),
      ...timed,
    });
  }
  return entries;
}

export default {
  id: "archestra-transcript",
  name: "Archestra transcript",
  description: "Exports readable native-agent history.",
  configSchema: {
    type: "object",
    additionalProperties: false,
    properties: {},
  },
  register(api) {
    api.on("agent_end", async (event, context) => {
      const runtimeDir = process.env.ARCHESTRA_AGENT_RUNTIME_DIR ?? "/var/run/archestra";
      const sessionId = process.env.ARCHESTRA_AGENT_RUNTIME_WORKSPACE_ID ?? process.env.ARCHESTRA_AGENT_RUNTIME_TASK_ID;
      const expectedSessionKey = sessionId ? `agent:main:${sessionId}` : undefined;
      if (expectedSessionKey && context?.sessionKey !== expectedSessionKey) return;

      const transcript = {
        version: 1,
        provider: "openclaw",
        entries: (event.messages ?? []).flatMap(entriesForMessage),
      };
      const temporaryPath = `${runtimeDir}/readable-transcript.tmp.json`;
      await writeFile(temporaryPath, `${JSON.stringify(transcript)}\n`, "utf8");
      await rename(temporaryPath, `${runtimeDir}/readable-transcript.json`);

      if (
        process.env.ARCHESTRA_AGENT_RUNTIME_MODE !== "one_shot" ||
        process.env.ARCHESTRA_AGENT_RUNTIME_PLAIN === "1"
      ) return;

      const answer = [...(event.messages ?? [])]
        .reverse()
        .filter((message) => message?.role === "assistant")
        .map(messageText)
        .find((text) => text.trim().length > 0)
        ?.trim();

      if (answer) {
        await writeFile(`${runtimeDir}/final-answer.txt`, `${answer}\n`, "utf8");
      } else if (event.error) {
        await writeFile(`${runtimeDir}/final-answer.txt`, `${event.error}\n`, "utf8");
      }
      if (!event.success) {
        await writeFile(`${runtimeDir}/turn-complete.failed`, "", "utf8");
      }
      await writeFile(`${runtimeDir}/turn-complete`, "", "utf8");
    });
  },
};
PLUGIN

# OpenClaw deliberately owns its generated system prompt. Its supported
# extension point is the workspace bootstrap files, so expose the Agent's
# runtime instructions through SOUL.md. Task pods use a fresh worktree; the
# cleanup and exclude bookkeeping also keep this safe for a custom workspace.
soul_file="${PWD}/SOUL.md"
soul_created=false
exclude_file=""
exclude_backup="${runtime_dir}/git-info-exclude.backup"
exclude_existed=false

cleanup_bootstrap() {
  if [[ "${soul_created}" == true ]]; then
    rm -f "${soul_file}"
  fi
  if [[ -n "${exclude_file}" ]]; then
    if [[ "${exclude_existed}" == true ]]; then
      cp "${exclude_backup}" "${exclude_file}"
    else
      rm -f "${exclude_file}"
    fi
  fi
}
trap cleanup_bootstrap EXIT

if [[ -n "${runtime_instructions}" && ! -e "${soul_file}" ]]; then
  printf '# Runtime instructions\n\n%s\n' "${runtime_instructions}" > "${soul_file}"
  soul_created=true

  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "${git_root}" && "${soul_file}" == "${git_root}"/* ]]; then
    exclude_file="$(git -C "${git_root}" rev-parse --git-path info/exclude)"
    mkdir -p "$(dirname "${exclude_file}")"
    if [[ -f "${exclude_file}" ]]; then
      cp "${exclude_file}" "${exclude_backup}"
      exclude_existed=true
    fi
    printf '\n/%s\n' "${soul_file#"${git_root}/"}" >> "${exclude_file}"
  fi
fi

# Docker Desktop publishes host.internal with a working IPv6 address and a
# synthetic IPv4 address that cannot accept connections from Kubernetes pods.
# OpenClaw's DNS-pinned HTTP transport intentionally prefers IPv4, so use the
# reachable address directly for this local-only hostname. Production service
# DNS names and ordinary platform URLs are left unchanged.
openclaw_base_url="$(resolve_docker_desktop_url "${OPENAI_BASE_URL:?}")"
openclaw_mcp_url="$(resolve_docker_desktop_url "${ARCHESTRA_MCP_GATEWAY_URL:?}")"
: "${OPENAI_API_KEY:?}"

# OpenClaw resolves ${ENV_VAR} references when loading configuration. Keep
# credential values out of this persisted config; the jq literals are intentional.
jq -n \
  --arg base_url "${openclaw_base_url}" \
  --arg model "${model}" \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  --arg mcp_url "${openclaw_mcp_url}" \
  --arg api "${openclaw_api}" \
  --arg workspace "${PWD}" \
  --arg attention_plugin_dir "${attention_plugin_dir}" \
  --arg transcript_plugin_dir "${transcript_plugin_dir}" \
  '({
    logging:{level:"error",consoleLevel:"silent"},
    plugins:{
      enabled:true,
      bundledDiscovery:"allowlist",
      allow:["archestra-runtime-attention", "archestra-transcript"],
      load:{paths:[$attention_plugin_dir, $transcript_plugin_dir]},
      entries:({
        "archestra-runtime-attention":{
          enabled:true,
          hooks:{allowConversationAccess:true,timeoutMs:3000}
        }
      } + {
        "archestra-transcript":{
          enabled:true,
          hooks:{allowConversationAccess:true}
        }
      })
    },
    models:{
      mode:"replace",
      providers:{
        archestra:{
          baseUrl:$base_url,
          apiKey:env.OPENAI_API_KEY,
          api:$api,
          headers:{
            "X-Archestra-Run-Id":$task_id,
            "X-Archestra-Session-Id":$task_id
          },
          models:[{id:$model,name:$model}]
        }
      }
    },
    agents:{defaults:{
      workspace:$workspace,
      skipBootstrap:true,
      model:{primary:("archestra/" + $model)}
    }},
    mcp:{
      servers:{
        archestra:{
          url:$mcp_url,
          transport:"streamable-http",
          headers:{
            Authorization:"Bearer ${ARCHESTRA_MCP_GATEWAY_TOKEN}",
            "X-Archestra-Run-Id":$task_id,
            "X-Archestra-Session-Id":$task_id
          }
        }
      }
    }
  })' > "${config_file}"
chmod 0600 "${config_file}"
if [[ -n "${runtime_instructions}" && "${soul_created}" != true ]]; then
  printf '%s\n\n# Delegated task\n\n%s\n' \
    "${runtime_instructions}" \
    "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"
else
  printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"
fi

session_key="agent:main:${ARCHESTRA_AGENT_RUNTIME_WORKSPACE_ID:-${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}}"

if [[ "${ARCHESTRA_AGENT_RUNTIME_INTERFACE:-}" == "structured" ]]; then
  export OPENCLAW_GATEWAY_TOKEN="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))')"
  gateway_token_file="${runtime_dir}/openclaw-gateway-token"
  printf '%s' "${OPENCLAW_GATEWAY_TOKEN}" > "${gateway_token_file}"
  chmod 0600 "${gateway_token_file}"
  openclaw gateway run --allow-unconfigured --bind loopback --auth token --port 18789 > "${runtime_dir}/openclaw-gateway.log" 2>&1 &
  gateway_pid=$!
  cleanup_gateway() {
    kill "${gateway_pid}" 2>/dev/null || true
    cleanup_bootstrap
  }
  trap cleanup_gateway EXIT
  ready=false
  for attempt in $(seq 1 60); do
    if openclaw gateway health --url ws://127.0.0.1:18789 --token "${OPENCLAW_GATEWAY_TOKEN}" >/dev/null 2>&1; then ready=true; break; fi
    kill -0 "${gateway_pid}" 2>/dev/null || break
    sleep 1
  done
  if [[ "${ready}" != true ]]; then echo "The agent gateway could not start" >&2; exit 1; fi
  archestra-agent-session openclaw openclaw acp --url ws://127.0.0.1:18789 --token-file "${gateway_token_file}" --session "${session_key}" --no-prefix-cwd
  exit $?
fi

case "${runtime_mode}" in
  interactive)
    set +e
    openclaw tui \
      --local \
      --session "${session_key}" \
      --message "$(cat "${task_file}")"
    status=$?
    set -e
    exit "${status}"
    ;;
  one_shot)
    if [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]]; then
      set +e
      openclaw agent \
        --local \
        --session-key "${session_key}" \
        --model "archestra/${model}" \
        --message-file "${task_file}" 2>&1 | tee "${runtime_dir}/openclaw-output.log"
      status=${PIPESTATUS[0]}
      set -e
      if [[ ${status} -ne 0 ]] || grep -Eq "FailoverError:|LLM request failed|network connection error|empty response retries exhausted|Agent couldn't generate a response" "${runtime_dir}/openclaw-output.log"; then
        exit 1
      fi
      exit 0
    fi

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    "${script_dir}/archestra-tui-run" \
      "${runtime_dir}/turn-complete" \
      "${runtime_dir}/final-answer.txt" \
      openclaw tui \
        --local \
        --session "${session_key}" \
        --message "$(cat "${task_file}")"
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
