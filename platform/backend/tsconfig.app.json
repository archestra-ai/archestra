{
  // Every source file above the models layers, until later slices carve it
  // into its layers (layers.mjs).
  "extends": "./tsconfig.source-project.json",
  "compilerOptions": {
    "outDir": "./.tsbuild/app",
    "tsBuildInfoFile": "./.tsbuild/app.tsbuildinfo"
  },
  // Files of the core, schema and models directories that layers.mjs pins to
  // a higher layer (`exclude` does not apply to `files`).
  "files": [
    "src/observability/previous-termination-report.ts",
    "src/git-hosts/git-access.ts",
    "src/auth/better-auth.ts",
    "src/auth/fastify-plugin/index.ts",
    "src/auth/fastify-plugin/middleware.ts",
    "src/auth/fastify-plugin/plugin.ts",
    "src/auth/jwks-signing-key-guard.ts",
    "src/auth/sso-email-reconciliation.ee.ts"
  ],
  // JSON modules must be listed to be imported.
  "include": [
    "src/**/*.ts",
    "src/playwright-mcp-image.json",
    "src/skills/skill-catalog.generated.json"
  ],
  "exclude": [
    // Queue and knowledge-base projects own these exclusions.
    "src/task-queue/index.ts",
    "src/task-queue/task-queue.ts",
    "src/task-queue/periodic-tasks.ts",

    "src/knowledge-base/**",
    // Provider clients and billing helpers are checked in tsconfig.llm-clients.json.
