{
  "id": null,
  "uid": "archestra-guardrails",
  "title": "Archestra / Guardrails & OpenAPPA",
  "description": "Embedded hook decisions and optional standalone OpenAPPA engine telemetry.",
  "tags": [
    "archestra",
    "observability"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "metrics_datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "job",
        "label": "Deployment job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"llm_tokens_total|agent_runtime_health_collection_timestamp_seconds|http_request_duration_seconds_count\"}, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "openappa_datasource",
        "label": "Standalone OpenAPPA metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "openappa_job",
        "label": "Standalone job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${openappa_datasource}"
        },
        "query": {
          "query": "label_values(appa_policy_decisions_total, job)",
          "refId": "openappa_job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Embedded counters measure one logical host hook dispatch, including policy-move retries, policy resolution inside dispatch, storage and consult waits. Decisions such as ack/context are lifecycle acknowledgments, not policy allows. Errors are distinct from structured denials/refusals. No tool arguments, names, session IDs or raw errors are metric labels. Standalone APPA below uses a separate OTLP metrics pipeline; those series do not come from Archestra\u2019s scrape endpoint."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Embedded OpenAPPA hooks",
      "collapsed": false,
      "panels": [],
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Dispatches in selected period",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(openappa_hook_dispatches_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Failed dispatches in selected period",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(openappa_hook_dispatches_total{job=~\"$job\",decision=\"error\"}[$__range])) or (0 * sum (increase(openappa_hook_dispatches_total{job=~\"$job\"}[$__range])))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "P95 tool-call hook duration",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openappa_hook_dispatch_duration_seconds_bucket{job=~\"$job\",hook=\"tool_call\"}[$__rate_interval])))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
