#!/usr/bin/env bash
set -euo pipefail

if [[ "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" != "openai_responses" ]]; then
  echo "archestra: OpenCode requires an Agent configured for OpenAI Responses" >&2
  "$(dirname "${BASH_SOURCE[0]}")/archestra-agent-failure" \
    "opencode_protocol" "OpenCode requires an Agent configured for OpenAI Responses."
  exit 78
fi

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
image_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ARCHESTRA_AGENT_FAILURE_COMMAND="${ARCHESTRA_AGENT_FAILURE_COMMAND:-${image_bin_dir}/archestra-agent-failure}"
export ARCHESTRA_AGENT_EVENT_HELPER="${ARCHESTRA_AGENT_EVENT_HELPER:-${image_bin_dir}/archestra-agent-event}"
runtime_mode="${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}"
config_file="${runtime_dir}/opencode.json"
instructions_file="${runtime_dir}/opencode-instructions.md"
task_file="${runtime_dir}/task.md"
attention_plugin="${runtime_dir}/opencode-attention.js"
transcript_plugin="${runtime_dir}/opencode-transcript.js"
model="${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
context_length="${ARCHESTRA_AGENT_RUNTIME_MODEL_CONTEXT_LENGTH:-32768}"
output_length="${ARCHESTRA_AGENT_RUNTIME_MODEL_OUTPUT_LENGTH:-8192}"

mkdir -p "${runtime_dir}/config" "${runtime_dir}/data" "${runtime_dir}/cache" "${runtime_dir}/state"
export XDG_CONFIG_HOME="${runtime_dir}/config"
export XDG_DATA_HOME="${runtime_dir}/data"
export XDG_CACHE_HOME="${runtime_dir}/cache"
export XDG_STATE_HOME="${runtime_dir}/state"
export OPENCODE_CONFIG="${config_file}"
export OPENCODE_CONFIG_DIR="${runtime_dir}/config"
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_PROJECT_CONFIG=1
# OpenCode's event firehose exposes explicit question, permission, and turn
# lifecycle events. Load only this generated plugin: project config discovery
# remains disabled, so a checked-out repository cannot contribute plugins.
cat > "${attention_plugin}" <<'PLUGIN'
import { spawn } from "node:child_process";
import { existsSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";

async function runCommand(command, args, env = process.env) {
  try {
    const child = spawn(command, args, { env, stdio: ["ignore", "ignore", "pipe"] });
    let stderr = "";
    child.stderr?.on("data", (chunk) => {
      if (stderr.length < 2048) stderr += String(chunk).slice(0, 2048 - stderr.length);
    });
    return await new Promise((resolve) => {
      child.once("error", () => resolve({ code: 127, stderr }));
      child.once("exit", (code) => resolve({ code: code ?? 1, stderr }));
    });
  } catch {
    return { code: 127, stderr: "" };
  }
}

function reportCommandFailure(label, result) {
  if (!result || result.code === 0) return;
  const detail = typeof result.stderr === "string"
    ? result.stderr.replace(/[\u0000-\u001f\u007f]/g, " ").trim().slice(-512)
    : "";
  console.error(`archestra-opencode: ${label} failed${detail ? `: ${detail}` : ""}`);
}

export const ArchestraAttention = async () => {
  let primarySessionID;
  const runtimeDir = process.env.ARCHESTRA_AGENT_RUNTIME_DIR ?? "/var/run/archestra";
  const sessionFile = `${runtimeDir}/opencode-main-session`;
  const attentionKindFile = `${runtimeDir}/opencode-attention-kind`;

  const persistedPrimarySession = () => {
    try {
      const sessionID = readFileSync(sessionFile, "utf8").trim();
      return sessionID || undefined;
    } catch {
      return undefined;
    }
  };

  const clearFailureKind = () => {
    try {
      unlinkSync(attentionKindFile);
    } catch {
      // The marker is optional state; a missing marker is already clear.
    }
  };

  const failureKind = () => {
    try {
      const kind = readFileSync(attentionKindFile, "utf8").trim();
      return kind === "auth_required" ? kind : "";
    } catch {
      return "";
    }
  };

  const update = async (...args) => {
    const command = process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention";
    reportCommandFailure("attention update", await runCommand(command, args));
  };

  const clear = async () => {
    clearFailureKind();
    await update("clear");
  };

  const reportWaiting = async () => {
    const kind = failureKind();
    const command = process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention";
    reportCommandFailure("attention update", await runCommand(command, ["set", "Waiting for input"], {
      ...process.env,
      ...(kind ? { ARCHESTRA_AGENT_RUNTIME_ATTENTION_KIND: kind } : {}),
    }));
  };

  return {
    event: async ({ event }) => {
      if (event.type === "session.created") {
        const info = event.properties?.info;
        if (info?.id && !info.parentID) {
          if (!existsSync(sessionFile)) writeFileSync(sessionFile, `${info.id}\n`, "utf8");
          primarySessionID = persistedPrimarySession() ?? info.id;
        }
        return;
      }
      if (event.type === "question.asked") {
        await update("set", "Input requested");
        return;
      }
      if (event.type === "permission.asked") {
        await update("set", "Permission needed");
        return;
      }
      if (
        event.type === "question.replied" ||
        event.type === "question.rejected" ||
        event.type === "permission.replied"
      ) {
        await clear();
        return;
      }
      // session.error is handled by the transcript plugin after it confirms
      // that the event belongs to the primary session. This hook must not
      // let a child session's failure mutate the parent's attention state.
      if (event.type !== "session.status") return;

      if (event.properties.status.type === "busy") {
        primarySessionID ??= persistedPrimarySession();
        if (primarySessionID && event.properties.sessionID === primarySessionID) await clear();
        return;
      }
      if (event.properties.sessionID !== primarySessionID) return;
      if (
        event.properties.status.type === "idle" &&
        process.env.ARCHESTRA_AGENT_RUNTIME_MODE === "interactive"
      ) {
        await reportWaiting();
      } else {
        await clear();
      }
    },
  };
};
PLUGIN
chmod 0600 "${attention_plugin}"

cat > "${transcript_plugin}" <<'PLUGIN'
import { spawn } from "node:child_process";
import { existsSync, readFileSync, renameSync, unlinkSync, writeFileSync } from "node:fs";
import { rename, writeFile } from "node:fs/promises";

function nativeErrorClassification(error) {
  // The proxy's explicit internal code is the only response body field we
  // trust. Keep parsing bounded and never inspect provider error messages.
  const responseBody = typeof error?.responseBody === "string"
    ? error.responseBody
    : typeof error?.data?.responseBody === "string"
      ? error.data.responseBody
      : undefined;
  if (responseBody && responseBody.length <= 4096) {
    try {
      if (JSON.parse(responseBody)?.error?.internal_code === "provider_auth_required") {
        return {
          code: "provider_auth_required",
          message: "OpenCode requires provider authentication. Reconnect the provider account, then retry.",
        };
      }
    } catch {
      // A provider response body is untrusted and does not affect fallback
      // classification when it is malformed.
    }
  }
  const status = Number.isInteger(error?.status)
    ? error.status
    : Number.isInteger(error?.statusCode)
      ? error.statusCode
      : Number.isInteger(error?.data?.status)
        ? error.data.status
        : Number.isInteger(error?.data?.statusCode)
          ? error.data.statusCode
          : undefined;
  let code;
  if (status === 401) code = "provider_credential_rejected";
  else if (status === 403) code = "provider_permission_denied";
  else if (status === 402) code = "provider_billing_required";
  else if (status === 429) code = "provider_rate_limited";
  else if (status === 404) code = "model_unavailable";
  else {
    switch (error?.name) {
      case "AuthenticationError":
      case "UnauthorizedError":
      case "ProviderAuthError":
        code = "provider_credential_rejected";
        break;
      case "PermissionDeniedError":
      case "ForbiddenError":
        code = "provider_permission_denied";
        break;
      case "BillingError":
      case "PaymentRequiredError":
        code = "provider_billing_required";
        break;
      case "RateLimitError":
      case "TooManyRequestsError":
        code = "provider_rate_limited";
        break;
      case "ModelNotFoundError":
      case "UnknownModelError":
        code = "model_unavailable";
        break;
      default:
        code = "provider_error";
    }
  }
  const messages = {
    provider_auth_required: "OpenCode requires provider authentication. Reconnect the provider account, then retry.",
    provider_credential_rejected: "OpenCode could not authenticate with the configured provider credential. Reconnect the provider account, then retry.",
    provider_permission_denied: "OpenCode was denied access to the configured provider or model.",
    provider_billing_required: "OpenCode could not use the provider account because billing or account entitlement is required.",
    provider_rate_limited: "OpenCode reached a provider rate limit. Retry when account capacity is available.",
    model_unavailable: "OpenCode could not find the configured model. Check the model and account access.",
    provider_error: "OpenCode could not complete the provider request. Check the configured provider credential and model availability, then retry.",
  };
  return { code, message: messages[code] };
}

async function runRuntimeCommand(command, args, environment = process.env) {
  try {
    const child = spawn(command, args, { env: environment, stdio: ["ignore", "ignore", "pipe"] });
    let stderr = "";
    child.stderr?.on("data", (chunk) => {
      if (stderr.length < 2048) stderr += String(chunk).slice(0, 2048 - stderr.length);
    });
    return await new Promise((resolve) => {
      child.once("error", () => resolve({ code: 127, stderr }));
      child.once("exit", (code) => resolve({ code: code ?? 1, stderr }));
    });
  } catch {
    return { code: 127, stderr: "" };
  }
}

function reportCommandFailure(label, result) {
  if (!result || result.code === 0) return;
  const detail = typeof result.stderr === "string"
    ? result.stderr.replace(/[\u0000-\u001f\u007f]/g, " ").trim().slice(-512)
    : "";
  console.error(`archestra-opencode: ${label} failed${detail ? `: ${detail}` : ""}`);
}

async function emitDiagnostic(code, runtimeDir) {
  const prefix = process.env.ARCHESTRA_AGENT_RUNTIME_TURN_PREFIX;
  const context = prefix ? `${prefix}.events/context.json` : undefined;
  const helper = process.env.ARCHESTRA_AGENT_EVENT_HELPER ?? "archestra-agent-event";
  if (!context || !existsSync(context)) return;
  const payload = JSON.stringify({ type: "diagnostic", error: { code } });
  reportCommandFailure("runtime diagnostic", await runRuntimeCommand(helper, [
    "emit",
    "--context",
    context,
    "--source",
    "opencode-native",
    payload,
  ]));
}

async function reportInteractiveFailure(classification, runtimeDir) {
  const kindFile = `${runtimeDir}/opencode-attention-kind`;
  if (classification.code === "provider_auth_required" || classification.code === "provider_credential_rejected") {
    const temporary = `${kindFile}.tmp`;
    writeFileSync(temporary, "auth_required\n", "utf8");
    renameSync(temporary, kindFile);
  } else {
    try {
      unlinkSync(kindFile);
    } catch {
      // The marker is optional state; a missing marker is already clear.
    }
  }
  const command = process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention";
  reportCommandFailure("runtime attention", await runRuntimeCommand(
    command,
    ["set", "API error: check terminal"],
    {
      ...process.env,
      ARCHESTRA_AGENT_RUNTIME_ATTENTION_KIND:
        classification.code === "provider_auth_required" || classification.code === "provider_credential_rejected"
          ? "auth_required"
          : "input_required",
    },
  ));
}

function timestamp(info) {
  const value = info?.time?.created ?? info?.time?.completed;
  if (typeof value === "string") return value;
  if (typeof value === "number") return new Date(value).toISOString();
  return undefined;
}

function serialize(value) {
  if (typeof value === "string") return value;
  if (value === undefined) return undefined;
  return JSON.stringify(value);
}

function entriesForMessage(message) {
  const entries = [];
  const role = message.info?.role;
  const entryTimestamp = timestamp(message.info);
  for (const part of message.parts ?? []) {
    if (
      (role === "user" || role === "assistant") &&
      part.type === "text" &&
      !part.ignored &&
      typeof part.text === "string" &&
      part.text.length > 0
    ) {
      entries.push({
        type: "message",
        role,
        text: part.text,
        ...(entryTimestamp ? { timestamp: entryTimestamp } : {}),
      });
      continue;
    }
    if (part.type !== "tool" || typeof part.tool !== "string") continue;

    const toolCallId = part.callID ?? part.callId;
    const input = serialize(part.state?.input);
    entries.push({
      type: "tool_call",
      name: part.tool,
      ...(input === undefined ? {} : { input }),
      ...(typeof toolCallId === "string" ? { toolCallId } : {}),
      ...(entryTimestamp ? { timestamp: entryTimestamp } : {}),
    });

    const isError = part.state?.status === "error" || part.state?.error != null;
    const result = isError ? part.state?.error : part.state?.output;
    if (result !== undefined) {
      entries.push({
        type: "tool_result",
        text: serialize(result) ?? "[Non-text result omitted]",
        ...(typeof toolCallId === "string" ? { toolCallId } : {}),
        ...(isError ? { isError: true } : {}),
        ...(entryTimestamp ? { timestamp: entryTimestamp } : {}),
      });
    }
  }
  return entries;
}

export const ArchestraTranscript = async ({ client, directory }) => ({
  event: async ({ event }) => {
    const runtimeDir = process.env.ARCHESTRA_AGENT_RUNTIME_DIR ?? "/var/run/archestra";
    const sessionFile = `${runtimeDir}/opencode-main-session`;
    if (event.type === "session.created") {
      const info = event.properties?.info;
      if (info?.id && !info.parentID && !existsSync(sessionFile)) {
        writeFileSync(sessionFile, `${info.id}\n`, "utf8");
      }
      return;
    }
    if (event.type !== "session.idle" && event.type !== "session.error") return;

    const sessionID = event.properties?.sessionID;
    if (!sessionID) return;
    const sessionResponse = await client.session.get({
      path: { id: sessionID },
      query: { directory },
    });
    if (!sessionResponse.data || sessionResponse.data.parentID) return;
    if (existsSync(sessionFile)) {
      if (readFileSync(sessionFile, "utf8").trim() !== sessionID) return;
    } else {
      writeFileSync(sessionFile, `${sessionID}\n`, "utf8");
    }

    if (event.type === "session.error") {
      // OpenCode also emits this while automatically compacting context.
      if (event.properties.error?.name === "ContextOverflowError") {
        try {
          unlinkSync(`${runtimeDir}/opencode-attention-kind`);
        } catch {
          // The marker is optional state; a missing marker is already clear.
        }
        reportCommandFailure("attention clear", await runRuntimeCommand(
          process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention",
          ["clear"],
        ));
        return;
      }
      const classification = nativeErrorClassification(event.properties?.error);
      if (process.env.ARCHESTRA_AGENT_RUNTIME_MODE !== "one_shot") {
        await emitDiagnostic(classification.code, runtimeDir);
        await reportInteractiveFailure(classification, runtimeDir);
        return;
      }
      const message = classification.message;
      reportCommandFailure("runtime failure", await runRuntimeCommand(
        process.env.ARCHESTRA_AGENT_FAILURE_COMMAND ?? "archestra-agent-failure",
        [classification.code, message],
      ));
      if (process.env.ARCHESTRA_AGENT_RUNTIME_PLAIN === "1") return;
      writeFileSync(`${runtimeDir}/final-answer.txt`, `${message}\n`, "utf8");
      writeFileSync(`${runtimeDir}/turn-complete.failed`, "", "utf8");
      writeFileSync(`${runtimeDir}/turn-complete`, "", "utf8");
      return;
    }

    const response = await client.session.messages({
      path: { id: sessionID },
      query: { directory },
    });
    const messages = response.data ?? [];
    const transcript = {
      version: 1,
      provider: "opencode",
      entries: messages.flatMap(entriesForMessage),
    };
    const temporaryPath = `${runtimeDir}/readable-transcript.tmp.json`;
    await writeFile(temporaryPath, `${JSON.stringify(transcript)}\n`, "utf8");
    await rename(temporaryPath, `${runtimeDir}/readable-transcript.json`);

    if (
      process.env.ARCHESTRA_AGENT_RUNTIME_MODE !== "one_shot" ||
      process.env.ARCHESTRA_AGENT_RUNTIME_PLAIN === "1"
    ) return;

    const assistant = [...messages]
      .reverse()
      .find((message) => message.info?.role === "assistant");
    const answer = (assistant?.parts ?? [])
      .filter((part) => part.type === "text" && !part.ignored)
      .map((part) => part.text)
      .join("")
      .trim();
    if (!answer || existsSync(`${runtimeDir}/turn-complete.failed`)) return;

    // Native run can exit immediately after its idle event. Publish the answer
    // and completion marker in the same callback tick, without an async gap.
    writeFileSync(`${runtimeDir}/final-answer.txt`, `${answer}\n`, "utf8");
    writeFileSync(`${runtimeDir}/turn-complete`, "", "utf8");
  },
});
PLUGIN
chmod 0600 "${transcript_plugin}"

printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}" > "${instructions_file}"
printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"

jq -n \
  --arg model "${model}" \
  --arg base_url "${OPENAI_BASE_URL:?}" \
  --arg api_key '{env:OPENAI_API_KEY}' \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  --arg mcp_url "${ARCHESTRA_MCP_GATEWAY_URL:?}" \
  --arg mcp_token "${ARCHESTRA_MCP_GATEWAY_TOKEN:?}" \
  --arg instructions_file "${instructions_file}" \
  --arg attention_plugin "${attention_plugin}" \
  --arg transcript_plugin "${transcript_plugin}" \
  --argjson context_length "${context_length}" \
  --argjson output_length "${output_length}" \
  '{
    "$schema":"https://opencode.ai/config.json",
    autoupdate:false,
    plugin:[$attention_plugin, ("file://" + $transcript_plugin)],
    model:("archestra/" + $model),
    permission:"allow",
    instructions:[$instructions_file],
    provider:{archestra:{
      npm:"@ai-sdk/openai",
      name:"Archestra",
      options:{
        baseURL:$base_url,
        apiKey:$api_key,
        headers:{
          "X-Archestra-Run-Id":$task_id,
          "X-Archestra-Session-Id":$task_id
        }
      },
      models:{($model):{
        name:$model,
        tool_call:true,
        limit:{context:$context_length,output:$output_length}
      }}
    }},
    mcp:{archestra:{
      type:"remote",
      url:$mcp_url,
      enabled:true,
      oauth:false,
      headers:{
        Authorization:("Bearer " + $mcp_token),
        "X-Archestra-Run-Id":$task_id,
        "X-Archestra-Session-Id":$task_id
      }
    }}
  }' > "${config_file}"
chmod 0600 "${config_file}" "${instructions_file}" "${task_file}"

resume_args=()
if [[ "${ARCHESTRA_AGENT_RUNTIME_CONTINUE:-0}" == "1" ]]; then
  session_file="${runtime_dir}/opencode-main-session"
  if [[ ! -s "${session_file}" ]]; then
    echo "archestra: Cannot resume the saved OpenCode session: its session ID is missing. The workspace is preserved; no new session was started." >&2
    exit 78
  fi
  resume_args=(--session "$(cat "${session_file}")")
fi
terminal_command=(opencode --auto --model "archestra/${model}" --prompt "$(cat "${task_file}")")
if [[ "${ARCHESTRA_AGENT_RUNTIME_CONTINUE:-0}" == "1" ]]; then
  # The full-screen TUI drops --prompt when restoring an existing session.
  # The native interactive run command both restores it and submits the new
  # instruction, while keeping terminal input available for live steering.
  terminal_command=(opencode run --interactive "${resume_args[@]}" --auto --model "archestra/${model}" -- "$(cat "${task_file}")")
fi
case "${runtime_mode}" in
  interactive)
    exec "${terminal_command[@]}"
    ;;
  one_shot)
    if [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]]; then
      export OPENCODE_PURE=1
      exec opencode run \
        "${resume_args[@]}" \
        --pure \
        --auto \
        --model "archestra/${model}" \
        -- "$(cat "${task_file}")"
    fi

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "${script_dir}/archestra-tui-run" \
      "${runtime_dir}/turn-complete" \
      "${runtime_dir}/final-answer.txt" \
      "${terminal_command[@]}"
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
