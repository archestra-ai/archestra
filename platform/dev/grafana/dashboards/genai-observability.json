      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:16px;min-height:48px\"><img alt=\"Archestra\" src=\"data:image/png;base64,\" width=\"48\" height=\"48\" style=\"flex:0 0 48px;width:48px;height:48px;object-fit:contain;border-radius:6px\" /><div style=\"min-width:0\"><h2 style=\"font-size:14px;line-height:20px;font-weight:600;margin:0\">LLM Proxy</h2><p style=\"font-size:12px;line-height:15px;margin:2px 0 0\">Find slow or failing model requests and compare token usage.</p></div></div>"
      }
    },
    {
      "id": 90002,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 2
      },
      "options": {
        "mode": "html",
        "content": "<nav aria-label=\"Observability dashboards\"><table role=\"presentation\" style=\"width:100%;table-layout:fixed;border-collapse:separate;border-spacing:2px\"><tbody><tr><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Costs &amp; Limits\" href=\"/d/archestra-costs-and-limits?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Costs &amp; Limits</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Agent Runtime\" href=\"/d/archestra-agent-runtime?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Agent Runtime</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Guardrails &amp; OpenAPPA\" href=\"/d/archestra-guardrails?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Guardrails</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"MCP Monitoring\" href=\"/d/archestra-mcp-monitoring?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">MCP Monitoring</a></td></tr><tr><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Knowledge Base Operations\" href=\"/d/archestra-rag-knowledge-base?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Knowledge Base</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Platform Health\" href=\"/d/archestra-application-metrics?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Platform Health</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Session Investigation\" href=\"/d/archestra-agent-sessions?${__url_time_range}&amp;var-metrics_datasource=${metrics_datasource}\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Sessions</a></td><td style=\"width:25%;padding:0\"><a target=\"_parent\" title=\"Metrics reference\" href=\"https://archestra.ai/docs/admin/observability/metrics\" style=\"display:block;text-align:center;padding:3px 4px;border:1px solid #526078;border-radius:5px;color:inherit;text-decoration:none;font-size:11px;line-height:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Metrics docs</a></td></tr></tbody></table></nav>"
      }
