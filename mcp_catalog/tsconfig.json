{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noEmit": false,
    "types": ["node", "vitest/globals"],

    /* Aliasing */
    "baseUrl": ".",
    "paths": {
      "@archestra/types": ["src/types.ts"],
      "@constants": ["src/constants.ts"],
      "@lib/*": ["src/lib/*"],
      "@schemas": ["src/schemas/index.ts"],
      "@schemas/*": ["src/schemas/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
