+import { verifyBearerToken } from "@better-auth/core/oauth2";
+// Keep the legacy OAuth provider on its current storage schema while using
+// the patched verifier, including issuer/audience and sender-binding checks.
+export async function verifyAccessToken(token, opts) {
+	const { scopes, ...verification } = opts;
+	return verifyBearerToken(token, {
+		...verification,
+		requiredScopes: [...(verification.requiredScopes ?? []), ...(scopes ?? [])],
+		isScopeSatisfied: void 0
+	});
+}
