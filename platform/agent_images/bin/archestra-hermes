#!/usr/bin/env bash
set -euo pipefail

if [[ "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" != "openai_chat" ]]; then
  echo "archestra: Hermes requires an Agent configured for OpenAI Chat Completions" >&2
  exit 78
fi

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
export HERMES_HOME="${runtime_dir}/hermes"
mkdir -p "${HERMES_HOME}"
attention_plugin_dir="${HERMES_HOME}/plugins/archestra-attention"
mkdir -p "${attention_plugin_dir}"
cat > "${attention_plugin_dir}/plugin.yaml" <<'PLUGIN_MANIFEST'
name: archestra-attention
version: 1.0.0
description: Report Hermes input and permission waits to Archestra Agent Runtime.
author: Archestra
hooks:
  - on_session_start
  - pre_llm_call
  - pre_tool_call
  - post_tool_call
  - pre_approval_request
  - post_approval_response
  - on_session_end
PLUGIN_MANIFEST
cat > "${attention_plugin_dir}/__init__.py" <<'PLUGIN'
from __future__ import annotations

import os
import subprocess
from typing import Any


def register(ctx: Any) -> None:
    ctx.register_hook("on_session_start", _clear)
    ctx.register_hook("pre_llm_call", _clear)
    ctx.register_hook("pre_tool_call", _pre_tool_call)
    ctx.register_hook("post_tool_call", _post_tool_call)
    ctx.register_hook("pre_approval_request", _pre_approval_request)
    ctx.register_hook("post_approval_response", _clear)
    ctx.register_hook("on_session_end", _on_session_end)


def _pre_tool_call(tool_name: str = "", **_: Any) -> None:
    if tool_name == "clarify":
        _attention("set", "Input requested")


def _post_tool_call(tool_name: str = "", **_: Any) -> None:
    if tool_name == "clarify":
        _attention("clear")


def _pre_approval_request(**_: Any) -> None:
    _attention("set", "Permission needed")


def _on_session_end(completed: bool = False, **_: Any) -> None:
    if os.environ.get("ARCHESTRA_AGENT_RUNTIME_MODE", "one_shot") == "interactive" and completed:
        _attention("set", "Waiting for input")
    else:
        _attention("clear")


def _clear(**_: Any) -> None:
    _attention("clear")


def _attention(action: str, label: str = "") -> None:
    command = os.environ.get(
        "ARCHESTRA_AGENT_ATTENTION_COMMAND", "archestra-agent-attention"
    )
    args = [command, action]
    if label:
        args.append(label)
    try:
        subprocess.run(
            args,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        pass
PLUGIN
jq -n \
  --arg base_url "${OPENAI_BASE_URL:?}" \
  --arg model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}" \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  --arg mcp_url "${ARCHESTRA_MCP_GATEWAY_URL:?}" \
  --arg gateway_token "${ARCHESTRA_MCP_GATEWAY_TOKEN:?}" \
  --arg system_prompt "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}" \
  '{
    providers:{archestra:{
      name:"Archestra",
      base_url:$base_url,
      key_env:"OPENAI_API_KEY",
      default_model:$model,
      transport:"openai_chat"
    }},
    agent:{system_prompt:$system_prompt},
    plugins:{enabled:["archestra-attention"]},
    model:{
      max_tokens:16384,
      context_length:1047576,
      default_headers:{
        "X-Archestra-Run-Id":$task_id,
        "X-Archestra-Session-Id":$task_id
      }
    },
    mcp_servers:{archestra:{
      url:$mcp_url,
      headers:{
        Authorization:("Bearer " + $gateway_token),
        "X-Archestra-Run-Id":$task_id,
        "X-Archestra-Session-Id":$task_id
      }
    }}
  }' > "${HERMES_HOME}/config.yaml"
chmod 0600 "${HERMES_HOME}/config.yaml"

# Hermes reads its ordinary config from ~/.hermes.
mkdir -p "${HOME}/.hermes"
ln -sf "${HERMES_HOME}/config.yaml" "${HOME}/.hermes/config.yaml"
task_file="${runtime_dir}/task.md"
printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"

common_args=(
  --provider archestra
  --model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
  --yolo
)

case "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" in
  interactive)
    exec hermes chat \
      "${common_args[@]}" \
      --tui \
      --query "$(cat "${task_file}")"
    ;;
  one_shot)
    set +e
    hermes chat \
      "${common_args[@]}" \
      --query "$(cat "${task_file}")" \
      2>&1 | tee "${runtime_dir}/hermes-output.log"
    status=${PIPESTATUS[0]}
    set -e
    if [[ ${status} -ne 0 ]] || grep -Eq 'HTTP [45][0-9]{2}:|Traceback \(most recent call last\)|LLM request failed|api_validation_error|Context length exceeded|\[exit [1-9][0-9]*\]|Failed to ' "${runtime_dir}/hermes-output.log"; then
      exit 1
    fi
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
