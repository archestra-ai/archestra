{
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "dependsOn": ["@archestra/shared#type-check", "@archestra/drizzle-migration-linter#type-check"],
      "outputs": [".tsbuild/**"]
    },
    "check:commit": {
      "dependsOn": ["@archestra/shared#type-check", "@archestra/drizzle-migration-linter#type-check"],
      "outputs": [".tsbuild/**"]
    },
    "check:ci": {
      "dependsOn": ["@archestra/shared#type-check", "@archestra/drizzle-migration-linter#type-check", "@archestra/app-runtime-rs#build", "@archestra/sandbox-rs#build"],
      "outputs": [".tsbuild/**"]
    }
  }
}
