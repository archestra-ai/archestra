    {
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource}"
      },
      "description": "Application logs correlated with the selected session via trace ID. Shows logs from spans belonging to this session.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 8,
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs_datasource}"
          },
          "editorMode": "code",
          "expr": "{service_name=\"Archestra Platform API\"} | json | gen_ai_conversation_id = `$sessionId`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Session Logs",
      "type": "logs"
