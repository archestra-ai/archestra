{
  "name": "@archestra/sandbox-rs",
  "version": "1.2.50",
  "private": true,
  "type": "commonjs",
  "main": "index.cjs",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --release --platform",
    "check:ci": "cargo fmt --check --all && cargo check --workspace --locked && cargo test --workspace --locked && pnpm build && pnpm smoke",
    "lint": "cargo fmt --check --all",
    "smoke": "node smoke.test.cjs",
    "test": "cargo test --workspace --locked",
    "type-check": "cargo check --workspace --locked"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.0"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "*.node"
  ]
}
