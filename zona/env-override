# The settings each worktree's stack needs in the zona VM. zona fills in
# the placeholders ($ZONA_PORT_3000 is 13000 in block 0, 14000 in block 1)
# and these lines win over the same keys in your own platform/.env.

# Ports, the same number in the VM and on the Mac.
ARCHESTRA_FRONTEND_PORT=$ZONA_PORT_3000
ARCHESTRA_FRONTEND_INT_TESTS_PORT=$ZONA_PORT_3010
ARCHESTRA_INTERNAL_API_BASE_URL=http://localhost:$ZONA_PORT_9000
NEXT_PUBLIC_ARCHESTRA_INTERNAL_API_BASE_URL=http://localhost:$ZONA_PORT_9000
ARCHESTRA_METRICS_PORT=$ZONA_PORT_9050
ARCHESTRA_POSTGRES_HOST_PORT=$ZONA_PORT_5432
ARCHESTRA_POSTGRES_METRICS_HOST_PORT=$ZONA_PORT_9187
ARCHESTRA_DATABASE_URL=postgresql://archestra:archestra_dev_password@localhost:$ZONA_PORT_5432/archestra_dev?schema=public
ARCHESTRA_TILT_PORT=$ZONA_PORT_10350
# tilt logs, tilt trigger and the other tilt commands find this worktree's Tilt.
TILT_PORT=$ZONA_PORT_10350

# The browser on the Mac reaches the stack on these, and auth trusts only the
# origin in ARCHESTRA_FRONTEND_URL.
ARCHESTRA_FRONTEND_URL=http://localhost:$ZONA_PORT_3000
ARCHESTRA_API_BASE_URL=http://localhost:$ZONA_PORT_9000

# A Kubernetes namespace (database, MCP servers, Agent Runtime pods) and login
# cookies of its own, so stacks run side by side.
ARCHESTRA_K8S_NAMESPACE=archestra-dev-$ZONA_WORKTREE
ARCHESTRA_ORCHESTRATOR_K8S_NAMESPACE=archestra-dev-$ZONA_WORKTREE
ARCHESTRA_AUTH_COOKIE_PREFIX=archestra-dev-$ZONA_WORKTREE

# Tilt builds the OpenAPPA addon only with ARCHESTRA_BETA=true; without it the
# backend's /ready stays 503.
ARCHESTRA_BETA=true
# Agent Runtime pods in kind reach this worktree's backend through the kind
# network's gateway, which provision.sh fixes at 172.30.0.1; start.sh starts
# the bridge on this port. Setting the URL is also what turns Agent Runtime on.
ARCHESTRA_AGENT_RUNTIME_PLATFORM_BASE_URL=http://172.30.0.1:$ZONA_PORT_9000
# No spare Agent Runtime pod: a spare holds its full size (8 GiB) while idle.
ARCHESTRA_AGENT_RUNTIME_WARM_POOL_SIZE=0
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
