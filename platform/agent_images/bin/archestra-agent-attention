#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
label="${2:-}"
target="${TMUX_PANE:-agent}"

herdr_helper_available() {
  [[ -n "${HERDR_ENV:-}" ]] && command -v archestra-terminal >/dev/null 2>&1
}

event_helper_available() {
  local prefix="${ARCHESTRA_AGENT_RUNTIME_TURN_PREFIX:-}"
  [[ -n "$prefix" ]] && command -v archestra-agent-event >/dev/null 2>&1 \
    && [[ -f "${prefix}.events/context.json" ]]
}

report_runtime_event() {
  local status="$1"
  local attention="$2"
  local prefix="${ARCHESTRA_AGENT_RUNTIME_TURN_PREFIX:-}"
  local payload
  if ! event_helper_available; then
    return 0
  fi
  if ! payload=$(jq -cn --arg status "$status" --arg attention "$attention" \
    '{type:"agent.status",status:$status,attention:(if $attention == "" then null else $attention end)}'); then
    return 0
  fi
  local event_error
  if ! event_error="$(archestra-agent-event emit --context "${prefix}.events/context.json" \
    --source native-attention \
    "$payload" 2>&1 >/dev/null)"; then
    printf 'archestra-agent-attention: runtime event unavailable: %s\n' "$event_error" >&2
  fi
}

report_attention() {
  local attention_state="${1:-}"
  if event_helper_available; then
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    return
  fi

  local body
  if [[ -n "${attention_state}" ]]; then
    body="$(jq -cn \
      --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
      --arg attention_state "${attention_state}" \
      '{taskId:$task_id,attentionState:$attention_state}')"
  else
    body="$(jq -cn \
      --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
      '{taskId:$task_id,attentionState:null}')"
  fi
  curl --fail --silent --show-error --max-time 2 \
    -H "Authorization: Bearer ${ARCHESTRA_MCP_GATEWAY_TOKEN:?}" \
    -H "Content-Type: application/json" \
    --data-binary "${body}" \
    "${ARCHESTRA_MCP_GATEWAY_URL:?}/runtime-status" >/dev/null 2>&1 || true
}

case "${action}" in
  set)
    if [[ -z "${label}" ]]; then
      echo "usage: archestra-agent-attention set <label>" >&2
      exit 64
    fi
    changed=0
    if herdr_helper_available; then
      current_state="$(archestra-terminal attention get)" || {
        echo "archestra: unable to read Herdr attention state" >&2
        exit 1
      }
      current="$(jq -r 'if .active == true then "1" else "0" end' <<<"${current_state}")"
      current_label="$(jq -r '.label // ""' <<<"${current_state}")"
      archestra-terminal attention set "${label}" >/dev/null
      if [[ "${current}" != "1" || "${current_label}" != "${label}" ]]; then
        report_attention "input_required"
        changed=1
      fi
    else
      current="$(tmux show-option -t "${target}" -qv @archestra_attention 2>/dev/null || true)"
      current_label="$(tmux show-option -t "${target}" -qv @archestra_attention_label 2>/dev/null || true)"
      tmux set-option -t "${target}" @archestra_attention 1 >/dev/null 2>&1 || true
      tmux set-option -t "${target}" @archestra_attention_label "${label}" >/dev/null 2>&1 || true
      if [[ "${current}" != "1" || "${current_label}" != "${label}" ]]; then
        report_attention "input_required"
        changed=1
      fi
    fi
    if [[ "$changed" == "1" ]]; then
      report_runtime_event "idle" "${ARCHESTRA_AGENT_RUNTIME_ATTENTION_KIND:-input_required}"
    fi
    ;;
  clear)
    changed=0
    if herdr_helper_available; then
      current_state="$(archestra-terminal attention get)" || {
        echo "archestra: unable to read Herdr attention state" >&2
        exit 1
      }
      current="$(jq -r 'if .active == true then "1" else "0" end' <<<"${current_state}")"
      archestra-terminal attention clear >/dev/null
      if [[ "${current}" == "1" ]]; then
        report_attention ""
        changed=1
      fi
    else
      current="$(tmux show-option -t "${target}" -qv @archestra_attention 2>/dev/null || true)"
      tmux set-option -t "${target}" @archestra_attention 0 >/dev/null 2>&1 || true
      tmux set-option -t "${target}" @archestra_attention_label "" >/dev/null 2>&1 || true
      if [[ "${current}" == "1" ]]; then
        report_attention ""
        changed=1
      fi
    fi
    if [[ "$changed" == "1" ]]; then
      report_runtime_event "working" ""
    fi
    ;;
  *)
    echo "usage: archestra-agent-attention {set <label>|clear}" >&2
    exit 64
    ;;
esac
