#!/usr/bin/env python3
"""Run the native setup-token flow; return its token only to the secrets backend.

Status responses and errors never include terminal output or credentials.
All files live in the disposable sign-in Job, never a persistent volume.
"""

import fcntl
import json
import os
from pathlib import Path
import re
import selectors
import subprocess
import sys
import time


def main():
    os.umask(0o077)
    directory.mkdir(mode=0o700, exist_ok=True)
    Path(os.environ["CLAUDE_CONFIG_DIR"]).mkdir(mode=0o700, exist_ok=True)
    operation = sys.argv[1]
    with (directory / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if operation == "start":
            if not login_running():
                run([
                    "tmux", "new-session", "-d", "-s", session,
                    "-x", "500", "-y", "40",
                    "claude setup-token; printf '%s' $? > /tmp/archestra-claude-account/exit-status; sleep 600",
                ])
            result = status()
        elif operation == "status":
            result = status()
        elif operation == "complete":
            request = json.loads(sys.stdin.read(16384))
            if request.get("flowId") != flow_id:
                raise ValueError("The sign-in expired")
            code = request.get("code", "").strip()
            if code and not submitted.exists():
                if (len(code) > 4096 or any(ord(char) < 32 or ord(char) > 126 for char in code) or not login_running()):
                    raise ValueError("Invalid authorization code")
                run(["tmux", "load-buffer", "-b", session, "-"], input=code)
                run(["tmux", "paste-buffer", "-d", "-b", session, "-t", session])
                run(["tmux", "send-keys", "-t", session, "Enter"])
                submitted.touch(mode=0o600)
            token = captured_token()
            if token:
                result = {"state": "connected", "token": token, "models": supported_models(token)}
            else:
                result = {"state": "failed" if exit_file.exists() else "connecting"}
        elif operation == "models":
            request = json.loads(sys.stdin.read(16384))
            token = request.get("token", "")
            if not TOKEN.fullmatch(token):
                raise ValueError("Invalid subscription token")
            result = {"state": "connected", "models": supported_models(token)}
        else:
            raise ValueError("Unknown account operation")
    print(json.dumps(result))


def run(command, **kwargs):
    kwargs.setdefault("check", True)
    return subprocess.run(command, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL, timeout=20, **kwargs)


def login_running():
    return run(["tmux", "has-session", "-t", session], check=False).returncode == 0


def pane():
    if not login_running():
        return ""
    text = run(["tmux", "capture-pane", "-p", "-J", "-S", "-", "-t", session]).stdout
    return re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)


def captured_token():
    tokens = set(TOKEN.findall(pane()))
    if len(tokens) > 1:
        raise ValueError("Ambiguous subscription credential")
    return next(iter(tokens), None)


def status():
    captured = pane()
    if TOKEN.search(captured):
        return {"state": "connecting", "flowId": flow_id}
    if exit_file.exists() or not login_running():
        return {"state": "failed"}
    if submitted.exists():
        return {"state": "connecting", "flowId": flow_id}
    match = re.search(r"https://(?:claude\.com/cai|claude\.ai)/oauth/authorize\?[^\s\x1b]+", captured)
    if match:
        return {"state": "awaiting_code", "flowId": flow_id, "authorizationUrl": match.group(0)}
    return {"state": "starting", "flowId": flow_id}


def cli_environment(token):
    env = os.environ.copy()
    for key in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "ANTHROPIC_CUSTOM_HEADERS", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "CLAUDE_CODE_OAUTH_REFRESH_TOKEN"):
        env.pop(key, None)
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    return env


def supported_models(token):
    process = subprocess.Popen(
        ["claude", "--print", "--input-format", "stream-json",
         "--output-format", "stream-json", "--verbose", "--tools", "",
         "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
         "--setting-sources", ""],
        env=cli_environment(token),
        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    try:
        process.stdin.write(json.dumps({
            "type": "control_request", "request_id": "runtime-models",
            "request": {"subtype": "initialize"},
        }).encode() + b"\n")
        process.stdin.flush()
        deadline = time.monotonic() + 20
        buffer = b""
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if not selector.select(timeout=1):
                    continue
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    break
                buffer += chunk
                if len(buffer) > 262144:
                    raise ValueError("Claude Code metadata exceeded the size limit")
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    message = json.loads(line)
                    response = message.get("response", {})
                    if response.get("request_id") != "runtime-models":
                        continue
                    models = response.get("response", {}).get("models", [])
                    return [
                        {"value": entry["value"], "displayName": entry["displayName"],
                         "description": entry.get("description", "")}
                        for entry in models
                        if isinstance(entry.get("value"), str)
                        and isinstance(entry.get("displayName"), str)
                    ]
        raise ValueError("Claude Code did not return its available models")
    finally:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


TOKEN = re.compile(r"sk-ant-oat[0-9]+-[A-Za-z0-9_-]{32,8192}")
directory = Path("/tmp/archestra-claude-account")
submitted = directory / "submitted"
exit_file = directory / "exit-status"
flow_id = os.environ.get("ARCHESTRA_AGENT_RUNTIME_CLAUDE_FLOW_ID", "")
session = "archestra-claude-login"

if __name__ == "__main__":
    try:
        main()
    except Exception:
        print(json.dumps({"state": "failed"}))
        sys.exit(1)
