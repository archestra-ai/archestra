{
  "name": "mcp-catalog",
  "version": "0.0.0-alpha",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prettier": "prettier --write .",
    "catalog:evaluate": "npx tsx src/scripts/evaluate-catalog.ts",
    "catalog:validate": "npx tsx src/scripts/validate-catalog.ts"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^5.0.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
