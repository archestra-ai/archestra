    {
      "id": 16,
      "title": "Last exceeded check time",
      "type": "table",
      "description": "Newest observation per rule/target across replicas. Retained for 24 hours in each process; absent is not proof of budget headroom.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * max by (limit_id,entity_id,entity_type,limit_kind,behavior,cleanup_interval,source) (llm_limit_last_exceeded_timestamp_seconds{job=~\"$job\"})",
          "legendFormat": "auto",
          "instant": true,
          "range": false,
          "format": "table"
