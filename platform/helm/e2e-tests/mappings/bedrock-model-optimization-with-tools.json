{
  "request": {
    "method": "POST",
    "urlPathPattern": "/bedrock/model/.*/converse",
    "headers": {
      "Authorization": {
        "contains": "bedrock-model-optimization-with-tools"
      }
    },
    "bodyPatterns": [
      {
        "contains": "e2e-test-bedrock-optimized"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "output": {
        "message": {
          "role": "assistant",
          "content": [
            {
              "text": "This is a response for a request with tools."
            }
          ]
        }
      },
      "stopReason": "end_turn",
      "usage": {
        "inputTokens": 1500,
        "outputTokens": 15
      }
    }
  }
}
