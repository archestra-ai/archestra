      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(llm_cost_total{job=~\"$job\",billing_mode=\"metered\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{provider}}",
          "instant": false,
          "range": true
