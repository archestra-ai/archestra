  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "## Agent Sessions Audit Trail\n\nThis dashboard provides a session-level view of agent activity. Use the filters above to select an agent, then click a **Session ID** in the table below to drill into the full audit trail.\n\n**Workflow**: Filter by agent name → Find a session → Click the Session ID → View all LLM calls, MCP tool calls, and logs for that session.",
        "mode": "markdown"
      },
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "title": "Recent Sessions",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource}"
      },
      "description": "Recent agent sessions. Click a Session ID to drill into the full audit trail of LLM and MCP requests.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.conversation.id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Session ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View session detail",
                    "url": "/d/archestra-agent-sessions/archestra-agent-sessions?var-sessionId=${__data.fields[\"gen_ai.conversation.id\"]}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.agent.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Agent Name"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.provider.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Provider"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.request.model"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Model"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "route.category"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Type"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "enablePagination": true,
          "fields": "",
          "reducer": ["count"],
          "show": true
        },
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource}"
          },
          "queryType": "traceqlSearch",
          "limit": 100,
          "tableType": "spans",
          "filters": [
            {
              "id": "service-name",
              "scope": "resource",
              "tag": "service.name",
              "operator": "=",
              "value": ["Archestra Platform API"],
              "valueType": "string"
            },
            {
              "id": "conversation-id",
              "scope": "span",
              "tag": "gen_ai.conversation.id",
              "operator": "!=",
              "value": [""],
              "valueType": "string"
            },
            {
              "id": "route-category",
              "scope": "span",
              "tag": "route.category",
              "operator": "=~",
              "value": ["llm-proxy|mcp-gateway"],
              "valueType": "string"
            },
            {
              "id": "agent-name",
              "scope": "span",
              "tag": "gen_ai.agent.name",
              "operator": "=~",
              "value": ["$agent_name"],
              "valueType": "string"
            }
          ],
          "spss": 10,
          "refId": "A"
        }
      ],
      "title": "Recent Agent Sessions",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 4,
      "title": "Session Detail — $sessionId",
      "type": "row",
      "repeat": null,
      "panels": []
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource}"
      },
      "description": "All LLM and MCP spans for the selected session displayed as a timeline. Each trace represents a full request lifecycle.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces_datasource}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"Archestra Platform API\" && span.gen_ai.conversation.id=\"$sessionId\" && span.route.category=~\"llm-proxy|mcp-gateway\"}",
          "limit": 100,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "title": "Session Timeline",
      "type": "traces"
    },
    {
      "datasource": {
        "type": "tempo",
