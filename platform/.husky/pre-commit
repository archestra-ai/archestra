# With zona (IS_ZONA_USED=1, see zona/), this machine has no node_modules to
# check with: the check runs in the zona VM, on what this commit stages. It
# fails closed: a worktree zona hasn't started refuses the commit.
if [ -n "${IS_ZONA_USED:-}" ]; then
  exec zona commit-check
fi
cd platform
if ! pnpm commit:check; then
  echo ""
  echo "💡 Tip: Run 'pnpm lint:fix -- --unsafe && pnpm -r knip --fix' to auto-fix formatting and unused exports."
  echo ""
  exit 1
fi
