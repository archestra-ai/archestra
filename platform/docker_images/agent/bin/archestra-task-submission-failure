#!/bin/sh
set -eu

# The client started with its MCP tools, but the task never reached its input.
message="The Agent started, but its task could not be submitted to the Claude Code terminal. Retry the task; if it fails again, report this runtime error."
"$(dirname "$0")/archestra-agent-failure" task_submission "$message"
printf 'archestra: %s\n' "$message" >&2
if [ "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" = one_shot ]; then
  runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
  printf '%s\n' "$message" > "${runtime_dir}/final-answer.txt"
  touch "${runtime_dir}/turn-complete.failed" "${runtime_dir}/turn-complete"
else
  "${ARCHESTRA_AGENT_ATTENTION_COMMAND:-archestra-agent-attention}" \
    set "Task not submitted: check terminal" >/dev/null 2>&1 || true
fi
