{
  "id": null,
  "uid": "archestra-agent-runtime",
  "title": "Archestra / Agent Runtime",
  "description": "Fleet work health and runtime provisioning; individual session history is in Session Investigation.",
  "tags": [
    "archestra",
    "observability"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "metrics_datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "job",
        "label": "Deployment job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"llm_tokens_total|agent_runtime_health_collection_timestamp_seconds|http_request_duration_seconds_count\"}, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "kubernetes_datasource",
        "label": "Kubernetes metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${kubernetes_datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info, cluster)",
          "refId": "cluster"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${kubernetes_datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=~\"$cluster\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "runtime_pod",
        "label": "Runtime pod name regex",
        "type": "textbox",
        "query": "agent-run-.*",
        "current": {
          "text": "agent-run-.*",
          "value": "agent-run-.*"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Fleet lifecycle counters are global to the selected deployment job. Health conditions **overlap** and are database snapshots: deduplicate replicas with max before summing configured agents. Fresh heartbeats show orchestration liveness, not proof of model progress. Kubernetes panels use their own data source and require kube-state-metrics/cAdvisor; missing collectors show No samples. Change the pod regex to include custom workloads or warm pools."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Work requiring attention",
      "collapsed": false,
      "panels": [],
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Working tasks",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (job,agent_id,backend) (agent_runtime_health_tasks{job=~\"$job\",condition=\"working\"})) or (0 * max(agent_runtime_health_collection_timestamp_seconds{job=~\"$job\"}))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
