{
  // The backend's TypeScript projects, lowest first. `pnpm type-check` builds
  // them one at a time (scripts/type-check.ts), and editors find a file's
  // project here. Source projects emit declarations into .tsbuild/, which the
  // projects above them read instead of their sources:
  //   shared lib, migration linter lib -> schema -> core -> models
  //   -> models-agents -> models-upper -> runtime -> app -> test-support -> tests-*, tools
  // The options every project shares, and the `paths` alias the runtime tools
  // read through this file, are in tsconfig.base.json. pnpm check:projects
  // checks that every backend file is in exactly one project.
  "extends": "./tsconfig.base.json",
  "files": [],
  "references": [
    { "path": "../shared/tsconfig.lib.json" },
    { "path": "../tools/drizzle-migration-linter/tsconfig.lib.json" },
    { "path": "./tsconfig.schema.json" },
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.models.json" },
    { "path": "./tsconfig.models-agents.json" },
    { "path": "./tsconfig.models-upper.json" },
    { "path": "./tsconfig.runtime.json" },
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test-support.json" },
    { "path": "./tsconfig.tests-database.json" },
    { "path": "./tsconfig.tests-core.json" },
    { "path": "./tsconfig.tests-models.json" },
    { "path": "./tsconfig.tests-services.json" },
    { "path": "./tsconfig.tests-knowledge-base.json" },
    { "path": "./tsconfig.tests-agents.json" },
    { "path": "./tsconfig.tests-integrations.json" },
    { "path": "./tsconfig.tests-other.json" },
    { "path": "./tsconfig.tests-routes-proxy.json" },
    { "path": "./tsconfig.tests-routes-chat.json" },
    { "path": "./tsconfig.tests-routes-rest.json" },
    { "path": "./tsconfig.tools.json" }
  ]
}
