# Configuration for dev/docker-compose-n8n.yml
DOMAIN_NAME=localhost
SSL_EMAIL=admin@localhost
GENERIC_TIMEZONE=UTC
SUBDOMAIN=n8n

# LLM Provider Base URLs
ARCHESTRA_OPENAI_BASE_URL=https://api.openai.com/v1
ARCHESTRA_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Anthropic Workload Identity Federation (keyless auth; all of rule/org/service-account plus one token source required)
# ARCHESTRA_ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ARCHESTRA_ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ARCHESTRA_ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ARCHESTRA_ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ARCHESTRA_ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic.com/token
# ARCHESTRA_ANTHROPIC_IDENTITY_TOKEN=
ARCHESTRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Gemini via Vertex AI instead of Google AI Studio (uses ADC, not an API key)
# ARCHESTRA_GEMINI_VERTEX_AI_ENABLED=true
# ARCHESTRA_GEMINI_VERTEX_AI_PROJECT=my-gcp-project
# ARCHESTRA_GEMINI_VERTEX_AI_LOCATION=us-central1
# ARCHESTRA_GEMINI_VERTEX_AI_CREDENTIALS_FILE=/path/to/service-account-key.json
# Reach models Vertex AI serves only from its global endpoint (Gemini 3 and
# newer) while the location above still serves everything else. Leave off if the
# region was chosen for data residency: the global endpoint picks any region.
# ARCHESTRA_GEMINI_VERTEX_AI_ALLOW_GLOBAL_ENDPOINT=true
# Cohere Base URL (uses https://api.cohere.ai by default)
ARCHESTRA_COHERE_BASE_URL=https://api.cohere.ai
# Ollama Base URL (uncomment if using Ollama)
# ARCHESTRA_OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama Native base URL for the "Ollama (Native)" provider (/api/chat transport).
# Defaults to ARCHESTRA_OLLAMA_BASE_URL with the /v1 suffix stripped, so only set
# this if the native endpoint lives on a different host.
# ARCHESTRA_OLLAMA_NATIVE_BASE_URL=http://localhost:11434
# Upstream timeout (ms) for LLM-call fetches (chat→proxy and proxy→upstream).
# Opt-in: unset = undici defaults (5 min headers/body timeout). Raise it for slow
# upstreams such as CPU Ollama whose first token can take longer than 5 min.
# ARCHESTRA_LLM_PROXY_UPSTREAM_TIMEOUT_MS=600000
# Maximum number of virtual API keys per LLM API key (default 10)
# ARCHESTRA_LLM_PROXY_MAX_VIRTUAL_KEYS=10
# Default expiration for new virtual API keys in seconds (default 2592000 = 30 days, 0 = never)
# ARCHESTRA_LLM_PROXY_VIRTUAL_KEYS_DEFAULT_EXPIRATION_SECONDS=2592000
# Auto-classify subscription credentials (detected from the credential format,
# e.g. Anthropic sk-ant-oat… OAuth tokens from a Claude Max/Pro login) as
# subscription usage — reported as $0 billed spend while keeping the list-price
# estimate. Default true; set false to treat all traffic as metered.
# ARCHESTRA_LLM_COST_SUBSCRIPTION_AUTODETECT=true
# vLLM Base URL (uncomment if using vLLM)
# ARCHESTRA_VLLM_BASE_URL=http://localhost:8000/v1
# Zhipuai Base URL (optional - defaults to https://api.z.ai/api/paas/v4)
# ARCHESTRA_ZHIPUAI_BASE_URL=https://api.z.ai/api/paas/v4
# Mistral Base URL (optional - defaults to https://api.mistral.ai/v1)
# ARCHESTRA_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Perplexity Base URL (optional - defaults to https://api.perplexity.ai)
# ARCHESTRA_PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Groq Base URL (optional - defaults to https://api.groq.com/openai/v1)
# ARCHESTRA_GROQ_BASE_URL=https://api.groq.com/openai/v1
# xAI Base URL (optional - defaults to https://api.x.ai/v1)
# ARCHESTRA_XAI_BASE_URL=https://api.x.ai/v1
# xAI "X Premium (SuperGrok)" subscription auth mode — reuse an X Premium subscription for chat.
# OpenAI-compatible proxy used for OAuth session inference and model listing.
# ARCHESTRA_XAI_SUBSCRIPTION_BASE_URL=https://cli-chat-proxy.grok.com/v1
# OAuth issuer whose OIDC discovery document supplies the device/token endpoints (defaults to https://auth.x.ai)
# ARCHESTRA_XAI_SUBSCRIPTION_ISSUER=https://auth.x.ai
# Browser device authorization is accepted only from this pinned origin.
# ARCHESTRA_XAI_SUBSCRIPTION_VERIFICATION_ORIGIN=https://accounts.x.ai
# ARCHESTRA_XAI_SUBSCRIPTION_CLIENT_VERSION=1.0.0
# Public OAuth client id for the X Premium device-code login
# ARCHESTRA_XAI_SUBSCRIPTION_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
# Space-separated scopes requested at device-authorization time (drop grok-cli:access if xAI refuses it for your accounts)
# ARCHESTRA_XAI_SUBSCRIPTION_SCOPES=openid profile email offline_access api:access grok-cli:access
# OpenRouter Base URL (optional - defaults to https://openrouter.ai/api/v1)
# ARCHESTRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MiniMax Base URL (optional - defaults to https://api.minimax.io/v1)
# ARCHESTRA_MINIMAX_BASE_URL=https://api.minimax.io/v1
# MiniMax API key for the built-in chat feature
# ARCHESTRA_CHAT_MINIMAX_API_KEY=
# Kimi (Moonshot AI) Base URL (optional - defaults to https://api.moonshot.ai/v1)
# ARCHESTRA_KIMI_BASE_URL=https://api.moonshot.ai/v1
# Kimi (Moonshot AI) API key for the built-in chat feature
# ARCHESTRA_CHAT_KIMI_API_KEY=
# Azure AI Foundry Base URL (required - format: https://<resource>.openai.azure.com/openai/deployments/<deployment>)
# ARCHESTRA_AZURE_OPENAI_BASE_URL=
# Azure AI Foundry API Version (optional - defaults to 2024-02-01)
# ARCHESTRA_AZURE_OPENAI_API_VERSION=2024-02-01
# Azure AI Foundry Responses API Version (optional - defaults to 2025-04-01-preview)
# ARCHESTRA_AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
# Azure AI Foundry API key for built-in chat feature
# ARCHESTRA_CHAT_AZURE_OPENAI_API_KEY=
# OpenAI "ChatGPT subscription" (Codex) auth mode — reuse a ChatGPT/Codex subscription for chat.
# All optional; defaults are the first-party Codex CLI values.
# Codex backend serving the subscription Responses API (defaults to https://chatgpt.com/backend-api/codex)
# ARCHESTRA_OPENAI_CODEX_API_BASE_URL=https://chatgpt.com/backend-api/codex
# OAuth issuer hosting the ChatGPT authorize/token/device endpoints (defaults to https://auth.openai.com)
# ARCHESTRA_OPENAI_CODEX_ISSUER=https://auth.openai.com
# Public OAuth client id for the ChatGPT/Codex login flow (defaults to the Codex CLI client id)
# ARCHESTRA_OPENAI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# `originator` header the Codex backend attributes traffic by (defaults to archestra, matching OpenCode's own-identity approach; override to codex_cli_rs if OpenAI ever restricts unknown originators)
# ARCHESTRA_OPENAI_CODEX_ORIGINATOR=archestra
# GitHub Copilot Base URL (optional - defaults to https://api.githubcopilot.com; GHE: https://copilot-api.<ghe-domain>)
# ARCHESTRA_GITHUB_COPILOT_BASE_URL=https://api.githubcopilot.com
# GitHub Copilot token exchange endpoint (optional - swaps a GitHub OAuth token for a short-lived Copilot bearer)
# ARCHESTRA_GITHUB_COPILOT_TOKEN_EXCHANGE_URL=https://api.github.com/copilot_internal/v2/token
# GitHub host for the Copilot device-flow sign-in (optional - defaults to https://github.com)
# ARCHESTRA_GITHUB_COPILOT_DEVICE_AUTH_BASE_URL=https://github.com
# GitHub App client id used for the Copilot device flow (optional - defaults to the community-standard VS Code client id)
# ARCHESTRA_GITHUB_COPILOT_CLIENT_ID=Iv1.b507a08c87ecfe98
# GitHub OAuth token (gho_...) for the built-in chat feature via Copilot
# ARCHESTRA_CHAT_GITHUB_COPILOT_API_KEY=
# Microsoft 365 Copilot Chat API base URL (optional - defaults to https://graph.microsoft.com/beta)
# ARCHESTRA_MICROSOFT_365_COPILOT_BASE_URL=https://graph.microsoft.com/beta
# Entra ID host for the Microsoft 365 Copilot device-flow sign-in and token redemption (optional)
# ARCHESTRA_MICROSOFT_365_COPILOT_AUTH_BASE_URL=https://login.microsoftonline.com
# Entra tenant segment of the OAuth endpoints (optional - defaults to "organizations"; pin your tenant id to restrict sign-in)
# ARCHESTRA_MICROSOFT_365_COPILOT_TENANT_ID=organizations
# Application (client) ID of your Entra app registration (required for Microsoft 365 Copilot sign-in; public client flows must be enabled)
# ARCHESTRA_MICROSOFT_365_COPILOT_CLIENT_ID=
# Archestra provider: route through another Archestra instance's OpenAI-compatible LLM proxy.
# No default — normally set per key as a Base URL (e.g. https://your-archestra/v1/proxy/openai/<agentId>).
# Setting this globally only enables raw passthrough at the /v1/archestra proxy prefix.
# ARCHESTRA_ARCHESTRA_BASE_URL=
# Archestra API key for the built-in chat feature (arch_...)
# ARCHESTRA_CHAT_ARCHESTRA_API_KEY=

# NOTE: use the following base URLs for testing w/ local wiremock service for e2e tests
# (see dev/Tiltfile.test)
# ARCHESTRA_OPENAI_BASE_URL=http://localhost:9092/openai/v1
# ARCHESTRA_ANTHROPIC_BASE_URL=http://localhost:9092/anthropic
# ARCHESTRA_GEMINI_BASE_URL=http://localhost:9092/gemini
# ARCHESTRA_VLLM_BASE_URL=http://localhost:9092/vllm/v1
# ARCHESTRA_OLLAMA_BASE_URL=http://localhost:9092/ollama/v1
# ARCHESTRA_CEREBRAS_BASE_URL=http://localhost:9092/cerebras/v1
# ARCHESTRA_ZHIPUAI_BASE_URL=http://localhost:9092/zhipuai/v4
# ARCHESTRA_COHERE_BASE_URL=http://localhost:9092/cohere
# ARCHESTRA_MISTRAL_BASE_URL=http://localhost:9092/mistral
# ARCHESTRA_BEDROCK_BASE_URL=http://localhost:9092/bedrock
# ARCHESTRA_PERPLEXITY_BASE_URL=http://localhost:9092/perplexity
# ARCHESTRA_GROQ_BASE_URL=http://localhost:9092/groq/v1
# ARCHESTRA_XAI_BASE_URL=http://localhost:9092/xai/v1
# ARCHESTRA_OPENROUTER_BASE_URL=http://localhost:9092/openrouter/api/v1
# ARCHESTRA_AZURE_OPENAI_BASE_URL=http://localhost:9092/azure/openai/deployments/test-deployment
# ARCHESTRA_AZURE_OPENAI_API_VERSION=2024-02-01
# ARCHESTRA_AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
# ARCHESTRA_GITHUB_COPILOT_BASE_URL=http://localhost:9092/github-copilot
# ARCHESTRA_GITHUB_COPILOT_TOKEN_EXCHANGE_URL=http://localhost:9092/github/copilot_internal/v2/token
# ARCHESTRA_MICROSOFT_365_COPILOT_BASE_URL=http://localhost:9092/microsoft-365-copilot
# ARCHESTRA_MICROSOFT_365_COPILOT_AUTH_BASE_URL=http://localhost:9092/microsoft-login

# Public MCP catalog URL.
# Defaults to the production catalog API (https://www.archestra.ai/mcp-catalog/api).
# If you are making changes to the MCP catalog API, point it to the port your locally running catalog server listens on.
# ARCHESTRA_MCP_CATALOG_API_BASE_URL=http://localhost:3001/mcp-catalog/api

# Per-request timeout (ms) for an upstream MCP tool call made through the gateway.
# Defaults to 60000 (60s); raise it for tools that take a long time to execute.
# ARCHESTRA_MCP_GATEWAY_TOOL_CALL_TIMEOUT_MS=60000

# Opt-in periodic re-discovery of installed MCP servers' tools: every N minutes each
# installed server's tool list is re-synced from the live server (add/update/remove,
# no restart). Unset or 0 disables it (the default).
# ARCHESTRA_MCP_SERVER_TOOLS_REFRESH_INTERVAL_MINUTES=30

# Database URL
ARCHESTRA_DATABASE_URL="postgresql://archestra:archestra_dev_password@localhost:5432/archestra_dev?schema=public"
# Run database migrations before backend startup (default true). Set false only
# when an external deployment pipeline applies migrations before rollout.
# ARCHESTRA_DATABASE_RUN_MIGRATIONS_ON_STARTUP=true
# Per-connection statement timeout in ms; kills runaway queries (default 30000, 0 disables)
# ARCHESTRA_DATABASE_STATEMENT_TIMEOUT_MILLIS=30000

# OpenTelemetry Configuration
# OTEL Exporter endpoint for sending traces (defaults to http://localhost:4318/v1/traces)
ARCHESTRA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL Authentication - Basic auth credentials (both required if using basic auth)
ARCHESTRA_OTEL_EXPORTER_OTLP_AUTH_USERNAME=""
ARCHESTRA_OTEL_EXPORTER_OTLP_AUTH_PASSWORD=""
# OTEL Authentication - Bearer token (takes precedence over basic auth if provided)
ARCHESTRA_OTEL_EXPORTER_OTLP_AUTH_BEARER=""
# Prompt/completion/tool content on trace spans. Defaults to true — unless
# content encryption at rest (ARCHESTRA_CONTENT_ENCRYPTION_SECRET) is
# configured, which flips the default to false. An explicit true always wins
# and logs a startup warning under encryption.
# ARCHESTRA_OTEL_CAPTURE_CONTENT=true

# RUM (Real User Monitoring) — product-usage events from the web UI, exported
# as OTLP log records. Setting the endpoint turns the feature on; unset = off.
# ARCHESTRA_RUM_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# RUM export authentication - Basic auth credentials (both required if using basic auth)
# ARCHESTRA_RUM_EXPORTER_OTLP_AUTH_USERNAME=""
# ARCHESTRA_RUM_EXPORTER_OTLP_AUTH_PASSWORD=""
# RUM export authentication - Bearer token (takes precedence over basic auth if provided)
# ARCHESTRA_RUM_EXPORTER_OTLP_AUTH_BEARER=""
# Fraction of RUM sessions to record, 0-1 (default 1 = all; errors always reported)
# ARCHESTRA_RUM_SAMPLE_RATE=1
# RUM OTLP batch tuning for large deployments (defaults 2048 / 512 / 5000)
# ARCHESTRA_RUM_EXPORTER_MAX_QUEUE_SIZE=2048
# ARCHESTRA_RUM_EXPORTER_MAX_EXPORT_BATCH_SIZE=512
# ARCHESTRA_RUM_EXPORTER_SCHEDULE_DELAY_MS=5000
# Per-user ceiling on RUM event batches accepted per minute (default 120)
# ARCHESTRA_RUM_INGEST_MAX_BATCHES_PER_MINUTE=120

# TCP port for the metrics server (defaults to 9050). Override if the default port collides with another local service.
# ARCHESTRA_METRICS_PORT=9050

# Bearer token for /metrics endpoint (port 9050). If set, update dev/prometheus.yml with matching token.
ARCHESTRA_METRICS_SECRET=""

# How often (ms) to recompute the `llm_active_users` gauge. Set to 0 to disable
# collection; values below 30000 are raised to that floor. Defaults to 300000 (5 min).
# ARCHESTRA_METRICS_ACTIVE_USERS_REFRESH_INTERVAL_MS=300000

# Sentry Configuration
# Sentry DSN for backend error tracking (leave empty to disable)
ARCHESTRA_SENTRY_BACKEND_DSN=""
# Environment identifier for Sentry
ARCHESTRA_SENTRY_ENVIRONMENT=""
# Sentry DSN for frontend error tracking (leave empty to disable)
NEXT_PUBLIC_ARCHESTRA_SENTRY_FRONTEND_DSN=""

# How many days a finished A2A task is kept before it is deleted along with its
# artifacts and stream events. Its messages are detached first, so conversation
# history is never affected. 0 keeps tasks forever. Default: 90
ARCHESTRA_A2A_TASK_RETENTION_DAYS=90

# External API Base URL - Public URL for connecting to LLM Proxy, MCP Gateway, and A2A Gateway from outside the cluster
# Shown in UI connection instructions, and used as the public origin the owned-app
# SDK/stylesheet are injected from (the first https:// entry wins). When unset, that
# app-asset origin falls back to ARCHESTRA_FRONTEND_URL, which works over a tunnel
# or ingress as long as the frontend URL is public.
# Set this explicitly for foreign-host (MCP-UI) rendering so self-contained asset URLs resolve.
# Supports comma-separated list for multiple URLs (e.g., internal K8s URL, external ingress)
# Example single: https://api.archestra.com
# Example multiple: http://archestra.default.svc:9000,https://api.archestra.example.com
ARCHESTRA_API_BASE_URL=

# Optional, defaults to "http://127.0.0.1:9000". Internal URL where the frontend connects to the backend API server.
# Addressed by IPv4 literal rather than `localhost`: the API binds IPv4 only, and `localhost` resolves to ::1 first.
ARCHESTRA_INTERNAL_API_BASE_URL="http://127.0.0.1:9000"

# Optional dedicated port for the publicly-exposable endpoints — currently the
# MS Teams incoming webhook (/api/webhooks/chatops/ms-teams). Same handler as
# the main API port — an alias, so a firewall can expose only these endpoints
# publicly without exposing the whole API. The main API port keeps serving
# them either way.
# ARCHESTRA_PUBLIC_ENDPOINTS_PORT=

# Optional. Trust the X-Forwarded-* headers set by a proxy in front of Archestra.
# Set it behind a TLS-terminating reverse proxy or load balancer: OAuth metadata
# and auth URLs then use the external https:// scheme, and each request resolves
# to the calling client's IP instead of the proxy's — so per-IP rate limits and
# audit sourceIp stay per-client rather than collapsing onto one shared address.
# Values: true, false, or a comma-separated list of trusted proxy IPs/CIDRs.
# Prefer the list: "true" trusts a client-supplied X-Forwarded-For, letting a
# caller pick the IP it is rate-limited and audited under. This setting does not
# affect the OAuth public origin — a forwarded host is always checked against
# ARCHESTRA_API_BASE_URL and ARCHESTRA_FRONTEND_URL.
# ARCHESTRA_TRUST_PROXY=false

# Optional, defaults to 620000 (620s). How long each HTTP server (the API and the
# Next.js server) holds an idle keep-alive connection open before closing it.
# Raise-only knob: it must stay ABOVE the keep-alive timeout of every proxy or
# load balancer in front of Archestra, or that proxy can reuse a connection the
# server is closing at that instant and the request dies in transit — an
# intermittent, retry-able failure that looks like a flaky network. The default
# clears the strictest common case (Google Cloud's external Application Load
# Balancer holds backend connections for a fixed, non-configurable 600s).
# Lower it only when nothing pools connections to Archestra. Must be digits only,
# a whole number of milliseconds: "620s", "620_000", "6.2e5" and "0x1" are all
# rejected (with a warning) rather than read as the digits they start with or as
# the number they happen to evaluate to.
# ARCHESTRA_HTTP_KEEP_ALIVE_TIMEOUT_MS=620000

# Optional for local dev
# Frontend URL - The URL where users access the frontend
ARCHESTRA_FRONTEND_URL=http://localhost:3000

# Optional. Scopes the session cookie to a domain so the frontend and backend
# can share it. Set only when they are on different subdomains; use the
# narrowest domain covering both, e.g. "example.com" for frontend.example.com +
# backend.example.com. The cookie then reaches EVERY subdomain of that domain.
# WARNING: if another Archestra runs on a sibling subdomain and both use the
# default ARCHESTRA_AUTH_COOKIE_PREFIX, their session cookies collide and login
# silently bounces back to sign-in. Give each instance a unique prefix (below).
ARCHESTRA_AUTH_COOKIE_DOMAIN=""

# Next.js dev bundler ("turbopack" or "webpack"). Tilt defaults local dev to
# Turbopack; set "webpack" to opt out (e.g. if you hit the @next/swc-darwin-arm64
# IOAccelerator memory leak on macOS arm64, vercel/next.js#92055). Outside Tilt,
# `pnpm dev` auto-selects per platform — see frontend/scripts/dev.mjs.
# ARCHESTRA_DEV_BUNDLER=turbopack

# Cookie name prefix for auth cookies (default "archestra"). Give each instance
# that shares a host or domain with another a unique value, so their session
# cookies have distinct names and never collide. Two cases need this: stacks on
# different localhost ports (browsers ignore the port), and stacks on sibling
# subdomains where one sets ARCHESTRA_AUTH_COOKIE_DOMAIN (the cookie leaks across
# the whole domain). scripts/dev-stack.sh sets this automatically for parallel
# stacks.
# ARCHESTRA_AUTH_COOKIE_PREFIX="archestra"

# Analytics configuration for PostHog. Governs frontend product analytics +
# session replay, backend instance heartbeats, and backend error tracking
# (5xx exceptions + preceding logs sent to PostHog Error Tracking).
# Set to "disabled" to turn all of it off, or "enabled" to force it on.
# Unset, it is enabled only when NODE_ENV is "production" (the released Docker
# images), so local dev/test runs never report analytics or errors.
ARCHESTRA_ANALYTICS=
# Optional: override the PostHog project key / host (defaults target Archestra's
# own PostHog instance). Point these at your own instance to self-host analytics.
ARCHESTRA_ANALYTICS_POSTHOG_KEY=
ARCHESTRA_ANALYTICS_POSTHOG_HOST=

# Auth
# IMPORTANT: Set the secrets below to secure, random values in production.
# Example: openssl rand -base64 32
#
# ARCHESTRA_AUTH_SECRET is the legacy combined secret: it signs sessions AND
# derives the key that encrypts stored secrets. It still works on its own.
# To rotate the two concerns independently, set the two dedicated secrets
# below instead; each falls back to ARCHESTRA_AUTH_SECRET when unset.
#
#   ARCHESTRA_AUTH_SESSION_SECRET       — signs sessions/cookies (better-auth)
#   ARCHESTRA_SECRETS_ENCRYPTION_SECRET — derives the stored-secret AES key
#
# Changing the session secret logs everyone out. Changing the encryption secret
# re-encrypts stored secrets on the next startup, with the previous secret still
# available (ARCHESTRA_SECRETS_ENCRYPTION_SECRET_PREVIOUS) — see below.
# "better-auth-secret-12345678901234567890" is better-auth's default when unset.
ARCHESTRA_AUTH_SECRET=better-auth-secret-12345678901234567890
# ARCHESTRA_AUTH_SESSION_SECRET=
# ARCHESTRA_SECRETS_ENCRYPTION_SECRET=
ARCHESTRA_AUTH_ADMIN_EMAIL=admin@example.com
ARCHESTRA_AUTH_ADMIN_PASSWORD=password

# Developer-only: skip the login screen by minting a real session for this user
# when the app loads unauthenticated. Ignored in production (NODE_ENV=production/prod).
# The session is an ordinary one for that user; RBAC is unchanged. Unset to disable.
# ARCHESTRA_AUTH_DEV_AUTO_AUTHENTICATE_EMAIL=admin@example.com

# Feature Flags
# FEATURES_XYZ_ENABLED=false

# Kubernetes Configuration for MCP Server Runtime

# Whether to load kubeconfig from current cluster (set to "true" when running inside K8s)
ARCHESTRA_ORCHESTRATOR_LOAD_KUBECONFIG_FROM_CURRENT_CLUSTER=false
# Path to kubeconfig file (optional if running inside K8s cluster or using default ~/.kube/config)
ARCHESTRA_ORCHESTRATOR_KUBECONFIG=
# Kubernetes namespace for MCP server pods (defaults to "default")
ARCHESTRA_ORCHESTRATOR_K8S_NAMESPACE=default
# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2026 Archestra Inc.
# SPDX-License-Identifier: LicenseRef-Archestra-Enterprise
# The Helm release this platform was installed as. The chart injects it; set it
# by hand only for a non-Helm deployment. Cluster objects the platform creates
# for itself rather than through the chart — today the MCP image pre-pull
# DaemonSet — are named after it, so two releases sharing a namespace never
# fight over one object. Unset (or not a valid Helm release name: lowercase
# alphanumerics and "-", at most 53 characters) means those objects are simply
# not created, never created under a guessed name.
# ARCHESTRA_ORCHESTRATOR_HELM_RELEASE_NAME=
# SPDX-SnippetEnd
# Comma-separated namespaces the platform ServiceAccount is granted RBAC in
# (mirrors the Helm chart's rbac.environmentNamespaces). Surfaced to the UI so the
# environment editor offers a namespace dropdown instead of free text. Empty = free text.
ARCHESTRA_ORCHESTRATOR_ENVIRONMENT_NAMESPACES=
# Base image for MCP server containers
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_BASE_IMAGE=europe-west1-docker.pkg.dev/friendly-path-465518-r6/archestra-public/mcp-server-base:1.0.33
# Resource requests/limits for generated MCP server containers (K8s quantities).
# Ephemeral-storage governance keeps the scheduler disk-aware and prevents
# DiskPressure eviction cascades. Invalid values fall back to the defaults shown.
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_CPU_REQUEST=50m
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_MEMORY_REQUEST=128Mi
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_MEMORY_LIMIT=512Mi
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_EPHEMERAL_STORAGE_REQUEST=256Mi
# ARCHESTRA_ORCHESTRATOR_MCP_SERVER_EPHEMERAL_STORAGE_LIMIT=1Gi
# How often (seconds) to garbage-collect Failed/Evicted MCP server pods left
# behind by node-pressure evictions. 0 disables the reaper. Defaults to 600.
# ARCHESTRA_ORCHESTRATOR_FAILED_POD_REAP_INTERVAL_SECONDS=600
# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2026 Archestra Inc.
# SPDX-License-Identifier: LicenseRef-Archestra-Enterprise
# BETA: idle hibernation for self-hosted MCP servers (scale-to-zero) ships off
# by default. Blank falls back to the ARCHESTRA_BETA master switch (see
# betaFeatureEnabled); an explicit "false" keeps it off even with the master
# switch on. Enterprise feature: an organization still opts in under
# Settings > MCP, behind the licence.
# ARCHESTRA_ORCHESTRATOR_MCP_IDLE_HIBERNATION_ENABLED=false
# Idle threshold (seconds) after which unused MCP server pods are hibernated.
# This variable only configures the operator's side of the feature. Setting it
# to exactly 0 is a hard kill switch that disables hibernation platform-wide,
# whatever the organization has enabled. Any other value sets the idle window
# (default 1800, floored at 120 so servers can't be hibernated between normal
# consecutive tool calls).
# ARCHESTRA_ORCHESTRATOR_MCP_IDLE_HIBERNATION_SECONDS=1800
# Pre-pull MCP server images onto every node with a DaemonSet, so a hibernated
# server wakes from the node's cache instead of the container registry. Runs only
# while idle hibernation runs; this is the kill switch for the extra per-node pod
# alone, so an explicit "false" stops pre-pulling and leaves hibernation on.
# Defaults to true.
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_ENABLED=true
# PriorityClass for the pre-pull DaemonSet's pods. Unset uses the namespace
# default; point it at a low or negative-priority class so warming a cache can
# never preempt a real workload.
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_PRIORITY_CLASS_NAME=
# Footprint of the pre-pull DaemonSet's containers. Paid on every node, so the
# defaults are deliberately tiny — big enough to schedule, small enough not to
# distort packing.
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_CPU_REQUEST=10m
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_MEMORY_REQUEST=16Mi
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_MEMORY_LIMIT=64Mi
# Image for the pre-pull DaemonSet's own containers (the noop bootstrap and the
# keepalive) — the official busybox by default, deliberately independent of the
# MCP server base image, whose contents are an operator's choice. Point it at
# your mirror on clusters that cannot pull from Docker Hub.
# ARCHESTRA_ORCHESTRATOR_MCP_IMAGE_PREPULL_BOOTSTRAP_IMAGE=docker.io/library/busybox:1.36-musl
# Helm sets this to a dedicated Role in each MCP runtime namespace for cleanup.
# ARCHESTRA_ORCHESTRATOR_MCP_RUNTIME_OWNER_ROLE=
# SPDX-SnippetEnd

# Instance-wide banner (markdown) shown at the top of the UI, including the login
# screen. Dismissable per message. Does not affect request handling — for taking
# the instance down use ARCHESTRA_MAINTENANCE_MODE_MESSAGE instead.
# ARCHESTRA_SITE_NOTIFICATION_MESSAGE="Staging instance — data may be wiped"

# Puts the backend into maintenance mode: only maintenance routes are served and
# the UI shows a full-screen overlay with this message.
# ARCHESTRA_MAINTENANCE_MODE_MESSAGE="Scheduled maintenance until 15:00 UTC"

# Logging
ARCHESTRA_LOGGING_LEVEL=info
# Console log format: "json" (default, machine-readable) or "pretty" (human-readable, colorized).
ARCHESTRA_LOGGING_FORMAT=json
ARCHESTRA_BROWSER_STREAM_LOG_SCREENSHOTS=false
ARCHESTRA_BROWSER_STREAM_LOG_TAB_SYNC=false


# Enterprise license toggle
ARCHESTRA_ENTERPRISE_LICENSE_ACTIVATED=false
# Knowledge Base team-scoped connectors (requires core enterprise license above)
ARCHESTRA_ENTERPRISE_LICENSE_KNOWLEDGE_BASE_ACTIVATED=false
# Full white-labeling: removes "Powered by Archestra" branding and community links
ARCHESTRA_ENTERPRISE_LICENSE_FULL_WHITE_LABELING=false

# Disable email/password login
ARCHESTRA_AUTH_DISABLE_BASIC_AUTH=false

# Disable user invitations (hides invitation UI and blocks invitation API endpoints)
ARCHESTRA_AUTH_DISABLE_INVITATIONS=false

# OAuth Dynamic Client Registration (DCR, RFC 7591) and CIMD auto-registration.
# Enabled by default. Set to false to allow only pre-registered OAuth clients
# (e.g. manually registered MCP OAuth clients) to run OAuth flows.
ARCHESTRA_AUTH_DCR_ENABLED=true

# OAuth refresh-token replay grace window, in seconds (default 60). A replayed
# (already-rotated) refresh token revoked within this window is treated as a
# benign rotation race — e.g. a client whose token-exchange response was lost on
# a backend restart and retried — and re-issued instead of triggering reuse
# invalidation. Set to 0 to disable the grace and treat every replay as reuse.
# ARCHESTRA_AUTH_REFRESH_TOKEN_REUSE_GRACE_SECONDS=60

# SSO Trusted Origins - JSON array of additional trusted origins for SSO authentication
# Required for SAML SSO: browsers send Origin: null for cross-origin form POSTs
# Example: '["null"]' for SAML, or '["null", "https://idp.example.com"]' for multiple origins
ARCHESTRA_AUTH_SSO_TRUSTED_ORIGINS=

# Secrets Manager Configuration
# ARCHESTRA_SECRETS_MANAGER: "DB" (default), "Vault", or "READONLY_VAULT"
# - DB: Stores secrets directly in PostgreSQL database
# - Vault: Stores secrets in HashiCorp Vault (requires enterprise license)
# - READONLY_VAULT: Allows teams to use external Vault folders for secrets (requires enterprise license)
ARCHESTRA_SECRETS_MANAGER=DB

# Rotating the encryption secret: set ARCHESTRA_SECRETS_ENCRYPTION_SECRET to the
# NEW value, set ARCHESTRA_SECRETS_ENCRYPTION_SECRET_PREVIOUS to the OLD value,
# then restart — the app re-encrypts stored secrets on startup (or run it
# explicitly with backend `db:reencrypt-secrets`). It decrypts each stored
# secret with the previous key and re-encrypts with the new one; then drop the
# previous var.
# When unset, _PREVIOUS falls back to ARCHESTRA_AUTH_SECRET (the pre-split key).
# ARCHESTRA_SECRETS_ENCRYPTION_SECRET_PREVIOUS=

# One-boot escape hatch for a deliberate encryption-secret rotation done WITHOUT
# the re-encryption migration. Startup aborts when the current encryption secret
# cannot decrypt previously stored secrets; set this to true for one boot to
# accept the new key (old secrets stay unreadable and must be re-entered).
# ARCHESTRA_SECRETS_ACCEPT_NEW_ENCRYPTION_KEY=true

# Content Encryption at Rest (enterprise license required)
# Encrypts LLM interaction payloads and chat message content in the database
# with a key SEPARATE from the stored-secrets key. Unset = disabled. Existing
# rows are encrypted by a background sweep after enabling. Startup fails if
# set without an enterprise license, and — deliberately, with no override —
# if the key no longer matches previously encrypted content.
# ARCHESTRA_CONTENT_ENCRYPTION_SECRET=
# Additional decrypt-only key. Used for rotation (set to the OLD key while
# the sweep re-encrypts under the new one) and for safe rolling enablement
# (distribute the key as decrypt-capable to every replica first, then move it
# to ARCHESTRA_CONTENT_ENCRYPTION_SECRET).
# ARCHESTRA_CONTENT_ENCRYPTION_SECRET_PREVIOUS=

# Locked chats: conversations, and the audit records they produce,
# encrypted under a browser-held per-conversation key the server never
# stores. Setting the escrow key below is what enables the feature; unset,
# locked chats are unavailable. Escrow is required because the audit
# trail is encrypted too — without an escrowed key nobody could read it.
# The value is the RSA public key (PEM, or base64 of the PEM; >= 2048 bits);
# the private key stays offline with your security team. Startup fails if
# the key is invalid.
# ARCHESTRA_LOCKED_CHAT_ESCROW_PUBLIC_KEY=

# HashiCorp Vault Configuration (required when ARCHESTRA_SECRETS_MANAGER=Vault)
ARCHESTRA_HASHICORP_VAULT_ADDR=http://localhost:8200
# Authentication method: "TOKEN" (default), "K8S", or "AWS"
ARCHESTRA_HASHICORP_VAULT_AUTH_METHOD=TOKEN

# Vault Token Authentication (ARCHESTRA_HASHICORP_VAULT_AUTH_METHOD=TOKEN)
ARCHESTRA_HASHICORP_VAULT_TOKEN=dev-root-token

# Vault Kubernetes Authentication (ARCHESTRA_HASHICORP_VAULT_AUTH_METHOD=K8S)
# Role bound to the K8s service account (required for K8S auth)
ARCHESTRA_HASHICORP_VAULT_K8S_ROLE=
# Path to service account token (default: /var/run/secrets/kubernetes.io/serviceaccount/token)
ARCHESTRA_HASHICORP_VAULT_K8S_TOKEN_PATH=
# Vault K8s auth mount point (default: kubernetes)
ARCHESTRA_HASHICORP_VAULT_K8S_MOUNT_POINT=

# Vault AWS IAM Authentication (ARCHESTRA_HASHICORP_VAULT_AUTH_METHOD=AWS)
# Role bound to the AWS IAM principal (required for AWS auth)
ARCHESTRA_HASHICORP_VAULT_AWS_ROLE=
# Vault AWS auth mount point (default: aws)
ARCHESTRA_HASHICORP_VAULT_AWS_MOUNT_POINT=
# AWS region for STS signing (default: us-east-1)
ARCHESTRA_HASHICORP_VAULT_AWS_REGION=
# STS endpoint URL (default: https://sts.amazonaws.com)
ARCHESTRA_HASHICORP_VAULT_AWS_STS_ENDPOINT=
# Value for X-Vault-AWS-IAM-Server-ID header (optional, additional security)
ARCHESTRA_HASHICORP_VAULT_AWS_IAM_SERVER_ID=

# Incoming Email Configuration
# Allows external users to invoke agents by sending emails
# See docs: /docs/platform-agents#incoming-email
# Provider: "outlook" (or leave empty to disable)
ARCHESTRA_AGENTS_INCOMING_EMAIL_PROVIDER=
# Azure AD tenant ID for Microsoft Graph API
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_TENANT_ID=
# Azure AD application (client) ID
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_CLIENT_ID=
# Azure AD application client secret (keep secure)
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_CLIENT_SECRET=
# Email address of the mailbox to monitor (e.g., agents@yourcompany.com)
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_MAILBOX_ADDRESS=
# Override email domain for agent addresses (optional, defaults to mailbox domain)
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_EMAIL_DOMAIN=
# Public webhook URL for Microsoft Graph notifications (optional)
# If set, subscription is created automatically on server startup
ARCHESTRA_AGENTS_INCOMING_EMAIL_OUTLOOK_WEBHOOK_URL=

# Beta master switch
# Fallback for per-feature ARCHESTRA_*_ENABLED gates (see betaFeatureEnabled).
# Its product effects today: selecting the beta Connect and MCP Registry page
# variants (/connection_beta, /mcp/registry/beta), publishing Agent Skills over
# the MCP gateway, and per-feature gates left blank below.
ARCHESTRA_BETA=

# BETA: both directions of the draft MCP Skills extension (SEP-2640). Publishes
# local Skills through gateways and discovers external Skills alongside tools.
# Blank falls back to ARCHESTRA_BETA; explicit false wins over the master switch.
# ARCHESTRA_MCP_SKILLS_ENABLED=false

# BETA: MCP Registry attention facets, diagnostics and per-viewer dismissals.
# Off by default. Blank falls back to ARCHESTRA_BETA.
# ARCHESTRA_MCP_SERVER_ALERTING_ENABLED=false

# BETA: manage opaque plugins and deliver them through connection
# marketplaces. Blank follows ARCHESTRA_BETA; explicit false keeps it off.
ARCHESTRA_PLUGINS_ENABLED=

# Background execution runs delegated Agent tasks in dedicated Kubernetes pods.
# Independent of ARCHESTRA_BETA because a run can hold personal credentials.
# Also requires the Kubernetes runtime (ARCHESTRA_ORCHESTRATOR_*).
ARCHESTRA_AGENT_BACKGROUND_EXECUTION_ENABLED=false
# Default image prefilled when Background execution is enabled on an Agent.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_BASE_IMAGE=europe-west1-docker.pkg.dev/friendly-path-465518-r6/archestra-public/agent-archestra:latest
# Optional. Allows Agent administrators to configure privileged background
# pods. Disabled by default because privileged containers have node-level access.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_ALLOW_PRIVILEGED=false
# Fallback lifetime cap and idle stop for Agents that set neither.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_DEFAULT_TTL_HOURS=72
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_DEFAULT_IDLE_TIMEOUT_MINUTES=180
# Per-run pod resources. No CPU limit by default: throttling an agent
# mid-turn surfaces as confusing timeouts rather than back-pressure.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_CPU_REQUEST=500m
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_MEMORY_REQUEST=1Gi
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_MEMORY_LIMIT=4Gi
# Maximum writable emptyDir storage available to one execution.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_EPHEMERAL_STORAGE_LIMIT=10Gi
# Base URL a background pod uses to reach the LLM proxy and MCP gateway. Must be
# reachable from inside the cluster; defaults to ARCHESTRA_INTERNAL_API_BASE_URL.
# With neither set, starting a run fails loudly rather than letting an agent
# run outside the proxy's observability.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_PLATFORM_BASE_URL=
# Label selector matching the platform's own API pods, as key=value pairs.
# Background pods get an egress policy allowing exactly that destination.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_PLATFORM_POD_SELECTOR=archestra.io/p4-shim-client=true
# How often the reconciler syncs run state and applies TTL/idle stops.
# ARCHESTRA_AGENT_BACKGROUND_EXECUTION_RECONCILE_INTERVAL_SECONDS=30

# Persistent "My Files" byte storage backend: "db" (Postgres bytea, default) or
# "filesystem" (a mounted volume / PVC). Both are co-equal; the active provider
# is used for new writes while reads dispatch per stored row.
ARCHESTRA_FILE_STORAGE_PROVIDER=db
# Absolute root directory for the filesystem provider (e.g. a PVC mount).
# Required when ARCHESTRA_FILE_STORAGE_PROVIDER=filesystem.
ARCHESTRA_FILE_STORAGE_FILESYSTEM_ROOT=
# S3-compatible object storage (used when ARCHESTRA_FILE_STORAGE_PROVIDER=s3).
# Setting the provider to s3 also brings up a local MinIO via Tilt.
ARCHESTRA_FILE_STORAGE_S3_BUCKET=
ARCHESTRA_FILE_STORAGE_S3_REGION=us-east-1
# Custom endpoint for S3-compatible stores (MinIO, R2). Leave blank for AWS S3.
ARCHESTRA_FILE_STORAGE_S3_ENDPOINT=
# Required true for MinIO (path-style addressing); false/blank for AWS S3.
# Defaults to false.
ARCHESTRA_FILE_STORAGE_S3_FORCE_PATH_STYLE=
# Static credentials. Leave blank to use the AWS default chain (IAM role / IRSA).
ARCHESTRA_FILE_STORAGE_S3_ACCESS_KEY_ID=
ARCHESTRA_FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# Optional key prefix to share one bucket across instances.
ARCHESTRA_FILE_STORAGE_S3_KEY_PREFIX=

# Path to the `git` binary. The public marketplace endpoint shells out to
# `git http-backend` (CGI) — must be present in the deployment image.
# ARCHESTRA_GIT_BINARY_PATH=git
# Directory holding materialized marketplace git repos. Pure cache: the
# authoritative history lives in the `skill_share_link_revision` table and
# replays are byte-identical, so wiping is safe. In prod, point this at a
# persistent volume so reboots don't trigger an unnecessary rebuild.
# Defaults to `~/.archestra/skill-marketplace-cache`.
# ARCHESTRA_SKILL_MARKETPLACE_CACHE_DIR=

# Slack integration configuration
# "true" to enable integration
ARCHESTRA_CHATOPS_SLACK_ENABLED=
# Connection mode: "socket" (default, no public URL needed) or "webhook" (requires public URL)
ARCHESTRA_CHATOPS_SLACK_CONNECTION_MODE=
# Bot User OAuth Token (xoxb-...)
ARCHESTRA_CHATOPS_SLACK_BOT_TOKEN=
# Signing Secret (required for webhook mode)
ARCHESTRA_CHATOPS_SLACK_SIGNING_SECRET=
# Slack App ID
ARCHESTRA_CHATOPS_SLACK_APP_ID=
# App-Level Token (required for socket mode, xapp-...)
ARCHESTRA_CHATOPS_SLACK_APP_LEVEL_TOKEN=
# MS Teams integration configuration
# "true" to enable integration
ARCHESTRA_CHATOPS_MS_TEAMS_ENABLED=
# Your Microsoft App ID
ARCHESTRA_CHATOPS_MS_TEAMS_APP_ID=
# Client Secret
ARCHESTRA_CHATOPS_MS_TEAMS_APP_SECRET=
# Azure AD Tenant ID
ARCHESTRA_CHATOPS_MS_TEAMS_TENANT_ID=

# Optional - for thread history (requires Graph API permissions)
# Falls back to Bot credentials above if not set (works when using same App Registration)
# Only set these if you need separate credentials for Graph API
# ARCHESTRA_CHATOPS_MS_TEAMS_GRAPH_TENANT_ID=
# ARCHESTRA_CHATOPS_MS_TEAMS_GRAPH_CLIENT_ID=
# ARCHESTRA_CHATOPS_MS_TEAMS_GRAPH_CLIENT_SECRET=

# Telegram integration configuration
# On by default. Set to "false" to disable the Telegram messaging channel
# (UI + provider); it is then hidden entirely and the provider never starts.
ARCHESTRA_CHATOPS_TELEGRAM_ENABLED=
# Bot token from @BotFather (123456789:ABC...). Telegram uses long polling —
# no public URL, signing secret, or ngrok needed.
ARCHESTRA_CHATOPS_TELEGRAM_BOT_TOKEN=

# Per-process cap on concurrent chatops file downloads + image shrinking (default 4)
# ARCHESTRA_CHATOPS_MAX_CONCURRENT_FILE_TRANSFERS=

# Welcome message for auto-provisioned chatops users (Slack/MS Teams). On by
# default; carries a finish-signup link (or a sign-in link when SSO is
# configured). Set to "false" to skip the welcome entirely for deployments
# whose chatops users don't get web app access.
# ARCHESTRA_CHATOPS_SIGNUP_WELCOME_ENABLED=

# ngrok tunnel - makes this instance reachable from the Internet for inbound
# chatops webhooks (MS Teams, Slack). When set, the backend brings up the tunnel
# in-process via the ngrok agent SDK. Get a token at
# https://dashboard.ngrok.com/get-started/your-authtoken
# ARCHESTRA_NGROK_AUTH_TOKEN=
# Optional reserved domain for a stable public URL across restarts (without it,
# ngrok assigns an ephemeral domain that rotates on each restart)
# ARCHESTRA_NGROK_DOMAIN=

# Knowledge Base Configuration
# Max wall-clock time a single connector sync run works before it checkpoints and
# yields; a continuation resumes from the checkpoint. Bounds how long one run
# holds a worker and chunks large syncs into resumable pieces (stops at ~90%, so
# 3300 = ~49m of work per run). Set 0 to disable (run to completion in one pass).
# ARCHESTRA_KNOWLEDGE_BASE_CONNECTOR_SYNC_MAX_DURATION_SECONDS=3300
# Max textless pages of one PDF the Document OCR pass transcribes (one metered
# vision-model call per page; pages past the cap stay untranscribed with a warning).
# ARCHESTRA_KNOWLEDGE_BASE_OCR_MAX_PAGES_PER_DOCUMENT=100
# Connector sync run liveness lease (seconds). The owning worker renews it while
# a run is in progress (ingest + embedding drain); a run whose lease is not
# renewed within this window is treated as crashed and reclaimed. Must be several
# times the heartbeat interval so a missed beat doesn't falsely expire a live run.
# ARCHESTRA_KNOWLEDGE_BASE_CONNECTOR_RUN_LEASE_TTL_SECONDS=300
# How often the owning worker renews the lease.
# ARCHESTRA_KNOWLEDGE_BASE_CONNECTOR_RUN_HEARTBEAT_INTERVAL_SECONDS=90
# How long a document may sit un-embedded (pending/processing) before the recovery
# sweep re-enqueues it — i.e. the worst-case wait to recover a stalled/failed
# embedding. Must stay above a batch_embedding task's full retry span (~8 min) so a
# slow-but-live batch is never reset out from under its worker.
# ARCHESTRA_KNOWLEDGE_BASE_STALLED_EMBEDDING_AGE_SECONDS=900
# Knowledge-base keyword ranking is BM25, computed in plain SQL from statistics
# tables (no extension, no extra index; works on managed PostgreSQL such as RDS,
# Aurora, Neon, Cloud SQL). The two factors below are deployment defaults; an
# organization can override them under Settings > Knowledge > Search Ranking
# Configuration. Both are the Lucene/Elasticsearch defaults.
# Term Saturation (k1): how much repeating a word keeps helping a
# passage. Higher lets repetition keep adding weight; 0 counts a word the same
# whether it appears once or fifty times. 0–10.
# ARCHESTRA_KNOWLEDGE_BASE_BM25_K1=1.2
# Length Normalization (b): how much long passages are held back, 0
# (length does not matter) to 1 (short, focused passages pull well ahead).
# ARCHESTRA_KNOWLEDGE_BASE_BM25_B=0.75
# How many candidate chunks BM25 rescores per query. BM25 ranks, it does not
# index: the existing GIN index finds candidates and this bounds how many are
# scored. Raising it costs latency (roughly linear) and buys fidelity on queries
# that match more chunks than the cap.
# ARCHESTRA_KNOWLEDGE_BASE_BM25_RECALL_CAP=2000
# How often the BM25 corpus statistics are rebuilt. A read-only scan of
# kb_chunks, so its cost grows with the corpus. Stale statistics shift scores
# slightly rather than making them wrong, so a long interval is safe.
# ARCHESTRA_KNOWLEDGE_BASE_BM25_STATS_REFRESH_INTERVAL_SECONDS=3600
# Development override for where the M-Files VAF Add On install script gets the
# add-on: a git ref of archestra-ai/archestra (pushed commit SHA, branch, or tag)
# to compile from that source, or `local` for this backend checkout's HEAD
# commit. Leave unset in production (the script then uses the release matching
# the platform version).
# ARCHESTRA_KNOWLEDGE_BASE_MFILES_VAF_ADD_ON_SOURCE_REF=
# GitHub token used to fetch the source ref's CI-built add-on package (GitHub
# requires auth for Actions artifact downloads even on public repos). Only read
# when the source-ref override is set; without it the script compiles from
# source. The backend proxies the package — the token never reaches clients.
# ARCHESTRA_KNOWLEDGE_BASE_MFILES_VAF_ADD_ON_GITHUB_TOKEN=
# Enable or disable hybrid search (vector + full-text with RRF).
# ARCHESTRA_KNOWLEDGE_BASE_HYBRID_SEARCH_ENABLED=true
# Per-statement timeout (ms) for the knowledge search lanes (vector + keyword),
# tighter than the pool-wide statement timeout. A lane that exceeds it is dropped
# and the remaining lanes' results are merged; only when every lane times out does
# the query fail (with an actionable message). 0 inherits the pool-wide timeout.
# ARCHESTRA_KNOWLEDGE_BASE_SEARCH_STATEMENT_TIMEOUT_MILLIS=8000
# Verifiable citations: in the internal chat, check the verbatim quotes the model
# tags with a chunk ref against the returned chunks, logging + metering any quote
# that matches no chunk. Log-only (never blocks or alters the answer). Set to
# false to disable the feature (the model is no longer asked to quote).
# ARCHESTRA_KNOWLEDGE_BASE_QUOTE_VERIFICATION_ENABLED=true
# Token budget for one chunk, including its title prefix and metadata suffix.
# Applies at ingest only: existing chunks keep the size they were written at
# until their connector re-syncs. Clamped to 128..2048.
# ARCHESTRA_KNOWLEDGE_BASE_CHUNK_SIZE_TOKENS=512
# Token budget for one child chunk under multi-granularity indexing. Each
# passage is split again into children of this size and only the children are
# indexed; a hit resolves back to its passage. 0 disables it; any other value is
# clamped to 32..2048 and should be below the chunk size above.
# ARCHESTRA_KNOWLEDGE_BASE_CHILD_CHUNK_SIZE_TOKENS=0
# How many neighbouring chunks either side of a search hit are stitched back on
# before the result is returned. Widens the passage the model reads without
# changing what ranks. 0 disables it. Clamped to 0..4.
# ARCHESTRA_KNOWLEDGE_BASE_CONTEXT_EXPANSION_RADIUS=1
# Default contextual retrieval mode for organizations without a saved choice.
# true selects per-document context; false disables context. Administrators can
# also choose per-passage context under Settings > Knowledge for higher recall.
# ARCHESTRA_KNOWLEDGE_BASE_CONTEXTUAL_RETRIEVAL_ENABLED=false
# Permission-sync (auto-sync-permissions connectors) — runs in a runtime-isolated
# lane, independent of content ingestion. The sync interval is configured per
# connector in the UI, not via env.
# BETA: the auto-sync-permissions feature (visibility option, permission passes,
# Users and Groups tabs, member overrides) ships off by default. Blank falls back
# to the ARCHESTRA_BETA master switch (see betaFeatureEnabled).
# ARCHESTRA_KNOWLEDGE_BASE_AUTO_SYNC_PERMISSIONS_ENABLED=false
# BETA: the M-Files connector (connector type, VAF Add On distribution endpoints)
# ships off by default. Blank falls back to the ARCHESTRA_BETA master switch.
# ARCHESTRA_KNOWLEDGE_BASE_MFILES_CONNECTOR_ENABLED=false
# Concurrency cap for the permission-sync worker lane (independent of the content
# lane's ARCHESTRA_KNOWLEDGE_BASE_TASK_WORKER_MAX_CONCURRENT).
# ARCHESTRA_KNOWLEDGE_BASE_PERMISSION_SYNC_WORKER_MAX_CONCURRENT=1
# Override for the p4 shim image (the in-cluster pod Perforce permission sync
# runs `p4` through). Defaults to the public p4-shim image matching the
# platform version.
# ARCHESTRA_KNOWLEDGE_BASE_PERFORCE_SHIM_IMAGE=
# Download URLs for the pinned `p4` CLI binary the backend fetches and pushes
# into the shim pod at provision time (the image ships no Perforce software).
# Defaults to the Perforce CDN r25.2 builds; air-gapped installs point these at
# an internal mirror.
# ARCHESTRA_KNOWLEDGE_BASE_PERFORCE_P4_URL_AMD64=https://cdist2.perforce.com/perforce/r25.2/bin.linux26x86_64/p4
# ARCHESTRA_KNOWLEDGE_BASE_PERFORCE_P4_URL_ARM64=https://cdist2.perforce.com/perforce/r25.2/bin.linux26aarch64/p4
# Expected sha256 of each downloaded `p4` binary; the download is rejected on
# mismatch. Must be updated together with the URL vars above.
# ARCHESTRA_KNOWLEDGE_BASE_PERFORCE_P4_SHA256_AMD64=ba4b931bd37a1fd073785c3194a608906934f62b52d407178121a8184bee8ae6
# ARCHESTRA_KNOWLEDGE_BASE_PERFORCE_P4_SHA256_ARM64=a67bcae67dd810fdc099525289457ab6af6f647f6e3aceadc0260f42d19cbc93

# Google OAuth client backing the Google Drive connector's individual
# ("connect my own Drive") auth mode. Create a Web application client in the
# Google Cloud Console, enable the Google Drive API on that project, and
# register this exact redirect URI on the client:
#   <your Archestra URL>/api/connectors/gdrive/oauth/callback
# The connector's setup UI shows the URI this deployment will actually send.
# Leaving these unset disables only that one mode — the service-account modes,
# domain-wide delegation included, need no deployment-level configuration.
# ARCHESTRA_KNOWLEDGE_BASE_GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# ARCHESTRA_KNOWLEDGE_BASE_GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=

# code execution runtime
# Gates the skill sandbox tools (archestra__run_command, upload_file,
# download_file) and skill mounts. "false" turns the sandbox off and wins over
# everything, including an explicit runner host. Otherwise the sandbox runs when
# a Dagger runner host is set (ARCHESTRA_CODE_RUNTIME_DAGGER_RUNNER_HOST below —
# the bring-your-own engine), or when this is "true" and the orchestrator
# (Kubernetes) is configured, in which case the backend provisions a Dagger
# engine per organization (and per environment) in-cluster.
ARCHESTRA_CODE_RUNTIME_ENABLED=false
# Optional explicit Dagger runner host (bring-your-own engine). When set it both
# enables the code sandbox and is used as the process-default engine, bypassing
# the in-code per-organization provisioning. Leave empty to use code-managed
# engines (the default). examples:
# kube-pod://my-dagger-engine-0?namespace=dagger&container=dagger-engine
# tcp://dagger-runtime.dagger.svc.cluster.local:1234
# In a Tilt dev stack, setting this points the backend at the engine you name
# instead of provisioning one — e.g. share one engine across worktrees:
# ARCHESTRA_CODE_RUNTIME_DAGGER_RUNNER_HOST=tcp://127.0.0.1:1234
# ARCHESTRA_CODE_RUNTIME_DAGGER_RUNNER_HOST=
# Override the sandbox runtime base image. Leave unset to use the built-in uv Python image.
# ARCHESTRA_DAGGER_RUNTIME_IMAGE=ghcr.io/astral-sh/uv:0.9.17-python3.12-bookworm-slim
# Code-managed engine resources (K8s quantity strings); run-backend-dev.sh sets
# smaller local values when unset. The memory limit bounds the buildkit daemon;
# what sandboxed code may allocate is capped separately by
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_SANDBOX_MEMORY_MAX below. That sandbox
# memory sits outside the pod's accounting and so is invisible to the scheduler,
# which is why the memory request has to reserve node capacity for both.
# Applied to NEWLY-created engines only — engine StatefulSets are created once
# and not resized on reconcile, so changing these needs an engine delete to take
# effect on an existing deployment.
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_CPU_REQUEST=2
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_MEMORY_REQUEST=6Gi
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_MEMORY_LIMIT=6Gi
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_CACHE_STORAGE=50Gi
# Ceiling on everything an engine's sandboxes hold at once. A run that exceeds
# it is killed; the engine and other runs are unaffected. Keep it below the
# engine memory request.
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_SANDBOX_MEMORY_MAX=5Gi
# Extra IPv4 CIDRs (comma-separated) to block from an unrestricted engine's
# public-egress floor, on top of the built-in RFC1918/link-local/metadata ranges.
# Set to the cluster's Service/Pod CIDRs when they fall outside RFC1918 (common on
# GKE/managed clusters) so sandboxed code can't reach in-cluster ClusterIP services.
# ARCHESTRA_DAGGER_RUNTIME_ENGINE_ADDITIONAL_DENIED_CIDRS=
# Set "true" when ARCHESTRA_DAGGER_RUNTIME_IMAGE points at a pre-baked sandbox
# base (the `sandbox_base/` image, which already contains the apt toolbelt + uv
# venv + deps). The runtime then skips the apt/uv build execs, so a restricted
# engine doesn't need ghcr.io/debian/pypi at run time — only the base registry.
# ARCHESTRA_CODE_RUNTIME_BASE_PREBUILT=false
# Per-command sandbox resource caps (defaults shown).
# ARCHESTRA_SKILLS_SANDBOX_CPU_LIMIT_SECONDS=30
# ARCHESTRA_SKILLS_SANDBOX_MEMORY_LIMIT_BYTES=1073741824
# ARCHESTRA_SKILLS_SANDBOX_WALL_CLOCK_SECONDS=120
# ARCHESTRA_SKILLS_SANDBOX_OUTPUT_BYTES_LIMIT=262144
# ARCHESTRA_SKILLS_SANDBOX_ARTIFACT_BYTES_LIMIT=52428800
# Shared Dagger session knobs (defaults shown). maxConcurrent/maxQueueLength
# bound in-flight + queued sandbox runs; cliBin overrides the Dagger CLI binary
# (falls back to ARCHESTRA_CODE_RUNTIME_DAGGER_CLI_BIN).
# ARCHESTRA_DAGGER_RUNTIME_MAX_CONCURRENT=10
# ARCHESTRA_DAGGER_RUNTIME_MAX_QUEUE_LENGTH=50
# ARCHESTRA_DAGGER_RUNTIME_CLI_BIN=

# Data Retention (enterprise license required)
# Automatic deletion of records after N days. All disabled (0) by default.
# Startup fails if any window is set without an enterprise license.
# LLM proxy request/response logs (interactions):
# ARCHESTRA_LLM_LOGS_RETENTION_DAYS=30
# MCP gateway tool-call logs:
# ARCHESTRA_MCP_LOGS_RETENTION_DAYS=30
# Chat conversations (by last message activity; messages, attachments, and
# conversation files are deleted with the conversation):
# ARCHESTRA_CHAT_CONVERSATIONS_RETENTION_DAYS=180
# Audit log records (administrative actions and auth events):
# ARCHESTRA_AUDIT_LOG_RETENTION_DAYS=180


# Quickstart mode
ARCHESTRA_QUICKSTART=false

# Client-side pre-send scan for secrets in the chat composer (regex + entropy).
# The composer asks for confirmation before sending messages that look like
# they contain secrets. Default on; set to "false" to disable.
ARCHESTRA_CHAT_SECRET_SCAN_ENABLED=true

# Upper bound on the output tokens an agent turn may generate. Each turn already
# uses the model's real output ceiling; this caps it for cost control. Default
# 32768. Lower it to constrain spend; raise it for models with larger outputs.
# ARCHESTRA_CHAT_MAX_OUTPUT_TOKENS=32768

# Output-token cap applied only to providers that charge a request's max_tokens
# reservation against a per-minute token bucket (currently Groq). Their entry
# tiers hand out buckets smaller than the default ceiling, so without this cap
# even a one-word message is rejected with a 413 before generating a token.
# Default 4096. Raise it on higher provider tiers to allow longer generations.
# ARCHESTRA_CHAT_RATE_METERED_MAX_OUTPUT_TOKENS=4096

# Largest single file a chat upload may store as a conversation attachment
# (Files panel). Default 52428800 (50 MiB). Files above the sandbox artifact
# limit skip sandbox staging but are still stored. Raise ARCHESTRA_API_BODY_LIMIT
# alongside this: uploads arrive base64-encoded (~4/3 the byte size) together
# with the conversation JSON.
# ARCHESTRA_CHAT_ATTACHMENT_STORAGE_BYTES_LIMIT=52428800

# Largest single attachment that may be embedded in a request to the LLM
# provider. Default 16777216 (16 MiB). Separate from the storage cap above: a
# bigger file is still stored and downloadable, it just never reaches the model,
# which is told it is in the Files panel.
# ARCHESTRA_CHAT_ATTACHMENT_INLINE_BYTES_LIMIT=16777216

# Maximum request body size for LLM proxy and chat routes. Default 73400320
# (70 MiB) — sized to carry a max-size chat attachment as base64 plus history.
# Accepts plain bytes or a suffixed size (e.g. "70MB").
# ARCHESTRA_API_BODY_LIMIT=73400320
