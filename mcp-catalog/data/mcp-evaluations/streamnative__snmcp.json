{
  "name": "streamnative__snmcp",
  "display_name": "snmcp",
  "description": "StreamNative MCP server for interacting with StreamNative services.",
  "author": {
    "name": "StreamNative"
  },
  "server": {
    "command": "/server/snmcp",
    "args": ["stdio", "--key-file", "/secrets/key_file.json"],
    "docker_image": "streamnative/snmcp:v0.1.14",
    "env": {
      "SNMCP_ORGANIZATION": "${user_config.snmcp_organization}"
    },
    "type": "local"
  },
  "tools": [],
  "prompts": [],
  "keywords": ["streamnative"],
  "user_config": {
    "key_file.json": {
      "type": "string",
      "title": "Key File",
      "description": "StreamNative service account key file. Creates secret at /secrets/key_file.json path.",
      "required": true,
      "sensitive": true,
      "mounted": true
    },
    "snmcp_organization": {
      "type": "string",
      "title": "SNMCP_ORGANIZATION",
      "description": "",
      "default": "",
      "required": false,
      "sensitive": false
    }
  },
  "readme": "",
