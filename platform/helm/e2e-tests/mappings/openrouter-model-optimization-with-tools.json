{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "headers": {
      "Authorization": {
        "contains": "openrouter-model-optimization-tools"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.model",
          "equalTo": "e2e-test-openrouter-optimized"
        }
      },
      {
        "matchesJsonPath": "$.tools"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "chatcmpl-openrouter-optimized-with-tools",
      "object": "chat.completion",
      "created": 1234567890,
      "model": "e2e-test-openrouter-optimized",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "Response from optimized model with tools.",
            "refusal": null
          },
          "finish_reason": "stop",
          "logprobs": null
        }
      ],
      "usage": {
        "prompt_tokens": 100,
        "completion_tokens": 15,
        "total_tokens": 115
      }
    }
  }
}
