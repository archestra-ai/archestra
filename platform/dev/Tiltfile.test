# Test resources

local_resource(
  'unit-tests',
  cmd='docker exec archestra-dev pnpm test',
  dir='..',
  labels=['test'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
  resource_deps=['archestra']
)

local_resource(
  'e2e-tests',
  cmd='docker exec archestra-dev pnpm test:e2e',
  dir='..',
  labels=['test'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
  resource_deps=['archestra']
)

local_resource(
  'e2e-tests-ui',
  serve_cmd='docker exec -i archestra-dev pnpm test:e2e:ui',
  serve_dir='..',
  labels=['test'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
  resource_deps=['archestra']
)
