{
  "id": null,
  "uid": "archestra-genai-observability",
  "title": "Archestra / LLM Proxy",
  "description": "Logical proxy outcomes and client-visible latency; upstream usage is a separate observation.",
  "tags": [
    "archestra",
    "observability"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "metrics_datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "job",
        "label": "Deployment job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"llm_tokens_total|agent_runtime_health_collection_timestamp_seconds|http_request_duration_seconds_count\"}, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Choose the deployment job. **No samples** can mean no traffic, unavailable telemetry, or a disabled feature; it is not a healthy zero. Logical request outcomes include preflight and full streaming. Provider attribution can remain `router` when admission fails before a provider is selected. Model/agent breakdowns below apply only to upstream metrics."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Logical proxy requests",
      "collapsed": false,
      "panels": [],
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "title": "Requests / second",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Successful completed requests",
      "type": "stat",
      "description": "Success is outcome=success. Incomplete, denied, cancelled and operational failures remain separate outcomes. No traffic has no percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\",outcome=\"success\"}[$__rate_interval])) or (sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])) * 0)) / sum (rate(llm_proxy_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "P95 full request duration",
      "type": "stat",
      "description": "",
