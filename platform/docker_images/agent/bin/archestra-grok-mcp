#!/usr/bin/env python3
"""Connect Grok Build to the Agent's MCP gateway as a local stdio server.

Grok names an MCP tool `<server>__<tool>` and drops every tool whose own name
contains `__`, which is every gateway tool (`archestra__get_remedy_plans`,
`github__list_repos`). This bridge relays JSON-RPC to the gateway unchanged,
except that listed names spell `__` as `--` and calls map back to the gateway's
names. Discovery still waits on the gateway's own tools/list.

The gateway URL, bearer token and run headers come from the environment, so no
credential is written to Grok's configuration.
"""

import json
import os
import sys
import threading
import urllib.error
from concurrent.futures import ThreadPoolExecutor
import urllib.request

GATEWAY_URL = os.environ["ARCHESTRA_MCP_GATEWAY_URL"]
SESSION = os.environ.get("ARCHESTRA_AGENT_RUNTIME_WORKSPACE_ID") or os.environ["ARCHESTRA_AGENT_RUNTIME_TASK_ID"]
GATEWAY_TIMEOUT_SECONDS = 600
HEADERS = {
    "Content-Type": "application/json",
    "Accept": "application/json, text/event-stream",
    "Authorization": "Bearer " + os.environ["ARCHESTRA_MCP_GATEWAY_TOKEN"],
    "X-Archestra-Run-Id": os.environ["ARCHESTRA_AGENT_RUNTIME_TASK_ID"],
    "X-Archestra-Session-Id": SESSION,
    "X-Appa-Session-ID": SESSION,
    "User-Agent": "archestra-grok-mcp",
}
if os.environ.get("ARCHESTRA_AGENT_RUNTIME_BINDING"):
    HEADERS["X-Archestra-Runtime-Binding"] = os.environ["ARCHESTRA_AGENT_RUNTIME_BINDING"]

output_lock = threading.Lock()
state_lock = threading.Lock()
gateway_names: dict[str, str] = {}
mcp_session: list[str] = []


def main() -> None:
    # Tool calls can run for a long time; answer each request on its own, but
    # cap the concurrency so a burst of messages cannot exhaust the runtime.
    with ThreadPoolExecutor(max_workers=8, thread_name_prefix="relay") as pool:
        for line in sys.stdin.buffer:
            try:
                message = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(message, dict):
                continue
            pool.submit(relay, message)


def relay(message: dict) -> None:
    request_id = message.get("id")
    if message.get("method") == "tools/call":
        params = dict(message.get("params") or {})
        with state_lock:
            # A local name maps back to the gateway tool rename_tools kept for
            # it; a name hidden by a collision therefore reaches the kept tool.
            params["name"] = gateway_names.get(params.get("name"), params.get("name"))
        message = {**message, "params": params}
    try:
        responses = post(message)
    except (OSError, ValueError) as error:
        if request_id is not None:
            reason = error.reason if isinstance(error, urllib.error.URLError) else str(error)
            write({"jsonrpc": "2.0", "id": request_id, "error": {"code": -32603, "message": f"MCP gateway request failed: {reason}"}})
        return
    # Every message the gateway puts in the response reaches Grok, including a
    # notification sent alongside the answer. The gateway opens no standalone
    # stream on GET, so nothing arrives outside a request exchange.
    for response in responses:
        if message.get("method") == "tools/list" and response.get("id") == request_id:
            rename_tools(response)
        write(response)


def post(message: dict) -> list[dict]:
    headers = dict(HEADERS)
    with state_lock:
        if mcp_session:
            headers["Mcp-Session-Id"] = mcp_session[0]
    request = urllib.request.Request(
        GATEWAY_URL, data=json.dumps(message).encode(), headers=headers, method="POST"
    )
    try:
        # A gateway tool call can run for minutes, but a silent socket must not
        # hold one of the relay workers forever.
        response = urllib.request.urlopen(request, timeout=GATEWAY_TIMEOUT_SECONDS)
    except urllib.error.HTTPError as error:
        # JSON-RPC errors can arrive with an HTTP error status.
        response = error
    with response:
        session = response.headers.get("Mcp-Session-Id")
        if session:
            with state_lock:
                mcp_session[:] = [session]
        body = response.read().decode("utf-8", errors="replace")
        content_type = response.headers.get("Content-Type", "")
        status = response.status
    if "text/event-stream" in content_type:
        parsed = [json.loads(data) for data in event_data(body)]
    elif body.strip():
        parsed = json.loads(body)
    else:
        parsed = []
    messages = [
        item
        for item in (parsed if isinstance(parsed, list) else [parsed])
        if isinstance(item, dict) and item.get("jsonrpc") == "2.0"
    ]
    # A request must get its answer. A rejected request (for example a 401
    # with a plain JSON error body) fails now instead of leaving Grok waiting.
    if "id" in message and not any(item.get("id") == message["id"] for item in messages):
        raise ValueError(f"HTTP {status}")
    return messages


def event_data(body: str) -> list[str]:
    """The data of each server-sent event; one event may span several lines."""
    events: list[str] = []
    lines: list[str] = []
    for line in body.splitlines() + [""]:
        if line.startswith("data:"):
            value = line[5:]
            lines.append(value[1:] if value.startswith(" ") else value)
        elif not line and lines:
            data = "\n".join(lines)
            if data.strip():
                events.append(data)
            lines = []
    return events


def rename_tools(response: dict) -> None:
    tools = (response.get("result") or {}).get("tools")
    if not isinstance(tools, list):
        return
    names: dict[str, str] = {}
    listed = []
    for tool in tools:
        name = tool.get("name") if isinstance(tool, dict) else None
        if not isinstance(name, str):
            continue
        local = name.replace("__", "--")
        if names.get(local, name) != name:
            # Two gateway names would share one local name; keep the first.
            print(
                f"archestra: gateway tool {name} is hidden: it shares the local name {local} with {names[local]}",
                file=sys.stderr,
                flush=True,
            )
            continue
        names[local] = name
        listed.append({**tool, "name": local})
    response["result"]["tools"] = listed
    # A paginated catalog arrives over several calls; keep every page's names.
    with state_lock:
        gateway_names.update(names)


def write(message: dict) -> None:
    with output_lock:
        sys.stdout.write(json.dumps(message) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
