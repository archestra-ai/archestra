{
  // Tests of the other routes whose names start with m to z.
  "extends": "./tsconfig.test-project.json",
  "compilerOptions": { "tsBuildInfoFile": "./.tsbuild/tests-routes-rest-c.tsbuildinfo" },
  "include": [
    "src/ambient/*.d.ts",
    "src/routes/m*.test.ts",
    "src/routes/m*/**/*.test.ts",
    "src/routes/n*.test.ts",
    "src/routes/n*/**/*.test.ts",
    "src/routes/o*.test.ts",
    "src/routes/o*/**/*.test.ts",
    "src/routes/p*.test.ts",
    "src/routes/p*/**/*.test.ts",
    "src/routes/q*.test.ts",
    "src/routes/q*/**/*.test.ts",
    "src/routes/r*.test.ts",
    "src/routes/r*/**/*.test.ts",
    "src/routes/s*.test.ts",
    "src/routes/s*/**/*.test.ts",
    "src/routes/t*.test.ts",
    "src/routes/t*/**/*.test.ts",
    "src/routes/u*.test.ts",
    "src/routes/u*/**/*.test.ts",
    "src/routes/v*.test.ts",
    "src/routes/v*/**/*.test.ts",
    "src/routes/w*.test.ts",
    "src/routes/w*/**/*.test.ts",
    "src/routes/x*.test.ts",
    "src/routes/x*/**/*.test.ts",
    "src/routes/y*.test.ts",
    "src/routes/y*/**/*.test.ts",
    "src/routes/z*.test.ts",
    "src/routes/z*/**/*.test.ts"
  ],
  "exclude": ["src/routes/proxy/**", "src/routes/mcp-gateway/**"],
  "references": [
    { "path": "../shared/tsconfig.lib.json" },
    { "path": "./tsconfig.schema.json" },
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test-support.json" }
  ]
}
