	],
	"keywords": ["archestra", "nodejs", "interceptor"],
	"author": "Archestra",
	"license": "MIT",
	"engines": {
		"node": ">=16.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.9.0"
	},
	"types": "./dist/index.d.ts"
}
