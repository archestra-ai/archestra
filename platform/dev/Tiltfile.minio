# MinIO (S3-compatible) for local My Files S3 storage. Loaded only when
# ARCHESTRA_FILE_STORAGE_PROVIDER=s3 (see root Tiltfile), so default dev never
# deploys it. Mirrors the Postgres resource in Tiltfile.database.
load('ext://helm_remote', 'helm_remote')

minio_namespace = os.getenv('ARCHESTRA_K8S_NAMESPACE', 'archestra-dev')
minio_bucket = os.getenv('ARCHESTRA_FILE_STORAGE_S3_BUCKET', 'archestra-files')
minio_access_key = os.getenv('ARCHESTRA_FILE_STORAGE_S3_ACCESS_KEY_ID', 'archestra')
minio_secret_key = os.getenv('ARCHESTRA_FILE_STORAGE_S3_SECRET_ACCESS_KEY', 'archestra_dev_password')
minio_api_host_port = os.getenv('ARCHESTRA_MINIO_API_HOST_PORT', '9100')
minio_console_host_port = os.getenv('ARCHESTRA_MINIO_CONSOLE_HOST_PORT', '9101')

helm_remote(
  'minio',
  repo_url='https://charts.bitnami.com/bitnami',
  namespace=minio_namespace,
  create_namespace=True,
  set=[
    'auth.rootUser=' + minio_access_key,
    'auth.rootPassword=' + minio_secret_key,
    'defaultBuckets=' + minio_bucket,

    # NOTE: Bitnami is archiving their image.. see these github comments for details
    # (this is essentially why we need to override image.repository and image.tag and global.security.allowInsecureImages)
    #
    # https://github.com/coder/coder/issues/19869#issuecomment-3305875979
    # https://github.com/bitnami/containers/issues/83267
    'image.repository=bitnamisecure/minio',
    'image.tag=latest',
    'global.security.allowInsecureImages=true',

    'resourcesPreset=small',
  ],
)

k8s_resource(
  'minio',
  port_forwards=[
    minio_api_host_port + ':9000',
    minio_console_host_port + ':9001',
  ],
  labels=['storage'],
)
