# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your-azure-openai-api-key-here

# Archestra Configuration (optional - for testing with proxy)
ARCHESTRA_AGENT_ID=your-agent-id-from-archestra-ui
USE_ARCHESTRA=false

# Get your Azure OpenAI key from:
# https://portal.azure.com → Your OpenAI resource → Keys and Endpoint

# Get your Archestra Agent ID from:
# http://localhost:3000 → Create a new profile → Copy the ID
