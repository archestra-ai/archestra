{
  // Tests of k8s, the clients, OpenAPPA and the proxy helpers.
  "extends": "./tsconfig.test-project.json",
  "compilerOptions": { "tsBuildInfoFile": "./.tsbuild/tests-domain-c.tsbuildinfo" },
  "include": [
    "src/ambient/*.d.ts",
    "src/k8s/**/*.test.ts",
    "src/clients/**/*.test.ts",
    "src/openappa/**/*.test.ts",
    "src/proxy/**/*.test.ts"
  ],
  "references": [
    { "path": "../shared/tsconfig.lib.json" },
    { "path": "./tsconfig.schema.json" },
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test-support.json" }
  ]
}
