{
  // Options every backend TypeScript project shares (tsconfig.json lists the
  // projects). tsx, Vitest and knip read them and the `paths` alias through
  // tsconfig.json, which extends this file; tsdown and the standalone scripts
  // (standalone-scripts.tsconfig.json) read this file directly.
  "compilerOptions": {
    "isolatedModules": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@drizzle-migration-linter": ["../tools/drizzle-migration-linter/src/index.ts"]
    }
  }
}
