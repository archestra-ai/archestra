    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"jsonrpc\":\"2.0\",\"id\":{{jsonPath request.body '$.id'}},\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"probe complete\"}]}}"
  }
}
