# With the dev VM (ARCHESTRA_DEV_MODE=2, see platform/dev/vm/README.md) this
# machine has no node_modules to check with.
case "${ARCHESTRA_DEV_MODE:-0}" in
  2)
    echo "pre-commit: commit check skipped (ARCHESTRA_DEV_MODE=$ARCHESTRA_DEV_MODE, no dependencies on this machine). Run it in the VM yourself, for example: platform/scripts/dev-vm-sync.py run 'pnpm lint'" >&2
    exit 0
    ;;
esac
cd platform
if ! pnpm commit:check; then
  echo ""
  echo "💡 Tip: Run 'pnpm lint:fix -- --unsafe && pnpm -r knip --fix' to auto-fix formatting and unused exports."
  echo ""
  exit 1
fi
