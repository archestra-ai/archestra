# With the dev VM (ARCHESTRA_DEV_MODE=2, see platform/dev/vm/README.md) this
# machine has no node_modules to check with: the check runs in the VM, on
# what this commit stages.
case "${ARCHESTRA_DEV_MODE:-0}" in
  2)
    exec platform/scripts/dev-vm-sync.py commit-check
    ;;
esac
cd platform
if ! pnpm commit:check; then
  echo ""
  echo "💡 Tip: Run 'pnpm lint:fix -- --unsafe && pnpm -r knip --fix' to auto-fix formatting and unused exports."
  echo ""
  exit 1
fi
