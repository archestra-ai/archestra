# Azure Authentication Method
# Options: "api_key" or "azure_cli"
# - api_key: Use Azure OpenAI API key (set AZURE_OPENAI_KEY below)
# - azure_cli: Use Azure CLI authentication (run 'az login' first)
AZURE_AUTH_METHOD=azure_cli

# Azure OpenAI Configuration
# Only required if AZURE_AUTH_METHOD=api_key
# Get from: https://portal.azure.com → Your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_KEY=your-azure-openai-api-key-here

# Archestra Configuration (optional - for testing with proxy)
# Get from: http://localhost:3000 → Create a new profile → Copy the ID
ARCHESTRA_AGENT_ID=your-agent-id-from-archestra-ui
USE_ARCHESTRA=false
