#!/usr/bin/env bash
set -euo pipefail

case "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" in
  openai_chat) openclaw_api="openai-completions" ;;
  openai_responses) openclaw_api="openai-responses" ;;
  *)
    echo "archestra: OpenClaw requires an Agent configured for OpenAI Chat Completions or OpenAI Responses" >&2
    exit 78
    ;;
esac

resolve_docker_desktop_url() {
  local url="$1"
  local hostname
  local ipv6

  case "${url}" in
    http://host.internal:*) hostname="host.internal" ;;
    http://host.orb.internal:*) hostname="host.orb.internal" ;;
    *)
      printf '%s\n' "${url}"
      return
      ;;
  esac

  ipv6="$(getent ahostsv6 "${hostname}" 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ -z "${ipv6}" ]]; then
    printf '%s\n' "${url}"
    return
  fi

  printf '%s\n' "${url/\/\/${hostname}/\/\/\[${ipv6}\]}"
}

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
config_file="${runtime_dir}/openclaw.json"
task_file="${runtime_dir}/task.md"
attention_plugin_dir="${runtime_dir}/openclaw-attention"
attention_plugin="${attention_plugin_dir}/index.cjs"
model="${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
runtime_instructions="${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}"
export OPENCLAW_STATE_DIR="${runtime_dir}/openclaw-state"
export OPENCLAW_CONFIG_PATH="${config_file}"
mkdir -p "${OPENCLAW_STATE_DIR}" "${attention_plugin_dir}"

# OpenClaw exposes typed lifecycle hooks to local plugins. The plugin is loaded
# from this generated, runtime-owned path and only reports state transitions.
cat > "${attention_plugin}" <<'PLUGIN'
const { execFile } = require("node:child_process");
const { promisify } = require("node:util");

const execFileAsync = promisify(execFile);

async function update(...args) {
  try {
    const command = process.env.ARCHESTRA_AGENT_ATTENTION_COMMAND ?? "archestra-agent-attention";
    await execFileAsync(command, args, { timeout: 2500 });
  } catch {
    // Attention reporting is best-effort and must never interrupt a run.
  }
}

module.exports = {
  id: "archestra-runtime-attention",
  name: "Archestra runtime attention",
  description: "Reports when this agent run is waiting for input.",
  register(api) {
    api.on("before_agent_run", async () => {
      await update("clear");
    });
    api.on("before_tool_call", async (event) => {
      if (event.toolName === "ask_user") await update("set", "Input requested");
    });
    api.on("after_tool_call", async (event) => {
      if (event.toolName === "ask_user") await update("clear");
    });
    api.on("agent_end", async (event) => {
      if (
        event.success &&
        process.env.ARCHESTRA_AGENT_RUNTIME_MODE === "interactive"
      ) {
        await update("set", "Waiting for input");
      } else {
        await update("clear");
      }
    });
    api.on("session_end", async () => {
      await update("clear");
    });
  },
};
PLUGIN
chmod 0600 "${attention_plugin}"
cat > "${attention_plugin_dir}/openclaw.plugin.json" <<'MANIFEST'
{
  "id": "archestra-runtime-attention",
  "name": "Archestra runtime attention",
  "description": "Reports when this agent run is waiting for input.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
MANIFEST
cat > "${attention_plugin_dir}/package.json" <<'PACKAGE'
{
  "name": "archestra-runtime-attention",
  "private": true,
  "type": "commonjs",
  "openclaw": {
    "extensions": ["./index.cjs"]
  }
}
PACKAGE
chmod 0600 \
  "${attention_plugin_dir}/openclaw.plugin.json" \
  "${attention_plugin_dir}/package.json"

# OpenClaw deliberately owns its generated system prompt. Its supported
# extension point is the workspace bootstrap files, so expose the Agent's
# runtime instructions through SOUL.md. Task pods use a fresh worktree; the
# cleanup and exclude bookkeeping also keep this safe for a custom workspace.
soul_file="${PWD}/SOUL.md"
soul_created=false
exclude_file=""
exclude_backup="${runtime_dir}/git-info-exclude.backup"
exclude_existed=false

cleanup_bootstrap() {
  if [[ "${soul_created}" == true ]]; then
    rm -f "${soul_file}"
  fi
  if [[ -n "${exclude_file}" ]]; then
    if [[ "${exclude_existed}" == true ]]; then
      cp "${exclude_backup}" "${exclude_file}"
    else
      rm -f "${exclude_file}"
    fi
  fi
}
trap cleanup_bootstrap EXIT

if [[ -n "${runtime_instructions}" && ! -e "${soul_file}" ]]; then
  printf '# Runtime instructions\n\n%s\n' "${runtime_instructions}" > "${soul_file}"
  soul_created=true

  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "${git_root}" && "${soul_file}" == "${git_root}"/* ]]; then
    exclude_file="$(git -C "${git_root}" rev-parse --git-path info/exclude)"
    mkdir -p "$(dirname "${exclude_file}")"
    if [[ -f "${exclude_file}" ]]; then
      cp "${exclude_file}" "${exclude_backup}"
      exclude_existed=true
    fi
    printf '\n/%s\n' "${soul_file#"${git_root}/"}" >> "${exclude_file}"
  fi
fi

# Docker Desktop publishes host.internal with a working IPv6 address and a
# synthetic IPv4 address that cannot accept connections from Kubernetes pods.
# OpenClaw's DNS-pinned HTTP transport intentionally prefers IPv4, so use the
# reachable address directly for this local-only hostname. Production service
# DNS names and ordinary platform URLs are left unchanged.
openclaw_base_url="$(resolve_docker_desktop_url "${OPENAI_BASE_URL:?}")"
openclaw_mcp_url="$(resolve_docker_desktop_url "${ARCHESTRA_MCP_GATEWAY_URL:?}")"
: "${OPENAI_API_KEY:?}"

jq -n \
  --arg base_url "${openclaw_base_url}" \
  --arg model "${model}" \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  --arg mcp_url "${openclaw_mcp_url}" \
  --arg api "${openclaw_api}" \
  --arg workspace "${PWD}" \
  --arg attention_plugin_dir "${attention_plugin_dir}" \
  '{
    logging:{level:"error",consoleLevel:"silent"},
    plugins:{
      enabled:true,
      bundledDiscovery:"allowlist",
      allow:["archestra-runtime-attention"],
      load:{paths:[$attention_plugin_dir]},
      entries:{
        "archestra-runtime-attention":{
          enabled:true,
          hooks:{allowConversationAccess:true,timeoutMs:3000}
        }
      }
    },
    models:{
      mode:"replace",
      providers:{
        archestra:{
          baseUrl:$base_url,
          apiKey:env.OPENAI_API_KEY,
          api:$api,
          headers:{
            "X-Archestra-Run-Id":$task_id,
            "X-Archestra-Session-Id":$task_id
          },
          models:[{id:$model,name:$model}]
        }
      }
    },
    agents:{defaults:{
      workspace:$workspace,
      skipBootstrap:true,
      model:{primary:("archestra/" + $model)}
    }},
    mcp:{
      servers:{
        archestra:{
          url:$mcp_url,
          transport:"streamable-http",
          headers:{
            Authorization:"Bearer ${ARCHESTRA_MCP_GATEWAY_TOKEN}",
            "X-Archestra-Run-Id":$task_id,
            "X-Archestra-Session-Id":$task_id
          }
        }
      }
    }
  }' > "${config_file}"
chmod 0600 "${config_file}"
if [[ -n "${runtime_instructions}" && "${soul_created}" != true ]]; then
  printf '%s\n\n# Delegated task\n\n%s\n' \
    "${runtime_instructions}" \
    "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"
else
  printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"
fi

session_key="agent:main:${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}"

case "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" in
  interactive)
    set +e
    openclaw tui \
      --local \
      --session "${session_key}" \
      --message "$(cat "${task_file}")"
    status=$?
    set -e
    exit "${status}"
    ;;
  one_shot)
    set +e
    openclaw agent \
      --local \
      --session-key "${session_key}" \
      --model "archestra/${model}" \
      --message-file "${task_file}" 2>&1 | tee "${runtime_dir}/openclaw-output.log"
    status=${PIPESTATUS[0]}
    set -e
    if [[ ${status} -ne 0 ]] || grep -Eq "FailoverError:|LLM request failed|network connection error|empty response retries exhausted|Agent couldn't generate a response" "${runtime_dir}/openclaw-output.log"; then
      exit 1
    fi
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
