# LightRAG MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================
LIGHTRAG_HOST=0.0.0.0
LIGHTRAG_PORT=8080
LIGHTRAG_MCP_PATH=/mcp
LIGHTRAG_WORKING_DIR=/app/data
LIGHTRAG_WORKSPACE=default

# =============================================================================
# Storage Configuration (Optional - falls back to local files if not set)
# =============================================================================

# Neo4j Configuration (optional - uses NetworkXStorage if not set)
# LIGHTRAG_NEO4J_URI=neo4j://localhost:7687
# LIGHTRAG_NEO4J_USERNAME=neo4j
# LIGHTRAG_NEO4J_PASSWORD=neo4j
# LIGHTRAG_NEO4J_DATABASE=neo4j

# Qdrant Configuration (optional - uses NanoVectorDBStorage if not set)
# LIGHTRAG_QDRANT_URL=http://localhost:6333
# LIGHTRAG_QDRANT_API_KEY=
# LIGHTRAG_QDRANT_COLLECTION_PREFIX=lightrag

# =============================================================================
# LLM Provider Configuration (Required)
# =============================================================================

# Provider selection: openai, anthropic, gemini
LIGHTRAG_LLM_PROVIDER=openai

# API key for the LLM provider (required)
LIGHTRAG_LLM_API_KEY=sk-your-api-key-here

# Model name (provider-specific)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
# Gemini: gemini-2.0-flash, gemini-1.5-pro
LIGHTRAG_LLM_MODEL=gpt-4o-mini

# Optional: Custom base URL (for proxies or self-hosted)
# LIGHTRAG_LLM_BASE_URL=https://api.openai.com/v1

# Maximum tokens for LLM responses
LIGHTRAG_LLM_MAX_TOKENS=9000

# =============================================================================
# Embedding Provider Configuration
# =============================================================================

# Provider selection: openai, gemini
# Note: Anthropic doesn't offer embeddings, use OpenAI or Gemini
LIGHTRAG_EMBEDDING_PROVIDER=openai

# Embedding model name
# OpenAI: text-embedding-3-large, text-embedding-3-small, text-embedding-ada-002
# Gemini: text-embedding-004
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-large

# Optional: Separate API key for embeddings (defaults to LLM_API_KEY)
# LIGHTRAG_EMBEDDING_API_KEY=

# Embedding dimensions (must match model)
# text-embedding-3-large: 3072
# text-embedding-3-small: 1536
# text-embedding-004: 768
LIGHTRAG_EMBEDDING_DIM=3072

# =============================================================================
# Document Processing Configuration
# =============================================================================
LIGHTRAG_CHUNK_TOKEN_SIZE=1200
LIGHTRAG_CHUNK_OVERLAP_TOKEN_SIZE=100
LIGHTRAG_MAX_PARALLEL_INSERT=2
