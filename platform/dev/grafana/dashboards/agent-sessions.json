    {
      "id": 8,
      "title": "Session Logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 22
      },
      "description": "Inference, tool and Guardrails operation logs plus correlated application logs for the selected session. Expand a log for metadata and trace correlation.",
      "datasource": {
        "type": "loki",
        "uid": "${logs_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"Archestra\"} | session_id = ${sessionId:json} | event_name != \"archestra.session.summary\"",
          "direction": "forward",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      }
    },
    {
      "id": 10,
      "title": "Session Waterfall",
      "type": "traces",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 22
      },
      "description": "All exported turns, inference, tool and Guardrails hook spans under the session trace identity. Native policy checks and consults are included in the hook boundary. Resume a session to append new spans; existing historical traces are not rewritten.",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "query": "${traceId}",
          "queryType": "traceId"
        }
      ]
    }
