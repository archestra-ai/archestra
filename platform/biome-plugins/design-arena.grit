// Design-arena commit guard.
//
// Design-arena prototypes live in `__arena__` files that are kept out of git
// (.git/info/exclude). The one import that mounts them in a real component is
// marked `// design-arena: do not commit`. This plugin fails lint on any import
// from an `__arena__` path, so that import cannot be committed by accident.
language js

`import $what from $source` where {
  $source <: r".*__arena__.*",
  register_diagnostic(
    span = $source,
    message = "Design-arena import: remove it before committing (prototype scaffolding is not committed)."
  )
}
