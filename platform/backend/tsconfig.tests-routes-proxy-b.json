  "extends": "./tsconfig.test-project.json",
  "compilerOptions": { "tsBuildInfoFile": "./.tsbuild/tests-routes-proxy-b.tsbuildinfo" },
  "include": [
    "src/ambient/*.d.ts",
    "src/routes/proxy/**/*.test.ts"
