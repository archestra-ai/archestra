{
  "name": "@archestra/app-runtime-rs",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "index.cjs",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --release --platform",
    "check:ci": "cargo fmt --check --all && cargo check -p app_runtime_core -p app_runtime_rs --locked && cargo test -p app_runtime_core --locked && pnpm build && pnpm smoke",
    "lint": "cargo fmt --check --all",
    "smoke": "node smoke.test.cjs",
    "test": "cargo test -p app_runtime_core --locked",
    "type-check": "cargo check -p app_runtime_core -p app_runtime_rs --locked"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.0"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "*.node"
  ]
}
