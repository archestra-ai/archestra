#!/usr/bin/env bash
set -euo pipefail

if [[ "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" != "openai_responses" ]]; then
  echo "archestra: Codex requires an Agent configured for OpenAI Responses" >&2
  exit 78
fi

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
runtime_mode="${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}"
export CODEX_HOME="${ARCHESTRA_AGENT_RUNTIME_NATIVE_STATE_DIR:-${runtime_dir}}/codex"
mkdir -p "${runtime_dir}" "${CODEX_HOME}"
attention_hook="${runtime_dir}/codex-attention-hook.sh"
cat > "${attention_hook}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
payload="$(cat)"
event="$(jq -r '.hook_event_name // empty' <<<"${payload}")"
tool="$(jq -r '.tool_name // empty' <<<"${payload}")"
attention_command="${ARCHESTRA_AGENT_ATTENTION_COMMAND:-archestra-agent-attention}"

case "${event}:${tool}" in
  PermissionRequest:*)
    "${attention_command}" set "Permission needed"
    ;;
  PreToolUse:request_user_input)
    "${attention_command}" set "Input requested"
    ;;
  Stop:*)
    if [[ "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" == "interactive" ]]; then
      "${attention_command}" set "Waiting for input"
    else
      "${attention_command}" clear
    fi
    ;;
  *)
    "${attention_command}" clear
    ;;
esac

# Codex accepts an empty object as a successful, non-mutating hook result.
printf '{}\n'
HOOK
chmod 0700 "${attention_hook}"
transcript_hook="${runtime_dir}/codex-transcript-hook.sh"
cat > "${transcript_hook}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
payload="$(cat)"
event="$(jq -r '.hook_event_name // empty' <<<"${payload}")"
session_id="$(jq -r '.session_id // empty' <<<"${payload}")"
transcript="$(jq -r '.transcript_path // empty' <<<"${payload}")"
session_file="${runtime_dir}/codex-main-session"

if [[ "${event}" == "SessionStart" ]]; then
  if [[ -n "${session_id}" && ! -e "${session_file}" ]]; then
    printf '%s\n' "${session_id}" > "${session_file}"
  fi
  printf '{}\n'
  exit 0
fi

if [[ "${event}" != "Stop" && "${event}" != "SessionEnd" ]]; then
  printf '{}\n'
  exit 0
fi
if [[ -s "${session_file}" && -n "${session_id}" ]] \
  && [[ "${session_id}" != "$(cat "${session_file}")" ]]; then
  printf '{}\n'
  exit 0
fi

if [[ -n "${transcript}" && -r "${transcript}" ]]; then
  readable_tmp="${runtime_dir}/readable-transcript.tmp.json"
  if jq -s '
    def timestamp($entry):
      if ($entry.timestamp | type) == "string"
      then {timestamp:$entry.timestamp}
      else {}
      end;
    def text_content:
      if . == null then ""
      elif type == "string" then .
      elif type == "array" then
        [ .[]
          | if type == "string" then .
            elif type == "object" and ((.text // .input_text // .output_text) | type) == "string"
            then (.text // .input_text // .output_text)
            else empty
            end
        ] | join("\n")
      else tostring
      end;
    def optional_id($payload):
      ($payload.call_id // $payload.id // empty) as $id
      | if ($id | type) == "string" then {toolCallId:$id} else {} end;
    {
      version:1,
      provider:"codex",
      entries:[
        .[] as $entry
        | select($entry.type == "response_item")
        | $entry.payload as $payload
        | if $payload.type == "message"
            and ($payload.role == "user" or $payload.role == "assistant") then
            ($payload.content | text_content) as $text
            | select($text != "")
            | ({type:"message", role:$payload.role, text:$text} + timestamp($entry))
          elif $payload.type == "function_call" or $payload.type == "custom_tool_call" then
            ({type:"tool_call", name:($payload.name // "tool")}
              + optional_id($payload)
              + timestamp($entry)
              + (if $payload.arguments != null then
                  {input:(if ($payload.arguments | type) == "string"
                    then $payload.arguments else ($payload.arguments | tojson) end)}
                elif $payload.input != null then
                  {input:(if ($payload.input | type) == "string"
                    then $payload.input else ($payload.input | tojson) end)}
                else {} end))
          elif $payload.type == "local_shell_call" then
            ({type:"tool_call", name:"shell", input:($payload.action | tojson)}
              + optional_id($payload) + timestamp($entry))
          elif $payload.type == "function_call_output" or $payload.type == "custom_tool_call_output" then
            ($payload.output | text_content) as $text
            | ({type:"tool_result", text:(if $text == "" then "[Non-text result omitted]" else $text end)}
              + optional_id($payload) + timestamp($entry))
          else empty
          end
      ]
    }
  ' "${transcript}" > "${readable_tmp}" 2>/dev/null; then
    mv "${readable_tmp}" "${runtime_dir}/readable-transcript.json"
  else
    rm -f "${readable_tmp}"
  fi
fi

# Codex accepts an empty object as a successful, non-mutating hook result.
printf '{}\n'
HOOK
chmod 0700 "${transcript_hook}"
jq -n --arg attention_cmd "${attention_hook}" --arg transcript_cmd "${transcript_hook}" '{hooks:{
  SessionStart:[{hooks:[
    {type:"command",command:$transcript_cmd,timeout:10},
    {type:"command",command:$attention_cmd,timeout:3}
  ]}],
  UserPromptSubmit:[{hooks:[{type:"command",command:$attention_cmd,timeout:3}]}],
  PermissionRequest:[{hooks:[{type:"command",command:$attention_cmd,timeout:3}]}],
  PreToolUse:[{
    matcher:"^request_user_input$",
    hooks:[{type:"command",command:$attention_cmd,timeout:3}]
  }],
  PostToolUse:[{hooks:[{type:"command",command:$attention_cmd,timeout:3}]}],
  Stop:[{hooks:[
    {type:"command",command:$transcript_cmd,timeout:10},
    {type:"command",command:$attention_cmd,timeout:3}
  ]}],
  SessionEnd:[{hooks:[
    {type:"command",command:$transcript_cmd,timeout:10},
    {type:"command",command:$attention_cmd,timeout:3}
  ]}]
}}' > "${CODEX_HOME}/hooks.json"
chmod 0600 "${CODEX_HOME}/hooks.json"
notify_config=""
if [[ "${runtime_mode}" == "one_shot" ]] \
  && [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" != "1" ]]; then
  notify_script="${runtime_dir}/codex-notify.sh"
  cat > "${notify_script}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
payload="${1:-}"
if [[ -z "${payload}" ]]; then
  exit 0
fi
task="$(cat "${runtime_dir}/task.md" 2>/dev/null || true)"
answer="$(jq -r --arg task "${task}" '
  if .type == "agent-turn-complete"
    and ((.["input-messages"] // []) | index($task)) != null
  then
    .["last-assistant-message"] // empty
  else
    empty
  end
' <<<"${payload}")"
if [[ -n "${answer}" ]]; then
  printf '%s\n' "${answer}" > "${runtime_dir}/final-answer.txt"
  touch "${runtime_dir}/turn-complete"
fi
HOOK
  chmod 0700 "${notify_script}"
  notify_config="notify = [$(jq -Rn --arg value "${notify_script}" '$value')]"
fi
developer_instructions="$({
  printf '%s\n\n' "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}"
  printf '%s' "Complete the delegated task fully in this isolated runner. Use the local shell and file tools directly. Do not stop after announcing a plan. Verify the work and report the concrete result."
} | jq -Rs .)"
cat > "${CODEX_HOME}/config.toml" <<EOF
model = $(jq -Rn --arg value "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}" '$value')
model_provider = "archestra"
approval_policy = "never"
sandbox_mode = "danger-full-access"
developer_instructions = ${developer_instructions}
${notify_config}

[model_providers.archestra]
name = "Archestra"
base_url = $(jq -Rn --arg value "${OPENAI_BASE_URL:?}" '$value')
env_key = "OPENAI_API_KEY"
wire_api = "responses"

[model_providers.archestra.http_headers]
"X-Archestra-Run-Id" = $(jq -Rn --arg value "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" '$value')
"X-Archestra-Session-Id" = $(jq -Rn --arg value "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" '$value')

[mcp_servers.archestra]
url = $(jq -Rn --arg value "${ARCHESTRA_MCP_GATEWAY_URL:?}" '$value')
bearer_token_env_var = "ARCHESTRA_MCP_GATEWAY_TOKEN"

[mcp_servers.archestra.http_headers]
"X-Archestra-Run-Id" = $(jq -Rn --arg value "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" '$value')
"X-Archestra-Session-Id" = $(jq -Rn --arg value "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" '$value')

[projects.$(jq -Rn --arg value "${PWD}" '$value')]
trust_level = "trusted"
EOF
chmod 0600 "${CODEX_HOME}/config.toml"

task_file="${runtime_dir}/task.md"
printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"

common_args=(
  --dangerously-bypass-approvals-and-sandbox
  --dangerously-bypass-hook-trust
  --model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL}"
  --config model_provider='"archestra"'
)
if [[ "${ARCHESTRA_AGENT_RUNTIME_CONTINUE:-0}" == "1" ]]; then
  common_args=(resume --last "${common_args[@]}")
fi

case "${runtime_mode}" in
  interactive)
    # No subcommand means Codex's native full-screen TUI. The positional prompt
    # starts the first turn; subsequent terminal input stays in the same Codex
    # conversation until the person exits or stops the execution.
    exec codex "${common_args[@]}" -- "$(cat "${task_file}")"
    ;;
  one_shot)
    if [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]]; then
      exec codex exec \
        --color always \
        "${common_args[@]}" \
        --skip-git-repo-check \
        -- "$(cat "${task_file}")"
    fi

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "${script_dir}/archestra-tui-run" \
      "${runtime_dir}/turn-complete" \
      "${runtime_dir}/final-answer.txt" \
      codex "${common_args[@]}" -- "$(cat "${task_file}")"
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
