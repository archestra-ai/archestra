#!/usr/bin/env bash
set -euo pipefail

if [[ "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" != "anthropic" ]]; then
  echo "archestra: Claude Code requires an Agent configured with an Anthropic model" >&2
  exit 78
fi

# Claude Code treats ANTHROPIC_API_KEY as a user-supplied custom key and asks
# for first-run confirmation. The same short-lived platform credential is also
# provided in ANTHROPIC_AUTH_TOKEN, which is its non-interactive gateway path.
# Prefer that alias so a fresh pod opens directly into the native TUI.
unset ANTHROPIC_API_KEY

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
mcp_config="${runtime_dir}/claude-mcp.json"
jq -n \
  --arg url "${ARCHESTRA_MCP_GATEWAY_URL:?}" \
  --arg token "${ARCHESTRA_MCP_GATEWAY_TOKEN:?}" \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  '{mcpServers:{archestra:{
    type:"http",
    url:$url,
    headers:{
      Authorization:("Bearer " + $token),
      "X-Archestra-Run-Id":$task_id,
      "X-Archestra-Session-Id":$task_id
    }
  }}}' \
  > "${mcp_config}"
chmod 0600 "${mcp_config}"

# Pre-accept the workspace trust prompt. Claude Code asks "is this a project
# you trust?" the first time it opens a directory, and --dangerously-skip-
# permissions does NOT cover it. Print mode never renders the prompt, so this
# was invisible until delegated runs started using the TUI — and then the
# session sat on the dialog with nobody able to answer, burning the whole run.
# Merged rather than written, because Claude Code rewrites this file as it runs.
claude_json="${HOME}/.claude.json"
workspace="$(pwd)"
trust_patch="$(jq -n --arg dir "${workspace}" \
  '{hasCompletedOnboarding:true,bypassPermissionsModeAccepted:true,
    projects:{($dir):{hasTrustDialogAccepted:true}}}')"
if [[ -s "${claude_json}" ]] && jq -e . "${claude_json}" >/dev/null 2>&1; then
  merged="$(jq --argjson patch "${trust_patch}" '. * $patch' "${claude_json}")"
else
  merged="${trust_patch}"
fi
printf '%s\n' "${merged}" > "${claude_json}"
chmod 0600 "${claude_json}"

args=(
  --model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
  --permission-mode bypassPermissions
  --mcp-config "${mcp_config}"
  --strict-mcp-config
)
if [[ -n "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}" ]]; then
  args+=(--append-system-prompt "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT}")
fi

# Claude Code knows when it is waiting for a person. Reflect its native hook
# events in tmux rather than guessing from terminal contents. The platform's
# tmux status-left format reads these user options for every attached client.
attention_hook="${runtime_dir}/attention-hook.sh"
settings_file="${runtime_dir}/claude-settings.json"
cat > "${attention_hook}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
payload="$(cat)"
event="$(jq -r '.hook_event_name // empty' <<<"${payload}")"
notification="$(jq -r '.notification_type // empty' <<<"${payload}")"
attention_command="${ARCHESTRA_AGENT_ATTENTION_COMMAND:-archestra-agent-attention}"

case "${event}:${notification}" in
  Notification:permission_prompt)
    label="Permission needed"
    ;;
  Notification:idle_prompt)
    label="Waiting for input"
    ;;
  Notification:elicitation_dialog)
    label="Input requested"
    ;;
  *)
    "${attention_command}" clear
    exit 0
    ;;
esac

"${attention_command}" set "${label}"
HOOK
chmod 0700 "${attention_hook}"
transcript_hook="${runtime_dir}/transcript-hook.sh"
cat > "${transcript_hook}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
payload="$(cat)"
transcript="$(jq -r '.transcript_path // empty' <<<"${payload}")"
printf '%s\n' '{"hook_event_name":"Stop"}' \
  | "${runtime_dir}/attention-hook.sh" \
  >/dev/null 2>&1 || true

if [[ -n "${transcript}" && -r "${transcript}" ]]; then
  readable_tmp="${runtime_dir}/readable-transcript.tmp.json"
  if jq -s '
    def timestamp($entry):
      if ($entry.timestamp | type) == "string"
      then {timestamp:$entry.timestamp}
      else {}
      end;
    def content_text:
      if . == null then ""
      elif type == "string" then .
      elif type == "array" then
        [ .[]
          | if type == "string" then .
            elif type == "object" and .type == "text" and (.text | type) == "string" then .text
            else empty
            end
        ] | join("\n")
      else tostring
      end;
    {
      version:1,
      provider:"claude-code",
      entries:[
        .[] as $entry
        | select($entry.type == "user" or $entry.type == "assistant")
        | ($entry.message.content // empty) as $content
        | if ($content | type) == "string" then
            select($content != "")
            | ({type:"message", role:$entry.type, text:$content} + timestamp($entry))
          elif ($content | type) == "array" then
            $content[]
            | if .type == "text" and (.text | type) == "string" and .text != "" then
                ({type:"message", role:$entry.type, text:.text} + timestamp($entry))
              elif .type == "tool_use" and (.name | type) == "string" then
                ({type:"tool_call", name:.name} + timestamp($entry)
                  + (if (.id | type) == "string" then {toolCallId:.id} else {} end)
                  + (if .input != null then {input:(.input | tojson)} else {} end))
              elif .type == "tool_result" then
                (.content | content_text) as $text
                | ({type:"tool_result", text:(if $text == "" then "[Non-text result omitted]" else $text end)}
                  + timestamp($entry)
                  + (if (.tool_use_id | type) == "string" then {toolCallId:.tool_use_id} else {} end)
                  + (if .is_error == true then {isError:true} else {} end))
              else empty
              end
          else empty
          end
      ]
    }
  ' "${transcript}" > "${readable_tmp}" 2>/dev/null; then
    mv "${readable_tmp}" "${runtime_dir}/readable-transcript.json"
  else
    rm -f "${readable_tmp}"
  fi
fi

if [[ "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" == "one_shot" ]]; then
  if [[ -n "${transcript}" && -r "${transcript}" ]]; then
    jq -rs '[.[]
        | select(.type == "assistant")
        | .message.content
        | if type == "array" then (map(select(.type == "text") | .text) | join("")) else . end
        | select(. != null and . != "")
      ] | last // ""' "${transcript}" > "${runtime_dir}/final-answer.txt" 2>/dev/null || true
  fi
  touch "${runtime_dir}/turn-complete"
fi
HOOK
chmod 0700 "${transcript_hook}"

jq -n --arg attention_cmd "${attention_hook}" --arg transcript_cmd "${transcript_hook}" '{hooks:{
  Notification:[{
    matcher:"permission_prompt|idle_prompt|elicitation_dialog|elicitation_complete|elicitation_response|auth_success",
    hooks:[{type:"command",command:$attention_cmd}]
  }],
  UserPromptSubmit:[{matcher:"",hooks:[{type:"command",command:$attention_cmd}]}],
  PostToolUse:[{matcher:"",hooks:[{type:"command",command:$attention_cmd}]}],
  Stop:[{matcher:"",hooks:[{type:"command",command:$transcript_cmd}]}]
}}' > "${settings_file}"
args+=(--settings "${settings_file}")

case "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" in
  interactive)
    # A Chat execution owns a real pty. Start Claude Code's native TUI with the
    # first prompt already submitted, then leave the process alive for the
    # person's follow-up turns.
    exec claude "${args[@]}" "${ARCHESTRA_AGENT_RUNTIME_TASK:?}"
    ;;
  one_shot)
    # Delegation has nobody attached to exit a TUI, which is why this mode
    # exists — but `--print` draws NOTHING until the final answer, so the
    # execution's live terminal sits blank for the whole run and a person who
    # attaches cannot tell a working session from a wedged one.
    #
    # Run the real TUI instead, and give it the completion contract print mode
    # provided for free: a Stop hook fires when the turn ends, writes the final
    # assistant message out of the transcript, and drops a marker. A watchdog
    # sees the marker, ends the session, and prints the answer behind the
    # platform's fence — so the task still settles on one clean terminal
    # result while the pane shows the native interface throughout.
    #
    # ARCHESTRA_AGENT_RUNTIME_PLAIN=1 forces the old print mode.
    if [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]] \
      || ! command -v jq >/dev/null 2>&1; then
      exec claude --print "${args[@]}" "${ARCHESTRA_AGENT_RUNTIME_TASK:?}"
    fi

    answer_file="${runtime_dir}/final-answer.txt"
    done_marker="${runtime_dir}/turn-complete"
    rm -f "${answer_file}" "${done_marker}"

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "${script_dir}/archestra-tui-run" \
      "${done_marker}" \
      "${answer_file}" \
      claude "${args[@]}" "${ARCHESTRA_AGENT_RUNTIME_TASK:?}"
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
