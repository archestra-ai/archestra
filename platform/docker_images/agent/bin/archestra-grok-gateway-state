#!/usr/bin/env python3
"""Report the gateway's state in a Grok Build session's own MCP record.

Grok writes each session's MCP lifecycle to `events.jsonl` in the session
folder: `mcp_server_connected` with the listed tool count, or
`mcp_server_failed` when initialize or tools/list failed. Grok's live views
report a failed tools/list as ready with no tools; this record does not.

Usage: archestra-grok-gateway-state <since-epoch-seconds> [session-id]
Prints `ready <tool-count>`, `failed`, or `pending`. Only events written at or
after <since> count, so a resumed session's earlier starts are ignored.
"""

import json
import os
import sys
from datetime import datetime
from pathlib import Path

SERVER = "archestra"


def main() -> int:
    since = float(sys.argv[1])
    session_id = sys.argv[2] if len(sys.argv) > 2 else "*"
    grok_home = Path(os.environ.get("GROK_HOME", Path.home() / ".grok"))
    latest: tuple[float, str] | None = None
    for log in (grok_home / "sessions").glob(f"*/{session_id}/events.jsonl"):
        try:
            if log.stat().st_mtime < since:
                continue
            lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            outcome = gateway_event(line, since)
            if outcome and (latest is None or outcome[0] >= latest[0]):
                latest = outcome
    print(latest[1] if latest else "pending")
    return 0


def gateway_event(line: str, since: float) -> tuple[float, str] | None:
    try:
        event = json.loads(line)
        moment = datetime.fromisoformat(event["ts"].replace("Z", "+00:00")).timestamp()
    except (ValueError, KeyError, TypeError, AttributeError):
        return None
    if moment < since or event.get("server_name") != SERVER:
        return None
    if event.get("type") == "mcp_server_connected":
        count = event.get("tool_count")
        return moment, f"ready {count if isinstance(count, int) else 0}"
    if event.get("type") == "mcp_server_failed":
        return moment, "failed"
    return None


if __name__ == "__main__":
    raise SystemExit(main())
