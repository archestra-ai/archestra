#!/usr/bin/env bash
set -euo pipefail

if [[ "${ARCHESTRA_LLM_PROXY_PROTOCOL:-}" != "openai_chat" ]]; then
  echo "archestra: Hermes requires an Agent configured for OpenAI Chat Completions" >&2
  exit 78
fi

runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
runtime_mode="${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}"
export HERMES_HOME="${runtime_dir}/hermes"
mkdir -p "${HERMES_HOME}"
attention_plugin_dir="${HERMES_HOME}/plugins/archestra-attention"
mkdir -p "${attention_plugin_dir}"
cat > "${attention_plugin_dir}/plugin.yaml" <<'PLUGIN_MANIFEST'
name: archestra-attention
version: 1.0.0
description: Report Hermes input and permission waits to Archestra Agent Runtime.
author: Archestra
hooks:
  - on_session_start
  - pre_llm_call
  - pre_tool_call
  - post_tool_call
  - pre_approval_request
  - post_approval_response
  - on_session_end
PLUGIN_MANIFEST
cat > "${attention_plugin_dir}/__init__.py" <<'PLUGIN'
from __future__ import annotations

import os
import json
import subprocess
from typing import Any


def register(ctx: Any) -> None:
    ctx.register_hook("on_session_start", _on_session_start)
    ctx.register_hook("pre_llm_call", _clear)
    ctx.register_hook("pre_tool_call", _pre_tool_call)
    ctx.register_hook("post_tool_call", _post_tool_call)
    ctx.register_hook("pre_approval_request", _pre_approval_request)
    ctx.register_hook("post_approval_response", _clear)
    ctx.register_hook("on_session_end", _on_session_end)


def _pre_tool_call(tool_name: str = "", **_: Any) -> None:
    if tool_name == "clarify":
        _attention("set", "Input requested")


def _post_tool_call(tool_name: str = "", **_: Any) -> None:
    if tool_name == "clarify":
        _attention("clear")


def _pre_approval_request(**_: Any) -> None:
    _attention("set", "Permission needed")


def _on_session_start(session_id: str = "", **_: Any) -> None:
    _clear()
    _transcript_hook("on_session_start", session_id)


def _on_session_end(completed: bool = False, session_id: str = "", **_: Any) -> None:
    _transcript_hook("on_session_end", session_id)
    if os.environ.get("ARCHESTRA_AGENT_RUNTIME_MODE", "one_shot") == "interactive" and completed:
        _attention("set", "Waiting for input")
    else:
        _attention("clear")


def _clear(**_: Any) -> None:
    _attention("clear")


def _transcript_hook(event: str, session_id: str) -> None:
    # The native TUI loads plugins but does not consistently register shell
    # hooks. Forward its lifecycle events through the same transcript writer.
    if not session_id:
        return
    runtime_dir = os.environ.get("ARCHESTRA_AGENT_RUNTIME_DIR", "/var/run/archestra")
    try:
        subprocess.run(
            [os.path.join(runtime_dir, "hermes-runtime-hook.sh")],
            input=json.dumps({"hook_event_name": event, "session_id": session_id}),
            text=True,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def _attention(action: str, label: str = "") -> None:
    command = os.environ.get(
        "ARCHESTRA_AGENT_ATTENTION_COMMAND", "archestra-agent-attention"
    )
    args = [command, action]
    if label:
        args.append(label)
    try:
        subprocess.run(
            args,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        pass
PLUGIN
transcript_writer="${runtime_dir}/hermes-transcript.py"
cat > "${transcript_writer}" <<'PYTHON'
import datetime
import json
import os
import sqlite3
import sys
from pathlib import Path


database_path = Path(sys.argv[1])
session_id = sys.argv[2]
output_path = Path(sys.argv[3])


def select_column(columns: set[str], name: str) -> str:
    return name if name in columns else f"NULL AS {name}"


def timestamp(value: object) -> str | None:
    if isinstance(value, str):
        return value
    if isinstance(value, (int, float)):
        return datetime.datetime.fromtimestamp(
            value, tz=datetime.timezone.utc
        ).isoformat().replace("+00:00", "Z")
    return None


def serialized(value: object) -> str:
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
            if isinstance(parsed, (dict, list)):
                return json.dumps(parsed, separators=(",", ":"))
        except json.JSONDecodeError:
            pass
        return value
    return json.dumps(value, separators=(",", ":"))


if not database_path.exists():
    sys.exit(0)

with sqlite3.connect(database_path, timeout=3) as database:
    columns = {
        row[1] for row in database.execute("PRAGMA table_info(messages)").fetchall()
    }
    if not {"session_id", "role", "content"}.issubset(columns):
        sys.exit(0)
    fields = [
        "role",
        "content",
        select_column(columns, "tool_call_id"),
        select_column(columns, "tool_calls"),
        select_column(columns, "tool_name"),
        select_column(columns, "timestamp"),
    ]
    active_filter = " AND active = 1" if "active" in columns else ""
    order = "id" if "id" in columns else "rowid"
    rows = database.execute(
        f"SELECT {', '.join(fields)} FROM messages "
        f"WHERE session_id = ?{active_filter} ORDER BY {order}",
        (session_id,),
    ).fetchall()

entries: list[dict[str, object]] = []
for role, content, tool_call_id, tool_calls, tool_name, created_at in rows:
    entry_timestamp = timestamp(created_at)
    timed = {"timestamp": entry_timestamp} if entry_timestamp else {}
    if role in ("user", "assistant") and isinstance(content, str) and content:
        entries.append({"type": "message", "role": role, "text": content, **timed})

    if role == "assistant" and tool_calls:
        try:
            calls = json.loads(tool_calls) if isinstance(tool_calls, str) else tool_calls
        except (TypeError, json.JSONDecodeError):
            calls = []
        for call in calls if isinstance(calls, list) else []:
            if not isinstance(call, dict):
                continue
            function = call.get("function")
            function = function if isinstance(function, dict) else {}
            name = function.get("name") or call.get("name")
            if not isinstance(name, str):
                continue
            arguments = function.get("arguments", call.get("arguments"))
            entry: dict[str, object] = {"type": "tool_call", "name": name, **timed}
            call_id = call.get("id") or call.get("tool_call_id")
            if isinstance(call_id, str):
                entry["toolCallId"] = call_id
            if arguments is not None:
                entry["input"] = serialized(arguments)
            entries.append(entry)

    if role == "tool":
        entry = {
            "type": "tool_result",
            "text": content if isinstance(content, str) and content else "[Non-text result omitted]",
            **timed,
        }
        if isinstance(tool_call_id, str):
            entry["toolCallId"] = tool_call_id
        entries.append(entry)

temporary_path = output_path.with_name(f"{output_path.name}.{os.getpid()}.tmp")
temporary_path.write_text(
    json.dumps({"version": 1, "provider": "hermes", "entries": entries}) + "\n",
    encoding="utf-8",
)
os.replace(temporary_path, output_path)
PYTHON
chmod 0600 "${transcript_writer}"

completion_hook="${runtime_dir}/hermes-runtime-hook.sh"
cat > "${completion_hook}" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
runtime_dir="${ARCHESTRA_AGENT_RUNTIME_DIR:-/var/run/archestra}"
payload="$(cat)"
event="$(jq -r '.hook_event_name // empty' <<<"${payload}")"
session_id="$(jq -r '.session_id // empty' <<<"${payload}")"
session_file="${runtime_dir}/hermes-main-session"
if [[ "${event}" == "on_session_start" ]]; then
  if [[ -n "${session_id}" && ! -e "${session_file}" ]]; then
    printf '%s\n' "${session_id}" > "${session_file}"
  fi
  exit 0
fi
if [[ "${event}" != "post_llm_call" && "${event}" != "on_session_end" ]] \
  || [[ ! -s "${session_file}" ]] \
  || [[ "${session_id}" != "$(cat "${session_file}")" ]]; then
  exit 0
fi
python3 "${runtime_dir}/hermes-transcript.py" \
  "${runtime_dir}/hermes/state.db" \
  "${session_id}" \
  "${runtime_dir}/readable-transcript.json" || true

if [[ "${event}" != "post_llm_call" ]] \
  || [[ "${ARCHESTRA_AGENT_RUNTIME_MODE:-one_shot}" != "one_shot" ]] \
  || [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]]; then
  exit 0
fi
answer="$(jq -r '.extra.assistant_response // empty' <<<"${payload}")"
if [[ -n "${answer}" ]]; then
  printf '%s\n' "${answer}" > "${runtime_dir}/final-answer.txt"
  touch "${runtime_dir}/turn-complete"
fi
HOOK
chmod 0700 "${completion_hook}"
jq -n \
  --arg base_url "${OPENAI_BASE_URL:?}" \
  --arg model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}" \
  --arg task_id "${ARCHESTRA_AGENT_RUNTIME_TASK_ID:?}" \
  --arg mcp_url "${ARCHESTRA_MCP_GATEWAY_URL:?}" \
  --arg gateway_token "${ARCHESTRA_MCP_GATEWAY_TOKEN:?}" \
  --arg system_prompt "${ARCHESTRA_AGENT_RUNTIME_SYSTEM_PROMPT:-}" \
  --arg completion_hook "${completion_hook}" \
  '({
    providers:{archestra:{
      name:"Archestra",
      base_url:$base_url,
      key_env:"OPENAI_API_KEY",
      default_model:$model,
      transport:"openai_chat"
    }},
    agent:{system_prompt:$system_prompt},
    plugins:{enabled:["archestra-attention"]},
    model:{
      max_tokens:16384,
      context_length:1047576,
      default_headers:{
        "X-Archestra-Run-Id":$task_id,
        "X-Archestra-Session-Id":$task_id
      }
    },
    mcp_servers:{archestra:{
      url:$mcp_url,
      headers:{
        Authorization:("Bearer " + $gateway_token),
        "X-Archestra-Run-Id":$task_id,
        "X-Archestra-Session-Id":$task_id
      }
    }}
  } + {
    hooks_auto_accept:true,
    hooks:{
      on_session_start:[{command:$completion_hook}],
      post_llm_call:[{command:$completion_hook}],
      on_session_end:[{command:$completion_hook}]
    }
  })' > "${HERMES_HOME}/config.yaml"
chmod 0600 "${HERMES_HOME}/config.yaml"

# Hermes reads its ordinary config from ~/.hermes.
mkdir -p "${HOME}/.hermes"
ln -sf "${HERMES_HOME}/config.yaml" "${HOME}/.hermes/config.yaml"
task_file="${runtime_dir}/task.md"
printf '%s\n' "${ARCHESTRA_AGENT_RUNTIME_TASK:?}" > "${task_file}"

completion_watcher="${runtime_dir}/hermes-completion-watch.py"
cat > "${completion_watcher}" <<'PYTHON'
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

database_path = Path(sys.argv[1])
task = sys.argv[2]
answer_path = Path(sys.argv[3])
done_path = Path(sys.argv[4])

while not done_path.exists():
    try:
        if database_path.exists():
            with sqlite3.connect(database_path, timeout=0.2) as database:
                session = database.execute(
                    """
                    SELECT sessions.id
                    FROM sessions
                    JOIN messages ON messages.session_id = sessions.id
                    WHERE sessions.source = 'tui'
                      AND sessions.parent_session_id IS NULL
                      AND messages.role = 'user'
                      AND messages.content = ?
                    ORDER BY sessions.started_at DESC
                    LIMIT 1
                    """,
                    (task,),
                ).fetchone()
                if session:
                    assistant = database.execute(
                        """
                        SELECT content
                        FROM messages
                        WHERE session_id = ?
                          AND role = 'assistant'
                          AND active = 1
                          AND finish_reason IS NOT NULL
                        ORDER BY id DESC
                        LIMIT 1
                        """,
                        (session[0],),
                    ).fetchone()
                    if assistant and assistant[0].strip():
                        subprocess.run(
                            [
                                sys.executable,
                                str(answer_path.parent / "hermes-transcript.py"),
                                str(database_path),
                                str(session[0]),
                                str(answer_path.parent / "readable-transcript.json"),
                            ],
                            check=False,
                        )
                        answer_path.write_text(f"{assistant[0].strip()}\n", encoding="utf-8")
                        done_path.touch()
                        break
    except (OSError, sqlite3.Error):
        pass
    time.sleep(0.2)
PYTHON
chmod 0600 "${completion_watcher}"

common_args=(
  --provider archestra
  --model "${ARCHESTRA_AGENT_RUNTIME_NATIVE_MODEL:?}"
  --yolo
  --accept-hooks
)

case "${runtime_mode}" in
  interactive)
    exec hermes chat \
      "${common_args[@]}" \
      --tui \
      --query "$(cat "${task_file}")"
    ;;
  one_shot)
    if [[ "${ARCHESTRA_AGENT_RUNTIME_PLAIN:-0}" == "1" ]]; then
      set +e
      hermes chat \
        "${common_args[@]}" \
        --query "$(cat "${task_file}")" \
        2>&1 | tee "${runtime_dir}/hermes-output.log"
      status=${PIPESTATUS[0]}
      set -e
      if [[ ${status} -ne 0 ]] || grep -Eq 'HTTP [45][0-9]{2}:|Traceback \(most recent call last\)|LLM request failed|api_validation_error|Context length exceeded|\[exit [1-9][0-9]*\]|Failed to ' "${runtime_dir}/hermes-output.log"; then
        exit 1
      fi
      exit 0
    fi

    python3 "${completion_watcher}" \
      "${HERMES_HOME}/state.db" \
      "$(cat "${task_file}")" \
      "${runtime_dir}/final-answer.txt" \
      "${runtime_dir}/turn-complete" &

    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "${script_dir}/archestra-tui-run" \
      "${runtime_dir}/turn-complete" \
      "${runtime_dir}/final-answer.txt" \
      hermes chat \
        "${common_args[@]}" \
        --tui \
        --query "$(cat "${task_file}")"
    ;;
  *)
    echo "archestra: unknown Agent Runtime mode" >&2
    exit 78
    ;;
esac
