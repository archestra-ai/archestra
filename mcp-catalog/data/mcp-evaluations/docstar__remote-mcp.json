{
  "name": "docstar__remote-mcp",
  "display_name": "DocStar",
  "icon": "data:image/png;base64,",
  "description": "DocStar turns your product's API into published docs that your users' AI assistants can read and call. Your AI assistant can document each endpoint from your code, publish the docs, and give you one link to share. Your users' assistants then look up any endpoint and call your API with the exact URLs, fields and auth from your docs, so they don't guess. Reading docs needs no account; changes need DocStar sign-in.",
  "oauth_config": {
    "name": "DocStar MCP",
    "server_url": "https://mcp.docstar.io/mcp",
    "client_id": "",
    "redirect_uris": [
      "http://localhost:8080/oauth/callback"
    ],
    "scopes": [],
    "description": "DocStar MCP Server (dynamic registration)",
    "default_scopes": [],
    "supports_resource_metadata": true
  },
  "tools": [
    {
      "name": "search_docstar_docs",
      "description": "Search DocStar's documentation and guides with a natural-language question, e.g. \"how do I add a custom domain to my docs?\" or \"how does sign-in work on my MCP server?\"."
    },
    {
      "name": "get_docstar_api_docs",
      "description": "Browse the DocStar API reference one level at a time, when no dedicated tool on this server does what the user needs."
    },
    {
      "name": "call_any_api_of_docstar",
      "description": "Send a POST, PUT, PATCH or DELETE request to any DocStar API endpoint for the signed-in user and return { status, ok, headers, data }."
    },
    {
      "name": "call_any_read_api_of_docstar",
      "description": "Read from any DocStar API endpoint with a GET request for the signed-in user and return { status, ok, headers, data }."
    },
    {
      "name": "list_collections",
      "description": "List the collections (docs sites) in an organization, with each one's id, name, type and the caller's permission (1 read, 2 read-write)."
    },
    {
      "name": "get_mcp_server",
      "description": "Get a collection's MCP server: the url end users connect to, ready-to-paste snippets (a Claude Code command and a JSON config), callbackUrls for the OAuth app, the sign-in setup and any custom domain."
    },
    {
      "name": "create_collection",
      "description": "Creates a new documentation collection in the organization together with its invisible root page (type 0), auto-assigns collection permissions to all org users based on their roles, and auto-provisions an MCP server for it in the background."
    },
    {
      "name": "create_endpoint",
      "description": "Creates a new API endpoint doc (page type 4, draft) as the last child of the given page."
    },
    {
      "name": "update_endpoint",
      "description": "Partially updates an API endpoint doc; send only fields to change (same fields as Create Endpoint)."
    },
    {
      "name": "create_page",
      "description": "Creates a new page as the last child of the page given in the path."
    },
    {
      "name": "publish_pages",
      "description": "Publishes many pages/endpoints at once: each page in pageIds gets a new default published version and state 2 (approved/published)."
    },
    {
      "name": "list_collection_pages",
      "description": "Returns all non-deleted pages of a collection (the full sidebar tree, flat) with id, name, urlName, type, parentId, child (ordered child ids), state, isPublished, meta, sharingMeta and the endpoint requestType for endpoint pages."
    },
    {
      "name": "send_feedback_to_docstar",
      "description": "Sends feedback straight to the DocStar team."
    },
    {
      "name": "quickstart-docstar",
      "description": "Document the user's API in DocStar, turn it into an MCP server for their product (always with a feedback tool), and keep it in sync with their code (GitHub Sync)."
    }
  ],
  "prompts": [],
  "keywords": [
    "docstar",
    "api docs",
    "documentation",
    "developer tools",
    "openapi",
    "mcp server"
  ],
  "user_config": {},
  "readme": null,
  "category": "Development",
