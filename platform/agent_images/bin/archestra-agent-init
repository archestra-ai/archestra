#!/bin/sh
set -eu

fail_github_setup() {
  # Publish an image-owned, safe message; gh output may contain tokens.
  "$(dirname "$0")/archestra-agent-failure" github_configuration \
    "GitHub authentication could not be configured. Check the GitHub credential and runtime image."
  echo "archestra: GitHub authentication setup failed; check the GitHub credential and runtime image" >&2
  exit 78
}

# A pod can become runnable a moment before the platform endpoint is reachable
# (notably while a local Tilt backend restarts). Native clients retry transport
# errors inconsistently, so establish the shared runtime contract once here.
if [ -n "${OPENAI_BASE_URL:-}" ] && [ -n "${OPENAI_API_KEY:-}" ]; then
  platform_ready=false
  attempt=1
  while [ "${attempt}" -le 30 ]; do
    http_status=000
    if http_status=$(curl --silent --output /dev/null --max-time 5 \
      --write-out '%{http_code}' \
      --header "Authorization: Bearer ${OPENAI_API_KEY}" \
      "${OPENAI_BASE_URL%/}/models" 2>/dev/null); then
      :
    else
      # curl still prints an HTTP status when the server returned one before
      # closing the connection. Preserve it so permanent auth/configuration
      # errors do not consume the transport retry budget.
      http_status=${http_status:-000}
    fi
    case "${http_status}" in
      2[0-9][0-9])
        platform_ready=true
        break
        ;;
      401)
        "$(dirname "$0")/archestra-agent-failure" provider_credential_rejected \
          "The configured provider credential was rejected (HTTP 401). Reconnect or update the credential, then retry."
        echo "archestra: the provider credential was rejected (HTTP 401); reconnect or update it, then retry" >&2
        exit 69
        ;;
      403)
        "$(dirname "$0")/archestra-agent-failure" provider_permission_denied \
          "The configured provider credential does not have access to this model (HTTP 403). Choose an authorized credential, then retry."
        echo "archestra: the provider credential cannot access this model (HTTP 403); choose an authorized credential, then retry" >&2
        exit 69
        ;;
      404)
        "$(dirname "$0")/archestra-agent-failure" model_unavailable \
          "The selected model endpoint was not found (HTTP 404). Check the model and proxy configuration, then retry."
        echo "archestra: the selected model endpoint was not found (HTTP 404); check the model and proxy configuration, then retry" >&2
        exit 69
        ;;
      429)
        "$(dirname "$0")/archestra-agent-failure" provider_rate_limited \
          "The provider rate limit was reached during model discovery (HTTP 429). Wait or choose another credential, then retry."
        echo "archestra: the provider rate limit was reached during model discovery (HTTP 429); wait or choose another credential, then retry" >&2
        exit 69
        ;;
      4[0-9][0-9])
        "$(dirname "$0")/archestra-agent-failure" proxy_response_invalid \
          "The model proxy rejected the model discovery request (HTTP ${http_status}). Check the provider configuration, then retry."
        echo "archestra: the model proxy rejected model discovery (HTTP ${http_status}); check the provider configuration, then retry" >&2
        exit 69
        ;;
      *)
        # Transport failures and 5xx responses are transient candidates. The
        # fixed bound keeps startup from hanging forever when the proxy is
        # unavailable, while all permanent 4xx responses return immediately.
        ;;
    esac
    if [ "${attempt}" -lt 30 ]; then
      attempt=$((attempt + 1))
      sleep 1
      continue
    fi
    break
  done
  if [ "${platform_ready}" != true ]; then
    echo "archestra: the Agent runtime could not reach the platform proxy" >&2
    "$(dirname "$0")/archestra-agent-failure" proxy_unavailable \
      "The Agent could not connect to the platform proxy. Check proxy availability, network access, and the configured provider credential, then retry."
    exit 69
  fi
fi

# Catalog images use a declared per-user token. Configure git's credential
# helper before any Agent command starts so ordinary `git clone` and `git push`
# work without an interactive username/password prompt. Keep command output
# suppressed: authentication errors should surface on the actual git command,
# never by printing credential state during startup.
if [ -n "${GH_TOKEN:-${GITHUB_TOKEN:-}}" ] && command -v gh >/dev/null 2>&1; then
  github_token="${GH_TOKEN:-${GITHUB_TOKEN}}"
  renewable_github=false
  if [ -n "${ARCHESTRA_AGENT_RUNTIME_CREDENTIALS_FILE:-}" ] && \
    jq -e '.credentials | has("GITHUB_TOKEN") or has("GH_TOKEN")' "$ARCHESTRA_AGENT_RUNTIME_CREDENTIALS_FILE" >/dev/null 2>&1; then
    renewable_github=true
  fi
  # Persist the credential inside this ephemeral pod before the native Agent
  # starts. Some clients deliberately scrub token-shaped environment variables
  # from their shell tools; Git and gh can still use the user-supplied token
  # through their normal 0600 auth store without putting it in the workspace.
  if [ "$renewable_github" != true ]; then
    printf '%s\n' "${github_token}" |
    env -u GH_TOKEN -u GITHUB_TOKEN gh auth login \
      --hostname github.com \
      --with-token >/dev/null 2>&1 || fail_github_setup
  fi
  gh auth setup-git >/dev/null 2>&1 || fail_github_setup
  # gh records its resolved executable, which bypasses our script wrapper.
  # Redirect each configured host back through the renewable credential reader.
  git config --global --get-regexp '^credential\..*\.helper$' |
    while read -r helper_key helper_command; do
      case "$helper_command" in
        *'/usr/bin/gh auth git-credential'*)
          git config --global --replace-all "$helper_key" \
            '!/usr/local/bin/gh auth git-credential' '.*gh auth git-credential.*'
          ;;
      esac
    done
  # Coding agents commonly prefer the SSH clone URL shown by GitHub. The
  # catalog credential is an HTTPS token, so normalize either SSH spelling to
  # the authenticated HTTPS transport instead of requiring a second SSH key.
  git config --global --replace-all url."https://github.com/".insteadOf "git@github.com:"
  git config --global --add url."https://github.com/".insteadOf \
    "ssh://git@github.com/"
  unset github_token
fi
